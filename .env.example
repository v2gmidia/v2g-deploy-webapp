# ============================================================
# V2G Webapp — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores
# reais do seu projeto Supabase (Settings → API). NUNCA commite
# `.env.local` — ele já está no .gitignore.
# ============================================================

# Painel do Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Painel do Supabase → Settings → API → anon / public key
# Pública por natureza (protegida por RLS), mas mesmo assim só via env var.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel do Supabase → Settings → API → service_role key
# NUNCA prefixar com NEXT_PUBLIC_. Ignora RLS por completo.
# Usada apenas em lib/supabase/admin.ts, que é 'server-only' e não é
# importado por nenhuma rota de usuário neste PR.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública onde este app está publicado (sem barra no final).
# Usada para montar o link de retorno do e-mail de recuperação de senha
# (/auth/confirmar). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------
# OAuth do Meta (conexão da conta de anúncio do cliente)
# ------------------------------------------------------------
# Painel do Meta → developers.facebook.com/apps → seu app →
# Configurações → Básico.
#
# O App ID é público (aparece na URL de consentimento, no navegador).
# O App Secret NÃO É: ele fica só no servidor, nunca prefixado com
# NEXT_PUBLIC_, e `lib/meta/oauth.ts` tem `import "server-only"` para o
# build quebrar se alguém tentar importá-lo do lado do cliente.
META_APP_ID=
META_APP_SECRET=

# Lembrete: o URI de redirecionamento registrado no painel do Meta
# precisa ser exatamente `<NEXT_PUBLIC_SITE_URL>/auth/meta/callback`,
# sem barra no final. Qualquer diferença de caractere vira
# `redirect_uri_mismatch`, que é a falha nº 1 desse fluxo.

# ------------------------------------------------------------
# E-mail de recuperação de senha
# ------------------------------------------------------------
# Quem envia o e-mail é o Supabase Auth, não este app — o SMTP embutido
# do Supabase é só para desenvolvimento (limite de envio muito baixo).
# Em produção, configure um provedor real em:
# Painel Supabase → Project Settings → Authentication → SMTP Settings.
# As variáveis abaixo documentam o que preencher lá (não são lidas por
# nenhum código desta app — mantidas aqui para não perder o valor
# quando trocarmos de provedor):
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_PORT=
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASS=
SUPABASE_SMTP_SENDER_EMAIL=
SUPABASE_SMTP_SENDER_NAME=

# ------------------------------------------------------------
# Backend V2G (FastAPI)
# ------------------------------------------------------------
# A API que roda o pipeline de IA e a criação de campanha na Meta.
# Sem barra no final — `lib/backend/cliente.ts` corta, mas os caminhos
# começam com "/" e "https://host//saude" é 404 em alguns servidores.
V2G_BACKEND_URL=https://api.v2gmidia.com.br

# O header `X-V2G-Token`, exigido em todos os endpoints exceto /saude.
#
# ATENÇÃO: é SEGREDO ENTRE MÁQUINAS. Quem tem o token faz tudo, em nome
# de qualquer cliente — ele NÃO identifica usuário. Consequências:
#
#   - NUNCA prefixar com NEXT_PUBLIC_. Isso o publicaria no navegador de
#     todo visitante.
#   - Só sai de Server Action ou Route Handler. Todo arquivo de
#     `lib/backend/` tem `import "server-only"` para o build quebrar se
#     alguém importar de componente de cliente.
#   - Toda chamada precisa passar ANTES pela nossa autenticação: o
#     backend não distingue cliente A de cliente B, então quem autoriza
#     é a nossa sessão, não ele.
#
# Ver docs/backend-integracao.md.
V2G_BACKEND_TOKEN=

# Sem essas duas, o app NÃO quebra: `lib/backend` devolve a categoria
# "indisponivel" e as telas que dependem do backend mostram que aquela
# parte ainda não está ligada. O resto do app funciona normalmente.

# Extração de perfil a partir de transcrição (lib/agentes/).
# Segredo de MÁQUINA: quem tem a chave gasta na nossa conta. Nunca com
# prefixo NEXT_PUBLIC_ — o módulo que a lê tem `import "server-only"`, e o
# build quebra se ela vazar para um bundle de cliente.
# Sem esta variável a extração devolve a falha `sem_chave` e o resto do app
# continua de pé.
ANTHROPIC_API_KEY=

# --- Lote E: disparo do pipeline (docs/disparo-pipeline.md) ---
# Webhook do n8n. DESLIGADO de propósito: estamos seguindo pela hipótese
# de que o n8n faz polling em `execucoes` procurando status
# 'cadastro_completo'. Sem esta variável, o webapp não chama ninguém — só
# cria a execução. Se a medição mostrar que o n8n NÃO faz polling, é aqui
# que a URL entra. Ver §2.2 e §12.
# V2G_N8N_WEBHOOK_URL=
#
# Os dois cortes de silêncio da /saude-meta, em minutos. Os defaults (20 e
# 90) são CHUTE — ninguém cronometrou um pipeline ainda. Existem como env
# para poderem ser corrigidos sem deploy no dia em que alguém medir.
# V2G_MIN_ATE_DEMORANDO=20
# V2G_MIN_ATE_PARADA=90
