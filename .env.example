# ============================================================
# V2G Webapp — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com os valores
# reais do seu projeto Supabase (Settings → API). NUNCA commite
# `.env.local` — ele já está no .gitignore.
# ============================================================

# Painel do Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Painel do Supabase → Settings → API → anon / public key
# Pública por natureza (protegida por RLS), mas mesmo assim só via env var.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel do Supabase → Settings → API → service_role key
# NUNCA prefixar com NEXT_PUBLIC_. Ignora RLS por completo.
# Usada apenas em lib/supabase/admin.ts, que é 'server-only' e não é
# importado por nenhuma rota de usuário neste PR.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública onde este app está publicado (sem barra no final).
# Usada para montar o link de retorno do e-mail de recuperação de senha
# (/auth/confirmar). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------
# E-mail de recuperação de senha
# ------------------------------------------------------------
# Quem envia o e-mail é o Supabase Auth, não este app — o SMTP embutido
# do Supabase é só para desenvolvimento (limite de envio muito baixo).
# Em produção, configure um provedor real em:
# Painel Supabase → Project Settings → Authentication → SMTP Settings.
# As variáveis abaixo documentam o que preencher lá (não são lidas por
# nenhum código desta app — mantidas aqui para não perder o valor
# quando trocarmos de provedor):
SUPABASE_SMTP_HOST=
SUPABASE_SMTP_PORT=
SUPABASE_SMTP_USER=
SUPABASE_SMTP_PASS=
SUPABASE_SMTP_SENDER_EMAIL=
SUPABASE_SMTP_SENDER_NAME=
