+class FonteMeta:
+    def __init__(self) -> None:
+        self.calls: list[tuple[str, dict[str, Any]]] = []
+        self.conta = {"id": CONTA_PILOTO, "currency": "BRL", "timezone_name": "America/Sao_Paulo"}
+        self.campanha = {"id": CAMPANHA, "account_id": CONTA_PILOTO[4:], "name": "FIXTURE campanha", "status": "ACTIVE", "effective_status": "IN_PROCESS"}
+        self.conjuntos = [{"id": CONJUNTO, "account_id": CONTA_PILOTO[4:], "campaign_id": CAMPANHA, "name": "FIXTURE conjunto", "destination_type": "WHATSAPP"}]
+        self.anuncios = [{"id": ANUNCIO, "account_id": CONTA_PILOTO[4:], "campaign_id": CAMPANHA, "adset_id": CONJUNTO, "name": "FIXTURE anúncio"}]
+        self.linhas: dict[str, list[dict[str, Any]]] = {}
+        for nivel, gasto in (("campaign", "15.00"), ("adset", "12.00"), ("ad", "10.00")):
+            self.linhas[nivel] = [{
+                "account_id": CONTA_PILOTO[4:], "campaign_id": CAMPANHA, "adset_id": CONJUNTO, "ad_id": ANUNCIO,
+                "date_start": "2026-10-28", "date_stop": "2026-10-28", "account_currency": "BRL",
+                "spend": gasto, "impressions": "10", "clicks": "1",
+            }]
+        self.erro: dict[str, Any] | None = None
+        self.paging: dict[str, Any] | None = None
+        self.campanhas_extra: list[dict[str, Any]] = []
+        self.paginas_campanhas: list[dict[str, Any]] = []
+        self.paginas_insights: dict[str, list[dict[str, Any]]] = {}
+
+    async def get(self, caminho: str, params: dict[str, Any]) -> dict[str, Any]:
+        self.calls.append((caminho, params.copy()))
+        if self.erro:
+            return self.erro
+        conta = self.conta["id"]
+        if caminho == conta:
+            return self.conta
+        if caminho == f"{conta}/campaigns":
+            if self.paginas_campanhas:
+                return self.paginas_campanhas.pop(0)
+            return {"data": ([self.campanha] if self.campanha else []) + self.campanhas_extra}
+        if caminho == f"{conta}/adsets":
+            return {"data": self.conjuntos, **({"paging": self.paging} if self.paging else {})}
+        if caminho == f"{conta}/ads":
+            return {"data": self.anuncios}
+        assert caminho == f"{conta}/insights"
+        if paginas := self.paginas_insights.get(params["level"]):
+            return paginas.pop(0)
+        return {"data": self.linhas[params["level"]]}
