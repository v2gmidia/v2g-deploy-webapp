+"""Vazio comprovado nao vira erro nem autoriza outro negocio."""
+
+from __future__ import annotations
+
+from uuid import UUID, uuid4
+
+import pytest
+from fastapi.testclient import TestClient
+
+from src.api import rotas
+from src.api.main import criar_app
+
+
+@pytest.fixture
+def cliente_http() -> TestClient:
+    return TestClient(criar_app())
+
+
+def dono_conferido(monkeypatch: pytest.MonkeyPatch, perfil: UUID | None) -> None:
+    async def dono(business_id: UUID) -> UUID | None:
+        return perfil
+
+    monkeypatch.setattr(rotas, "dono_do_negocio", dono)
+
+
+def test_titular_comprovado_recebe_historico_vazio_sem_inventar_metricas(
+    cliente_http: TestClient, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    perfil, negocio = uuid4(), uuid4()
+    dono_conferido(monkeypatch, perfil)
+    resposta = cliente_http.get(
+        f"/negocios/{negocio}/consolidado",
+        params={"profile_id": str(perfil), "desde": "2026-11-01", "ate": "2026-11-07"},
+    )
+    assert resposta.status_code == 200
+    corpo = resposta.json()
+    assert corpo["business_id"] == str(negocio)
+    assert corpo["desde"] == "2026-11-01"
+    assert corpo["ate"] == "2026-11-07"
+    assert corpo["por_execucao"] == []
+    assert corpo["execucoes_somadas"] == 0
+    assert corpo["dias"] == []
+    assert corpo["tem_dado_da_plataforma"] is False
+    for campo in ("investiu_centavos", "cliques", "impressoes", "voltou_centavos", "vendas"):
+        assert corpo[campo] is None
+
+
+@pytest.mark.parametrize("titular", ["outro", "ausente"])
+def test_404_sem_prova_de_titularidade(
+    cliente_http: TestClient, monkeypatch: pytest.MonkeyPatch, titular: str
+) -> None:
+    perfil = uuid4()
+    dono_conferido(monkeypatch, uuid4() if titular == "outro" else None)
+    resposta = cliente_http.get(
+        f"/negocios/{uuid4()}/consolidado", params={"profile_id": str(perfil)}
+    )
+    assert resposta.status_code == 404
+    assert "por_execucao" not in resposta.json()
+
+
+def test_sem_profile_id_nao_ganha_historico_vazio(cliente_http: TestClient) -> None:
+    assert cliente_http.get(f"/negocios/{uuid4()}/consolidado").status_code == 404
+
+
+def test_periodo_invertido_continua_invalido_mesmo_sem_rodadas(
+    cliente_http: TestClient, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    perfil = uuid4()
+    dono_conferido(monkeypatch, perfil)
+    resposta = cliente_http.get(
+        f"/negocios/{uuid4()}/consolidado",
+        params={"profile_id": str(perfil), "desde": "2026-11-07", "ate": "2026-11-01"},
+    )
+    assert resposta.status_code == 422
+
+
+def test_falha_no_cadastro_nao_vira_vazio(
+    cliente_http: TestClient, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    async def falha(business_id: UUID) -> UUID | None:
+        raise RuntimeError("Falha de leitura simulada")
+
+    monkeypatch.setattr(rotas, "dono_do_negocio", falha)
+    with pytest.raises(RuntimeError, match="Falha de leitura simulada"):
+        cliente_http.get(
+            f"/negocios/{uuid4()}/consolidado", params={"profile_id": str(uuid4())}
+        )
