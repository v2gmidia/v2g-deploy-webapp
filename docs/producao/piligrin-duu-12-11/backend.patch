+"""Inventário e medições Meta por IDs externos, sem execução do gerador."""
+
+from __future__ import annotations
+
+import json
+import re
+from collections import defaultdict
+from datetime import UTC, date, datetime
+from typing import Any, Literal
+from uuid import UUID
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from pydantic import BaseModel, Field, model_validator
+
+from src.meta.leitura_valores import ConsultaGet, _centavos, _inteiro
+
+LIMITE_INTEIRO_SEGURO = 9_007_199_254_740_991
+
+
+class FalhaLeituraAnuncios(ValueError):
+    def __init__(self, codigo: str, status: int = 502) -> None:
+        super().__init__(codigo)
+        self.codigo = codigo
+        self.status = status
+
+
+class PeriodoAnuncios(BaseModel):
+    desde: date
+    ate: date
+
+    @model_validator(mode="after")
+    def validar_janela(self) -> PeriodoAnuncios:
+        if self.desde > self.ate or (self.ate - self.desde).days >= 31:
+            raise ValueError("periodo deve ter entre 1 e 31 dias")
+        return self
+
+
+class MetricaDiariaAnuncio(BaseModel):
+    dia: date
+    gasto_centavos: int | None = Field(default=None, ge=0, le=LIMITE_INTEIRO_SEGURO)
+    impressoes: int | None = Field(default=None, ge=0, le=LIMITE_INTEIRO_SEGURO)
+    cliques_totais: int | None = Field(default=None, ge=0, le=LIMITE_INTEIRO_SEGURO)
+
+
+class MetricasAnuncio(BaseModel):
+    estado: Literal["observado", "sem_dados", "zero_medido", "parcial"]
+    gasto_centavos: int | None = None
+    impressoes: int | None = None
+    cliques_totais: int | None = None
+    cliques_no_link: int | None = None
+    conversas_whatsapp: str | None = None
+    dias_com_observacao: list[date]
+    serie_diaria: list[MetricaDiariaAnuncio] = Field(default_factory=list)
+    entrega_observada_no_periodo: bool | None = None
+    motivos: list[str] = Field(default_factory=list)
+
+
+class ObjetoMetaLido(BaseModel):
+    id: str
