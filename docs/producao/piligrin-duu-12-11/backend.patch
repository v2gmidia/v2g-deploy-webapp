+async def test_serie_ordena_dias_e_soma_somente_o_proprio_nivel() -> None:
+    fonte = FonteMeta()
+    for nivel, gasto in (("campaign", "15.01"), ("adset", "12.02"), ("ad", "10.03")):
+        preparar_dias(fonte, nivel, [
+            ("2026-10-30", {"spend": gasto, "impressions": "30", "clicks": "3"}),
+            ("2026-10-28", {"spend": "0.00", "impressions": "0", "clicks": "0"}),
+            ("2026-10-29", {"spend": "0.99", "impressions": "20", "clicks": "2"}),
+        ])
+    r = await ler_serie(fonte)
+    campanha = r.campanha
+    conjunto = campanha.conjuntos[0]
+    for objeto, gasto_final in ((campanha, 1501), (conjunto, 1202), (conjunto.anuncios[0], 1003)):
+        m = objeto.metricas
+        assert [p.dia.isoformat() for p in m.serie_diaria] == ["2026-10-28", "2026-10-29", "2026-10-30"]
+        assert [p.dia for p in m.serie_diaria] == m.dias_com_observacao
+        assert [p.gasto_centavos for p in m.serie_diaria] == [0, 99, gasto_final]
+        for campo, total in (("gasto_centavos", gasto_final + 99), ("impressoes", 50), ("cliques_totais", 5)):
+            assert sum(getattr(p, campo) for p in m.serie_diaria) == getattr(m, campo) == total
+        assert m.estado == "observado"
+    assert len(fonte.calls) == 7  # A série reaproveita o mesmo lote; não faz GET adicional.
