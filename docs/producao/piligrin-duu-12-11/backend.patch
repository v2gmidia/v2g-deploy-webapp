+"""GET de campanha manual: sessão verificada, conta vinculada, nenhum gerador."""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from datetime import UTC, date, datetime
+from typing import Annotated, Any
+from uuid import UUID
+
+from fastapi import APIRouter, Depends, HTTPException, Path, Query, Request, Response
+from pydantic import ValidationError
+
+from src.api.anuncios_leitura_policy import validar_leitura_anuncios
+from src.config import obter_config
+from src.db.acesso_anuncios import (
+    AcessoContaAnuncios,
+    AcessoContaSupabase,
+    SessaoAnuncios,
+    verificar_sessao_anuncios,
+)
+from src.meta.leitura_anuncios import (
+    FalhaLeituraAnuncios,
+    LeituraAnunciosMeta,
+    LeituraContaAnunciosMeta,
+    PeriodoAnuncios,
+    ler_anuncios_da_conta,
+)
+from src.meta.leitura_valores import ConsultaGet
+
+MENSAGENS = {
+    401: "Entre novamente para consultar os anúncios.",
+    404: "Não há um recorte autorizado disponível para esta consulta.",
+    409: "Os vínculos ou a origem dos dados precisam de conferência.",
+    422: "Confira a campanha e o período informado.",
+    424: "O acesso de leitura da V2G à fonte precisa de conferência.",
+    502: "A resposta recebida não pôde ser conferida.",
+    503: "A leitura dos anúncios está indisponível agora.",
+}
+
+
+def erro_http(erro: FalhaLeituraAnuncios) -> HTTPException:
+    return HTTPException(erro.status, {"codigo": erro.codigo, "mensagem": MENSAGENS[erro.status]},
+                         headers={"Cache-Control": "no-store", "Vary": "Authorization"})
+
+
+def exigir_habilitado() -> None:
+    config = obter_config()
+    if not config.v2g_meta_ads_production_read_enabled:
+        raise erro_http(FalhaLeituraAnuncios("leitura_real_desabilitada", 503))
+    validar_leitura_anuncios(config)
+
+
+async def sessao_da_leitura(request: Request) -> SessaoAnuncios:
+    cabecalho = request.headers.get("Authorization", "")
+    partes = cabecalho.split(" ", 1)
+    if len(partes) != 2 or partes[0] != "Bearer" or not partes[1] or len(partes[1]) > 16000 or any(c.isspace() for c in partes[1]):
+        raise erro_http(FalhaLeituraAnuncios("sessao_invalida", 401))
+    try:
+        return await verificar_sessao_anuncios(partes[1])
+    except FalhaLeituraAnuncios as erro:
+        raise erro_http(erro) from None
+
+
+def obter_acesso_conta() -> AcessoContaAnuncios:
+    return AcessoContaSupabase()
+
+
+@asynccontextmanager
+async def fonte_meta_get() -> AsyncIterator[ConsultaGet]:
+    # Só é instanciada DEPOIS de conferir sessão, negócio e conta. O opt-in
+    # não passa pela fábrica de mutações e não muda USE_MOCK_META.
+    exigir_habilitado()
+    from src.meta.graph import ClientMetaGraph
+
+    try:
+        client = ClientMetaGraph()
+    except Exception:
+        raise FalhaLeituraAnuncios("fonte_indisponivel", 503) from None
+
+    async def get(caminho: str, params: dict[str, Any]) -> dict[str, Any]:
+        return await client._get(caminho, params, tolerar_erro=True)  # noqa: SLF001
+
+    try:
+        yield get
+    finally:
+        await client.fechar()
+
+
+router_anuncios = APIRouter(dependencies=[Depends(exigir_habilitado)])
+
+
+async def _ler_conta_http(
+    business_id: UUID, conta_id: str | None,
+    desde: date, ate: date, response: Response,
+    sessao: SessaoAnuncios, acesso: AcessoContaAnuncios,
+) -> LeituraContaAnunciosMeta:
+    response.headers["Cache-Control"] = "no-store"
+    response.headers["Vary"] = "Authorization"
+    try:
+        periodo = PeriodoAnuncios(desde=desde, ate=ate)
+        conta = await acesso.conta_autorizada(business_id, sessao, conta_id)
+        async with fonte_meta_get() as consultar:
+            leitura = await ler_anuncios_da_conta(
+                business_id=business_id, conta_id=conta,
+                periodo=periodo, consultar=consultar, agora=datetime.now(UTC),
+            )
+            leitura.coletado_em = datetime.now(UTC)
+            return leitura
+    except ValidationError:
+        raise erro_http(FalhaLeituraAnuncios("periodo_invalido", 422)) from None
+    except FalhaLeituraAnuncios as erro:
+        raise erro_http(erro) from None
+
+
+@router_anuncios.get("/negocios/{business_id}/meta/campanhas", response_model=LeituraContaAnunciosMeta, tags=["leitura"])
+async def anuncios_da_conta(
+    business_id: UUID, desde: date, ate: date, response: Response,
+    sessao: Annotated[SessaoAnuncios, Depends(sessao_da_leitura)],
+    acesso: Annotated[AcessoContaAnuncios, Depends(obter_acesso_conta)],
+    conta_id: Annotated[str | None, Query(pattern=r"^act_[0-9]{1,40}$")] = None,
+) -> LeituraContaAnunciosMeta:
+    return await _ler_conta_http(business_id, conta_id, desde, ate, response, sessao, acesso)
+
+
+@router_anuncios.get("/negocios/{business_id}/meta/campanhas/{campanha_id}", response_model=LeituraAnunciosMeta, tags=["leitura"])
+async def anuncios_da_campanha(
+    business_id: UUID, campanha_id: Annotated[str, Path(pattern=r"^[0-9]{1,40}$")],
+    desde: date, ate: date, response: Response,
+    sessao: Annotated[SessaoAnuncios, Depends(sessao_da_leitura)],
+    acesso: Annotated[AcessoContaAnuncios, Depends(obter_acesso_conta)],
+    conta_id: Annotated[str | None, Query(pattern=r"^act_[0-9]{1,40}$")] = None,
+) -> LeituraAnunciosMeta:
+    leitura = await _ler_conta_http(business_id, conta_id, desde, ate, response, sessao, acesso)
+    campanha = next((c for c in leitura.campanhas if c.id == campanha_id), None)
+    if campanha is None:
+        raise erro_http(FalhaLeituraAnuncios("campanha_nao_encontrada_na_conta", 404))
+    return LeituraAnunciosMeta(**leitura.model_dump(exclude={"campanhas"}), campanha=campanha)
