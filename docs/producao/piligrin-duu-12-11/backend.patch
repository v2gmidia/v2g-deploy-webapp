+    preparar_dias(fonte, "campaign", [("2026-10-28", {}), ("2026-10-29", {campo: valor})])
+    m = (await ler_serie(fonte, ate="2026-10-29")).campanha.metricas
+    assert m.estado == "parcial" and len(m.serie_diaria) == 2
+    assert getattr(m.serie_diaria[0], normalizado) is not None
+    assert getattr(m.serie_diaria[1], normalizado) is None and getattr(m, normalizado) is None
+    assert [p.dia for p in m.serie_diaria] == m.dias_com_observacao
