@@ -0,0 +1,85 @@
+"""Acesso de pessoa ao negócio/conta: apenas SELECTs de colunas não secretas."""
+
+from __future__ import annotations
+
+import asyncio
+import re
+from typing import Any, Protocol
+from uuid import UUID
+
+from pydantic import BaseModel
+
+from src.db.negocio import _cliente
+from src.meta.leitura_anuncios import FalhaLeituraAnuncios
+
+
+class SessaoAnuncios(BaseModel):
+    profile_id: UUID
+    operador: bool = False
+
+
+class AcessoContaAnuncios(Protocol):
+    async def conta_autorizada(self, business_id: UUID, sessao: SessaoAnuncios, conta_id: str | None = None) -> str: ...
+
+
+class AcessoContaSupabase:
+    def __init__(self, client: Any = None) -> None:
+        self.client = client
+
+    async def conta_autorizada(self, business_id: UUID, sessao: SessaoAnuncios, conta_id: str | None = None) -> str:
+        return await asyncio.to_thread(self._consultar, business_id, sessao, conta_id)
+
+    def _consultar(self, business_id: UUID, sessao: SessaoAnuncios, conta_id: str | None) -> str:
+        try:
+            client = self.client if self.client is not None else _cliente()
+            negocios = client.table("businesses").select("id,profile_id").eq("id", str(business_id)).limit(2).execute().data
+            if len(negocios) != 1 or negocios[0].get("id") != str(business_id) or not negocios[0].get("profile_id"):
+                raise FalhaLeituraAnuncios("recorte_nao_autorizado", 404)
+            dono = negocios[0]["profile_id"] == str(sessao.profile_id)
+            if not dono:
+                if not sessao.operador:
+                    raise FalhaLeituraAnuncios("recorte_nao_autorizado", 404)
+                atribuicoes = client.table("manager_accounts").select("business_id,operator_profile_id").eq(
+                    "business_id", str(business_id)).eq("operator_profile_id", str(sessao.profile_id)).limit(2).execute().data
+                if (len(atribuicoes) != 1 or atribuicoes[0].get("business_id") != str(business_id)
+                        or atribuicoes[0].get("operator_profile_id") != str(sessao.profile_id)):
+                    raise FalhaLeituraAnuncios("recorte_nao_autorizado", 404)
+            consulta = client.table("ad_accounts").select("business_id,external_id,is_active,status").eq(
+                "business_id", str(business_id)).eq("is_active", True).eq("status", "ok")
+            if conta_id is not None:
+                consulta = consulta.eq("external_id", conta_id)
+            contas = consulta.limit(2).execute().data
+            if not contas:
+                raise FalhaLeituraAnuncios("conta_nao_vinculada", 404)
+            if len(contas) != 1:
+                raise FalhaLeituraAnuncios("conta_ambigua", 409)
+            conta = contas[0]
+            if (conta.get("business_id") != str(business_id) or conta.get("is_active") is not True
+                    or conta.get("status") != "ok" or not isinstance(conta.get("external_id"), str)
+                    or not re.fullmatch(r"act_[0-9]{1,40}", conta["external_id"])):
+                raise FalhaLeituraAnuncios("conta_nao_vinculada", 404)
+            return str(conta["external_id"])
+        except FalhaLeituraAnuncios:
+            raise
+        except Exception:
+            raise FalhaLeituraAnuncios("autorizacao_indisponivel", 503) from None
+
+
+async def verificar_sessao_anuncios(token: str, client: Any = None) -> SessaoAnuncios:
+    def consultar() -> SessaoAnuncios:
+        try:
+            sdk = client if client is not None else _cliente()
+            resposta = sdk.auth.get_user(token)
+            user = resposta.user
+            if user is None or user.role != "authenticated":
+                raise FalhaLeituraAnuncios("sessao_invalida", 401)
+            return SessaoAnuncios(profile_id=UUID(user.id), operador=user.app_metadata.get("papel") == "operador")
+        except FalhaLeituraAnuncios:
+            raise
+        except Exception as erro:
+            if getattr(erro, "status", None) in (400, 401, 403):
+                raise FalhaLeituraAnuncios("sessao_invalida", 401) from None
+            raise FalhaLeituraAnuncios("autenticacao_indisponivel", 503) from None
+
+    return await asyncio.to_thread(consultar)
+
