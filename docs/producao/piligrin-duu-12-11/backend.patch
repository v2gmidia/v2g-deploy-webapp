+    assert m.estado == "zero_medido"
+    assert m.serie_diaria[0].model_dump(mode="json") == {
+        "dia": "2026-10-28", "gasto_centavos": 0, "impressoes": 0, "cliques_totais": 0,
+    }
+    fonte.linhas["campaign"] = []
+    m = (await ler(fonte)).campanha.metricas
