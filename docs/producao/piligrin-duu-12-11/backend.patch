+    m = (await ler_serie(fonte)).campanha.metricas
+    assert [p.dia.isoformat() for p in m.serie_diaria] == ["2026-10-28", "2026-10-30"]
+    assert len(m.dias_com_observacao) == 2 and m.estado == "parcial"
+    assert (m.gasto_centavos, m.impressoes, m.cliques_totais) == (300, 3, 1)
+    assert "cobertura_ou_campos_incompletos" in m.motivos
