+
+
+class LeituraContaAnunciosMeta(EscopoLeituraMeta):
+    campanhas: list[CampanhaMetaLida]
+
+
+def _texto(valor: object) -> str | None:
+    return valor if isinstance(valor, str) and valor.strip() else None
+
+
+def _id(valor: object) -> str:
+    if not isinstance(valor, str) or not re.fullmatch(r"[0-9]{1,40}", valor):
+        raise FalhaLeituraAnuncios("identidade_meta_invalida", 409)
+    return valor
+
+
+async def ler_anuncios_da_conta(
+    *, business_id: UUID, conta_id: str,
+    periodo: PeriodoAnuncios, consultar: ConsultaGet, agora: datetime,
+) -> LeituraContaAnunciosMeta:
+    """Até 31 GETs por conta, sem URL de paginação, cache ou persistência.
+
+    Metas agregadas vêm do próprio nível da Meta; não soma anúncio como
+    substituição de campanha. Qualquer identidade divergente invalida o lote.
+    """
+    if not re.fullmatch(r"act_[0-9]{1,40}", conta_id) or agora.tzinfo is None:
+        raise FalhaLeituraAnuncios("escopo_invalido", 422)
+    conta_numerica = conta_id.removeprefix("act_")
+
+    async def get(caminho: str, params: dict[str, Any]) -> dict[str, Any]:
+        try:
+            corpo = await consultar(caminho, params)
+        except Exception:
+            raise FalhaLeituraAnuncios("fonte_indisponivel", 503) from None
+        if not isinstance(corpo, dict):
+            raise FalhaLeituraAnuncios("resposta_meta_invalida")
+        if "error" in corpo:
+            erro = corpo["error"]
+            codigo = erro.get("code") if isinstance(erro, dict) else None
+            if codigo in (10, 190, 200, 294):
+                raise FalhaLeituraAnuncios("meta_acesso_indisponivel", 424)
+            if codigo in (4, 17, 32, 613):
+                raise FalhaLeituraAnuncios("meta_limite_de_leitura", 503)
+            raise FalhaLeituraAnuncios("resposta_meta_recusada")
+        return corpo
+
+    async def listar(caminho: str, params: dict[str, Any]) -> list[dict[str, Any]]:
+        linhas: list[dict[str, Any]] = []
+        cursores: set[str] = set()
+        for _ in range(5):
+            corpo = await get(caminho, params.copy())
+            dados = corpo.get("data")
+            if not isinstance(dados, list) or any(not isinstance(d, dict) for d in dados):
+                raise FalhaLeituraAnuncios("resposta_meta_invalida")
+            linhas.extend(dados)
+            paging = corpo.get("paging", {})
+            if not isinstance(paging, dict):
+                raise FalhaLeituraAnuncios("paginacao_invalida")
+            if not paging.get("next"):
+                return linhas
+            cursors = paging.get("cursors", {})
+            after = cursors.get("after") if isinstance(cursors, dict) else None
+            if not isinstance(after, str) or not after or after in cursores:
+                raise FalhaLeituraAnuncios("paginacao_incompleta", 503)
+            cursores.add(after)
+            params["after"] = after
+        raise FalhaLeituraAnuncios("limite_de_paginas", 503)
+
+    conta = await get(conta_id, {"fields": "id,currency,timezone_name"})
+    if conta.get("id") != conta_id:
+        raise FalhaLeituraAnuncios("conta_meta_divergente", 409)
+    moeda = _texto(conta.get("currency"))
+    if moeda is not None and re.fullmatch(r"[A-Z]{3}", moeda) is None:
+        moeda = None
+    fuso = _texto(conta.get("timezone_name"))
+    try:
+        zona = ZoneInfo(fuso) if fuso else None
+    except (ZoneInfoNotFoundError, ValueError):
+        zona = None
+        fuso = None
+    campanhas = await listar(f"{conta_id}/campaigns", {
+        "fields": "id,account_id,name,status,effective_status,objective", "limit": 100,
+    })
+    campanhas_por_id: dict[str, dict[str, Any]] = {}
+    for campanha in campanhas:
+        identificador = _id(campanha.get("id"))
+        if campanha.get("account_id") != conta_numerica or identificador in campanhas_por_id:
+            raise FalhaLeituraAnuncios("campanha_fora_da_conta", 409)
+        campanhas_por_id[identificador] = campanha
+    conjuntos = await listar(f"{conta_id}/adsets", {
+        "fields": "id,account_id,campaign_id,name,status,effective_status,destination_type,attribution_spec", "limit": 100,
+    })
+    anuncios = await listar(f"{conta_id}/ads", {
+        "fields": "id,account_id,campaign_id,adset_id,name,status,effective_status", "limit": 100,
+    })
+    conjuntos_por_id: dict[str, dict[str, Any]] = {}
+    anuncios_por_id: dict[str, dict[str, Any]] = {}
+    for conjunto in conjuntos:
+        identificador = _id(conjunto.get("id"))
+        campanha_do_conjunto = _id(conjunto.get("campaign_id"))
+        if conjunto.get("account_id") != conta_numerica or campanha_do_conjunto not in campanhas_por_id or identificador in conjuntos_por_id:
+            raise FalhaLeituraAnuncios("conjunto_fora_do_escopo", 409)
+        conjuntos_por_id[identificador] = conjunto
+    for anuncio in anuncios:
+        identificador = _id(anuncio.get("id"))
+        campanha_do_anuncio, conjunto_do_anuncio = _id(anuncio.get("campaign_id")), _id(anuncio.get("adset_id"))
+        if (anuncio.get("account_id") != conta_numerica or campanha_do_anuncio not in campanhas_por_id
+                or conjunto_do_anuncio not in conjuntos_por_id or identificador in anuncios_por_id
+                or conjuntos_por_id[conjunto_do_anuncio]["campaign_id"] != campanha_do_anuncio):
+            raise FalhaLeituraAnuncios("anuncio_fora_do_escopo", 409)
+        anuncios_por_id[identificador] = anuncio
+
+    medicoes: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)
+    for nivel in ("campaign", "adset", "ad"):
+        campos = "account_id,campaign_id,date_start,date_stop,spend,impressions,clicks,account_currency,actions"
+        if nivel in ("adset", "ad"):
+            campos += ",adset_id"
+        if nivel == "ad":
+            campos += ",ad_id"
+        linhas = await listar(f"{conta_id}/insights", {
+            "fields": campos,
+            "level": nivel, "time_increment": 1, "limit": 100,
+            "time_range": json.dumps({"since": periodo.desde.isoformat(), "until": periodo.ate.isoformat()}),
+        })
+        vistos: set[tuple[str, str]] = set()
+        for linha in linhas:
+            campanha_da_metrica = _id(linha.get("campaign_id"))
+            if linha.get("account_id") != conta_numerica or campanha_da_metrica not in campanhas_por_id:
+                raise FalhaLeituraAnuncios("origem_metrica_divergente", 409)
+            identificador = _id(linha.get({"campaign": "campaign_id", "adset": "adset_id", "ad": "ad_id"}[nivel]))
+            if nivel == "adset" and (identificador not in conjuntos_por_id or linha["campaign_id"] != conjuntos_por_id[identificador]["campaign_id"]):
+                raise FalhaLeituraAnuncios("origem_metrica_divergente", 409)
+            if nivel == "ad" and (identificador not in anuncios_por_id or linha.get("adset_id") != anuncios_por_id[identificador]["adset_id"]
+                                  or linha["campaign_id"] != anuncios_por_id[identificador]["campaign_id"]):
+                raise FalhaLeituraAnuncios("origem_metrica_divergente", 409)
+            try:
+                dia = date.fromisoformat(linha.get("date_start", ""))
+            except (TypeError, ValueError):
+                raise FalhaLeituraAnuncios("dia_da_metrica_invalido") from None
+            chave = (identificador, dia.isoformat())
+            if (not periodo.desde <= dia <= periodo.ate or linha.get("date_stop") != dia.isoformat()
+                    or chave in vistos or (moeda is not None and linha.get("account_currency") != moeda)):
+                raise FalhaLeituraAnuncios("periodo_ou_moeda_divergente", 409)
+            vistos.add(chave)
+            medicoes[nivel, identificador].append(linha)
+
+    def metricas(nivel: str, identificador: str) -> MetricasAnuncio:
+        linhas = medicoes[nivel, identificador]
+
+        def observado(linha: dict[str, Any], campo: str) -> int | None:
+            valor = _centavos(linha.get(campo)) if campo == "spend" else _inteiro(linha.get(campo))
+            if valor is None or valor > LIMITE_INTEIRO_SEGURO or (campo == "spend" and moeda is None):
+                return None
+            return valor
+
+        # A série e os totais usam a mesma observação do próprio nível/objeto.
+        # Dias ausentes não criam pontos e um campo inválido não vira zero.
+        serie = [MetricaDiariaAnuncio(
+            dia=date.fromisoformat(linha["date_start"]),
+            gasto_centavos=observado(linha, "spend"),
+            impressoes=observado(linha, "impressions"),
+            cliques_totais=observado(linha, "clicks"),
+        ) for linha in sorted(linhas, key=lambda linha: linha["date_start"])]
+
+        def somar(valores: list[int | None]) -> int | None:
+            if not valores or None in valores:
+                return None
+            soma = sum(v for v in valores if v is not None)
+            return soma if soma <= LIMITE_INTEIRO_SEGURO else None
+
+        gasto = somar([ponto.gasto_centavos for ponto in serie])
+        impressoes = somar([ponto.impressoes for ponto in serie])
+        cliques = somar([ponto.cliques_totais for ponto in serie])
+        dias = [ponto.dia for ponto in serie]
+        motivos = ["conversas_whatsapp_sem_taxonomia_homologada", "cliques_no_link_nao_medidos"]
+        parcial = False
+        if fuso is None:
+            motivos.append("fuso_desconhecido")
+            parcial = True
+        if moeda is None:
+            motivos.append("moeda_desconhecida")
+            parcial = True
+        if linhas and (len(dias) < (periodo.ate - periodo.desde).days + 1 or None in (gasto, impressoes, cliques)):
+            motivos.append("cobertura_ou_campos_incompletos")
+            parcial = True
+        if zona and periodo.ate >= agora.astimezone(zona).date():
+            motivos.append("periodo_ainda_aberto")
+            parcial = True
+        zero = gasto == impressoes == cliques == 0
+        estado: Literal["observado", "sem_dados", "zero_medido", "parcial"] = (
+            "sem_dados" if not linhas else "parcial" if parcial else "zero_medido" if zero else "observado"
+        )
+        entrega = (
+            True if (impressoes is not None and impressoes > 0) or (gasto is not None and gasto > 0)
+            else False if impressoes == gasto == 0 else None
+        )
+        return MetricasAnuncio(
+            estado=estado, gasto_centavos=gasto, impressoes=impressoes, cliques_totais=cliques,
+            dias_com_observacao=dias, serie_diaria=serie,
+            entrega_observada_no_periodo=entrega, motivos=motivos,
+        )
+
+    def comum(objeto: dict[str, Any], nivel: str) -> dict[str, Any]:
+        return {
+            "id": objeto["id"], "nome": _texto(objeto.get("name")),
+            "status_configurado": _texto(objeto.get("status")),
+            "status_efetivo": _texto(objeto.get("effective_status")),
+            "metricas": metricas(nivel, objeto["id"]),
+        }
+
+    campanhas_lidas = []
+    for campanha in campanhas:
+        grupos = []
+        for conjunto in conjuntos:
+            if conjunto["campaign_id"] != campanha["id"]:
+                continue
+            atribuicao = conjunto.get("attribution_spec")
+            grupos.append(ConjuntoMetaLido(
+                **comum(conjunto, "adset"), campanha_id=campanha["id"],
+                destino=_texto(conjunto.get("destination_type")),
+                atribuicao=atribuicao if isinstance(atribuicao, list) and all(isinstance(a, dict) for a in atribuicao) else None,
+                anuncios=[AnuncioMetaLido(**comum(a, "ad"), campanha_id=campanha["id"], conjunto_id=conjunto["id"])
+                          for a in anuncios if a["adset_id"] == conjunto["id"]],
+            ))
+        campanhas_lidas.append(CampanhaMetaLida(**comum(campanha, "campaign"), objetivo=_texto(campanha.get("objective")), conjuntos=grupos))
+    return LeituraContaAnunciosMeta(
+        business_id=business_id, conta_id=conta_id, periodo=periodo, moeda=moeda, fuso=fuso,
+        coletado_em=agora.astimezone(UTC),
+        campanhas=campanhas_lidas,
+        avisos=["status_efetivo_nao_comprova_entrega_atual", "conversas_whatsapp_nao_medidas"],
+    )
+
+
+async def ler_anuncios_da_campanha(
+    *, business_id: UUID, conta_id: str, campanha_id: str,
+    periodo: PeriodoAnuncios, consultar: ConsultaGet, agora: datetime,
+) -> LeituraAnunciosMeta:
+    campanha_id = _id(campanha_id)
+    leitura = await ler_anuncios_da_conta(
+        business_id=business_id, conta_id=conta_id, periodo=periodo, consultar=consultar, agora=agora,
+    )
+    campanha = next((c for c in leitura.campanhas if c.id == campanha_id), None)
+    if campanha is None:
+        raise FalhaLeituraAnuncios("campanha_nao_encontrada_na_conta", 404)
+    return LeituraAnunciosMeta(**leitura.model_dump(exclude={"campanhas"}), campanha=campanha)
