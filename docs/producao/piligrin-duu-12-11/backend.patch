+
+class EscopoLeituraMeta(BaseModel):
+    versao: Literal["e28-meta-ads-read-v1"] = "e28-meta-ads-read-v1"
+    business_id: UUID
+    conta_id: str
+    id_execucao: None = None
+    origem_vinculo: Literal["ad_accounts"] = "ad_accounts"
+    fonte: Literal["meta_marketing_api"] = "meta_marketing_api"
+    periodo: PeriodoAnuncios
+    moeda: str | None
+    fuso: str | None
+    coletado_em: datetime
+    avisos: list[str]
+
+
+class LeituraAnunciosMeta(EscopoLeituraMeta):
