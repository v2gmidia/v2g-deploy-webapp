+class Query:
+    def __init__(self, db: Banco, tabela: str) -> None:
+        self.db, self.tabela = db, tabela
+        self.filtros: dict[str, Any] = {}
+        self.colunas = ""
+        self.limite = 2
+
+    def select(self, colunas: str) -> Query:
+        self.colunas = colunas
+        return self
+
+    def eq(self, campo: str, valor: Any) -> Query:
+        self.filtros[campo] = valor
+        return self
+
+    def limit(self, limite: int) -> Query:
+        self.limite = limite
+        return self
+
+    def execute(self) -> SimpleNamespace:
+        self.db.consultas.append((self.tabela, self.colunas, self.filtros))
+        dados = [r for r in self.db.tabelas[self.tabela] if all(r.get(k) == v for k, v in self.filtros.items())]
+        return SimpleNamespace(data=[{k: r.get(k) for k in self.colunas.split(",")} for r in dados[:self.limite]])
+
+
+class Banco:
+    def __init__(self) -> None:
+        self.consultas: list[tuple[str, str, dict[str, Any]]] = []
+        self.tabelas = {
+            "businesses": [{"id": str(BUSINESS_PILOTO), "profile_id": DONO}],
+            "manager_accounts": [{"business_id": str(BUSINESS_PILOTO), "operator_profile_id": OPERADOR}],
+            "ad_accounts": [{"business_id": str(BUSINESS_PILOTO), "external_id": CONTA_PILOTO, "is_active": True, "status": "ok"}],
