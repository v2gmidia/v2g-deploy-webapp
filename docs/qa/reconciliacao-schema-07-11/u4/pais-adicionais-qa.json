      "constraints": [
        {
          "def": "CHECK (((provider_card_flow = 'direct'::text) OR ((billing_period = 'monthly'::text) AND (payment_method = 'asaas_card'::text) AND ((origin = 'self_service'::text) OR ((origin = 'assisted'::text) AND (assisted_operator_id IS NOT NULL))))))",
          "name": "commercial_orders_3ds_matches"
        },
        {
          "def": "CHECK ((((status = 'payment_approved'::text) AND (payment_approved_at IS NOT NULL)) OR ((status <> 'payment_approved'::text) AND (payment_approved_at IS NULL))))",
          "name": "commercial_orders_approval_matches"
        },
        {
          "def": "CHECK (((NOT ((origin = 'assisted'::text) AND (payment_method = ANY (ARRAY['asaas_pix'::text, 'asaas_card'::text])))) OR (assisted_operator_id IS NOT NULL)))",
          "name": "commercial_orders_assisted_asaas_actor"
        },
        {
          "def": "FOREIGN KEY (assisted_operator_id) REFERENCES profiles(id) ON DELETE RESTRICT",
          "name": "commercial_orders_assisted_operator_id_fkey"
        },
        {
          "def": "CHECK ((billing_period = ANY (ARRAY['monthly'::text, 'semiannual_upfront'::text, 'annual_upfront'::text])))",
          "name": "commercial_orders_billing_period_check"
        },
        {
          "def": "FOREIGN KEY (business_id) REFERENCES businesses(id) ON DELETE SET NULL",
          "name": "commercial_orders_business_id_fkey"
        },
        {
          "def": "FOREIGN KEY (buyer_profile_id) REFERENCES profiles(id) ON DELETE SET NULL",
          "name": "commercial_orders_buyer_profile_id_fkey"
        },
        {
          "def": "CHECK ((cnpj ~ '^[0-9]{14}$'::text))",
          "name": "commercial_orders_cnpj_check"
        },
        {
          "def": "CHECK (declares_cnpj)",
          "name": "commercial_orders_declares_cnpj_check"
        },
        {
          "def": "CHECK (((payment_method <> 'direct_pix'::text) OR (status <> 'payment_approved'::text) OR (payment_approved_by IS NOT NULL)))",
          "name": "commercial_orders_direct_pix_approval_actor_check"
        },
        {
          "def": "CHECK (((payment_method <> 'direct_pix'::text) OR (status = ANY (ARRAY['awaiting_payment'::text, 'cancelled'::text])) OR ((proof_reference IS NOT NULL) AND (length(btrim(proof_reference)) > 0) AND (proof_received_at IS NOT NULL) AND (proof_received_by IS NOT NULL))))",
          "name": "commercial_orders_direct_pix_proof_check"
        },
        {
          "def": "CHECK ((((billing_period = 'monthly'::text) AND (discount_percent = 0)) OR ((billing_period = 'semiannual_upfront'::text) AND (discount_percent = 5)) OR ((billing_period = 'annual_upfront'::text) AND (discount_percent = 12))))",
          "name": "commercial_orders_discount_matches"
        },
        {
          "def": "UNIQUE (external_ref)",
          "name": "commercial_orders_external_ref_key"
        },
        {
          "def": "CHECK ((origin = ANY (ARRAY['assisted'::text, 'self_service'::text])))",
          "name": "commercial_orders_origin_check"
        },
        {
          "def": "CHECK (((status <> 'payment_approved'::text) OR (business_id IS NOT NULL)))",
          "name": "commercial_orders_paid_business_check"
        },
        {
          "def": "FOREIGN KEY (payment_approved_by) REFERENCES profiles(id) ON DELETE SET NULL",
          "name": "commercial_orders_payment_approved_by_fkey"
        },
        {
          "def": "CHECK (((payment_attempt_count >= 0) AND (payment_attempt_count <= 3)))",
          "name": "commercial_orders_payment_attempt_count_check"
        },
        {
          "def": "CHECK ((payment_method = ANY (ARRAY['direct_pix'::text, 'asaas_pix'::text, 'asaas_card'::text])))",
          "name": "commercial_orders_payment_method_check"
        },
        {
          "def": "PRIMARY KEY (id)",
          "name": "commercial_orders_pkey"
        },
        {
          "def": "FOREIGN KEY (proof_received_by) REFERENCES profiles(id) ON DELETE SET NULL",
          "name": "commercial_orders_proof_received_by_fkey"
        },
        {
          "def": "CHECK ((provider_card_flow = ANY (ARRAY['direct'::text, 'initial_3ds'::text])))",
          "name": "commercial_orders_provider_card_flow_check"
        },
        {
          "def": "UNIQUE (provider_charge_id)",
          "name": "commercial_orders_provider_charge_id_key"
        },
        {
          "def": "UNIQUE (provider_checkout_id)",
          "name": "commercial_orders_provider_checkout_id_key"
        },
        {
          "def": "UNIQUE (provider_subscription_id)",
          "name": "commercial_orders_provider_subscription_id_key"
        },
        {
          "def": "CHECK (sells_by_whatsapp)",
          "name": "commercial_orders_sells_by_whatsapp_check"
        },
        {
          "def": "CHECK ((((source_system IS NULL) AND (source_lead_id IS NULL)) OR ((source_system = 'v2g_site'::text) AND (source_lead_id IS NOT NULL) AND (source_lead_id > 0))))",
          "name": "commercial_orders_source_pair_check"
        },
        {
          "def": "CHECK (((source_lead_id IS NULL) OR ((source_lead_consent_at IS NOT NULL) AND (source_lead_consent_text IS NOT NULL) AND (length(btrim(source_lead_consent_text)) >= 10) AND (source_lead_linked_at IS NOT NULL))))",
          "name": "commercial_orders_source_snapshot_check"
        },
        {
          "def": "CHECK ((status = ANY (ARRAY['awaiting_payment'::text, 'proof_received'::text, 'payment_approved'::text, 'cancelled'::text])))",
          "name": "commercial_orders_status_check"
        },
        {
          "def": "CHECK ((total_cents > 0))",
          "name": "commercial_orders_total_cents_check"
        },
        {
          "def": "CHECK ((total_cents = (unit_count *\nCASE billing_period\n    WHEN 'monthly'::text THEN 50000\n    WHEN 'semiannual_upfront'::text THEN 285000\n    ELSE 528000\nEND)))",
          "name": "commercial_orders_total_matches"
        },
        {
          "def": "CHECK ((unit_count > 0))",
          "name": "commercial_orders_unit_count_check"
        },
        {
          "def": "CHECK ((unit_price_cents = 50000))",
          "name": "commercial_orders_unit_price_cents_check"
        }
      ]
    },
