+import styles from "./pedidos-nominais.module.css";
+const payments:Record<EstadoPagamentoPublico,string>={awaiting_payment:"Aguardando pagamento",payment_approved:"Confirmado",cancelled:"Cancelado",refunded:"Estornado",
+ partially_refunded:"Estorno parcial",refund_in_progress:"Estorno em andamento",payment_review:"Precisa de conferência",verification_unavailable:"Consulta indisponível"};
+const queues:Record<EstadoFilaNominal,string>={none:"Sem envio registrado",blocked:"Envio desabilitado",queued:"Na fila",sending:"Envio em processamento",accepted:"Aceito pelo provedor",review:"Conferir envio",unavailable:"Consulta indisponível"};
+const subscriptions={not_applicable:"Não se aplica",not_started:"Não iniciada",reconciliation:"Em conciliação",registered:"Registrada",unavailable:"Consulta indisponível"};
+const date=(v:string|null)=>v?new Intl.DateTimeFormat("pt-BR",{timeZone:"UTC"}).format(new Date(v+"T00:00:00Z")):"Não informado";
+const money=(v:number)=>Number.isSafeInteger(v)&&v>0?new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL"}).format(v/100):"Valor indisponível";
+
+/** Apresentação sem actions, scripts de provedor ou payloads de filas. */
+export function PedidosNominais({result,preview=false}:{result:ResultadoPedidosNominais;preview?:boolean}) {
+ if(result.state==="disabled")return null;
+ return <section id="pedidos-comerciais" className={styles.section} aria-labelledby="titulo-pedidos-comerciais">
+  <header className={styles.header}><div><h2 id="titulo-pedidos-comerciais">Contratações pela plataforma</h2>
+    <p>Pagamentos, recorrência e mensagens. Somente consulta.</p></div>
+    {!preview&&<a href={`/pedidos?comercial=${result.page}#pedidos-comerciais`}>Atualizar consulta</a>}</header>
+  {result.state==="unavailable"?<p className="form-error" role="alert">Não foi possível consultar as contratações. Atualize a consulta; os pedidos assistidos continuam separados abaixo.</p>
+   :<>{result.items.length===0?<p className={styles.empty}>Nenhuma contratação nesta página.</p>:<ol className={styles.list}>{result.items.map(p=><li key={p.id}>
+    <details className={styles.order}><summary><span className={styles.summary}>
+      <span className={styles.name}><strong>{p.name}</strong><small>{p.type==="agency"?"Agência":"Cliente direto"} · {p.units?p.units.length+" "+(p.units.length===1?"conta":"contas"):"Contas indisponíveis"}</small></span>
+      <span><small>Valor contratado</small>{money(p.amountCents)}{p.period==="monthly"?"/mês":p.period==="annual_upfront"?" à vista":""}</span>
+      <span><small>Pagamento inicial</small><span className={styles.paymentState} data-state={p.initial}>{payments[p.initial]}</span></span>
+      <span><small>Período atual</small><span className={styles.paymentState} data-state={p.current}>{payments[p.current]}</span></span>
+      <span className={styles.expand}>Ver detalhes</span>
+    </span></summary>
+    <div className={styles.detail}>
+      <dl className={styles.facts}><div><dt>Vencimento consultado</dt><dd>{date(p.due)}</dd></div>
+       <div><dt>Assinatura mensal</dt><dd>{subscriptions[p.subscription]}</dd></div>
+       <div><dt>E-mail ao comprador</dt><dd>{queues[p.buyerQueue]}</dd></div>
+       <div><dt>Aviso interno</dt><dd>{queues[p.internalQueue]}</dd></div></dl>
+      <p className={styles.note}>Filas da cobrança do vencimento consultado. Aceite do provedor não comprova recebimento na caixa. Assinatura registrada não confirma pagamento.</p>
+      <h3>Contas contratadas</h3>{p.units?<ul className={styles.units}>{p.units.map(u=><li key={u.id}><span>{u.name}</span><small>{u.destinationIndicated?"Destino indicado":"Aguardando escolha do destino"}</small></li>)}</ul>:<p className="form-warning">Não foi possível conferir as unidades deste pedido.</p>}
+      <p className={styles.reference}>Pedido {p.id}<br/>Comprador: {p.email||"E-mail indisponível"}</p>
+    </div></details>
+   </li>)}</ol>}
+   {result.pageLimitReached&&<p className="form-warning">Esta consulta chegou ao limite de páginas. Há outros pedidos que não foram exibidos.</p>}
+   {!preview&&(result.page>1||result.hasNext)&&<nav className={styles.pagination} aria-label="Páginas de contratações">
+    {result.page>1?<a href={`/pedidos?comercial=${result.page-1}#pedidos-comerciais`} rel="prev">Página anterior</a>:<span/>}
+    <span>Página {result.page}</span>
+    {result.hasNext?<a href={`/pedidos?comercial=${result.page+1}#pedidos-comerciais`} rel="next">Próxima página</a>:<span/>}
+   </nav>}</>}
+ </section>;
+}
