@@ -0,0 +1,35 @@
+import { createHash, timingSafeEqual } from "node:crypto";
+import { podeRetomarComercial, UUID_COMERCIAL, type SujeitoComercial } from "./comercial-v1.ts";
+
+export const hashComercial = (value: string) => createHash("sha256").update(value,"utf8").digest("hex");
+export type ContextoComercial = {
+  id:string; original_data:unknown; confirmed_data:unknown; source:{kind:string}; recipient_email:string;
+  session_hash:string; expires_at:string; exchanged_at:string|null;
+};
+export function lerCookieComercial(value: string | undefined) {
+  if (!value) return null;
+  const [reference,secret,...rest] = value.split(".");
+  return !rest.length && reference && UUID_COMERCIAL.test(reference) && secret && (secret==="auth" || /^[a-f0-9]{64}$/.test(secret))
+    ? {reference,secret} : null;
+}
+export function autorizaContextoComercial(row: ContextoComercial, subject: SujeitoComercial|null, secret?:string, now=Date.now()) {
+  if (!Number.isFinite(Date.parse(row.expires_at)) || Date.parse(row.expires_at)<=now) return false;
+  // Sessão presente identifica a pessoa ativa: não usar uma capacidade de A
+  // como fallback para uma sessão de B, mesmo no mesmo navegador.
+  if(subject && (!UUID_COMERCIAL.test(subject.id) || typeof subject.email!=="string"
+    || subject.email.trim().toLowerCase()!==row.recipient_email))return false;
+  if (podeRetomarComercial(subject,row.recipient_email)) return true;
+  if (!secret || !/^[a-f0-9]{64}$/.test(secret) || !/^[a-f0-9]{64}$/.test(row.session_hash)
+      || (row.source.kind !== "compra_direta" && !row.exchanged_at)) return false;
+  return timingSafeEqual(Buffer.from(row.session_hash,"hex"),Buffer.from(hashComercial(secret),"hex"));
+}
+
+/** Leitura e autorização testáveis; a consulta não é prova de que alguém pode ver o resultado. */
+export async function carregarContextoComercial(
+  reference:string, subject:SujeitoComercial|null, secret:string|undefined,
+  find:(id:string)=>Promise<ContextoComercial|null>, now=Date.now(),
+) {
+  if (!UUID_COMERCIAL.test(reference)) return null;
+  const row = await find(reference);
+  return row && row.id===reference && autorizaContextoComercial(row,subject,secret,now) ? row : null;
+}
