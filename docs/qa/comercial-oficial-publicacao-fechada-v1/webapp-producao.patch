+  if (precisaPedidos && data.length) {
+    try {
+      const admin = createAdminClient();
+      const resultado = await lerTodasPaginasEmLotes<PedidoDoNegocio>(data.map((negocio) => negocio.id), (lote, inicio, fim) => admin.from("commercial_orders")
