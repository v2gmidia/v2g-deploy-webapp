+++ b/lib/contratacao/checkout-contexto-v1-servidor.ts
@@ -0,0 +1,87 @@
+import "server-only";
+import {cookies} from "next/headers";
+import {createClient} from "@/lib/supabase/server";
+import {createAdminClient} from "@/lib/supabase/admin";
+import {contextoComercialDoServidor} from "./comercial-v1-servidor";
+import {lerCookieComercial} from "./contexto-comercial-v1";
+import {dadosComerciaisPersistidos} from "./comercial-v1";
+import {checkoutContextoAtivo,consultaCheckoutContextoAtiva,conferirPedidoCheckout,type PedidoCheckoutContexto,type InstrumentoContexto} from "./checkout-contexto-v1";
+import {cobrancaCanonicaDoContexto} from "./financeiro-contexto-v1";
+import {iniciarCheckoutContexto} from "./checkout-contexto-v1";
+import {COLUNAS_PEDIDO_CONTEXTO} from "./processar-financeiro-contexto-v1";
+import {reservarPreparacaoFinanceiraContexto,conciliarVinculoFinanceiroContexto} from "./processar-financeiro-contexto-v1";
+import {provedorContexto} from "./provedor-contexto-v1";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+import type {UnidadeFinanceiraContexto} from "./financeiro-contexto-v1";
+import {schemaRecorrenciaNominalPronto} from "./processar-recorrencia-contexto-v1";
+import {isIP} from "node:net";
+
+/** Referência/capacidade vem do cookie HttpOnly; identidade vem de getUser.
+ * Pedido/CPF/nome no formulário nunca selecionam comprador ou preço. */
+export async function lerCheckoutDoServidor() {
+  if(!consultaCheckoutContextoAtiva())return null;
+  try {
+    const client=await createClient(),auth=await client.auth.getUser();
+    if(auth.error)return null;
+    const user=auth.data.user;
+    const cookie=lerCookieComercial((await cookies()).get("v2g_commercial_context")?.value);
+    if(!cookie)return null;
+    const context=await contextoComercialDoServidor(cookie.reference,user,cookie.secret);
+    const snapshot=dadosComerciaisPersistidos(context?.confirmed_data);
+    if(!context||!snapshot||(user&&user.email?.trim().toLowerCase()!==context.recipient_email))return null;
+    const admin=createAdminClient();
+    if(!await schemaComercialOficialPronto(admin))return null;
+    const read=await admin.from("commercial_orders").select(COLUNAS_PEDIDO_CONTEXTO+
+      ",cnpj,buyer_name,buyer_whatsapp,checkout_creation_started_at,payment_creation_started_at")
+      .eq("intake_context_id",context.id).maybeSingle();
+    if(read.error)return null;
+    const order=read.data as PedidoCheckoutContexto|null;
+    if(!order)return {context,snapshot,order:null,units:[] as UnidadeFinanceiraContexto[]};
+    const rows=await admin.from("commercial_order_units").select("id,intake_context_id,intake_unit_id,advertiser_name,advertiser_business_id,ad_account_id,ordinal")
+      .eq("order_id",order.id).order("ordinal").limit(101);
+    if(rows.error||order.intake_context_id!==context.id||!conferirPedidoCheckout(order,rows.data as UnidadeFinanceiraContexto[])
+      ||(order.buyer_profile_id!==null&&order.buyer_profile_id!==user?.id))return null;
+    return {context,snapshot,order,units:rows.data as UnidadeFinanceiraContexto[]};
+  }catch{return null;}
+}
+
+export async function executarCheckoutDoServidor(loaded:NonNullable<Awaited<ReturnType<typeof lerCheckoutDoServidor>>>,
+  instrument:InstrumentoContexto) {
+  if(!checkoutContextoAtivo()||!loaded.order)return {state:"disabled" as const};
+  const admin=createAdminClient(),order=loaded.order;
+  if(!await schemaComercialOficialPronto(admin))return {state:"disabled" as const};
+  const transport=provedorContexto("purchase");
+  const due=new Intl.DateTimeFormat("sv-SE",{timeZone:"America/Sao_Paulo"}).format(new Date());
+  return iniciarCheckoutContexto(order,loaded.units,instrument,due,{
+    recurrenceReady:()=>schemaRecorrenciaNominalPronto(admin),
+    reserve:async()=>{
+      if(order.billing_period==="monthly") {
+        const ip=instrument.kind==="card"&&typeof instrument.card.remoteIp==="string"?instrument.card.remoteIp:"";
+        if(!isIP(ip))return false;
+        const r=await admin.rpc("reservar_checkout_mensal_contexto_v1",{p_order:order.id,p_ip:ip});return !r.error&&r.data===true;
+      }
+      const r=await admin.from("commercial_orders").update({checkout_creation_started_at:new Date().toISOString()})
+      .eq("id",order.id).eq("intake_context_id",loaded.context.id).eq("status","awaiting_payment")
+      .is("checkout_creation_started_at",null).is("payment_creation_started_at",null).is("provider_charge_id",null)
+      .is("provider_customer_id",null).is("provider_subscription_id",null).select("id").maybeSingle();return !r.error&&!!r.data;},
+    transport,
+    bindCustomer:async(id,date)=>await reservarPreparacaoFinanceiraContexto(admin,order.id,id,date,transport)==="reserved",
+    bindCharge:async id=>await conciliarVinculoFinanceiroContexto(admin,order.id,id,transport)==="bound",
+  });
+}
+
+/** Somente leitura da cobrança e do QR da mesma intenção autorizada. */
+export async function lerPixDoContexto(order:PedidoCheckoutContexto) {
+  if(!consultaCheckoutContextoAtiva()||order.payment_method!=="asaas_pix"||!order.provider_charge_id)return null;
+  try {
+    const transport=provedorContexto("processing");
+    const payment=await transport(`/payments/${encodeURIComponent(order.provider_charge_id)}`);
+    if(!payment.ok||!cobrancaCanonicaDoContexto(order,order.provider_charge_id,payment.body)
+      ||!payment.body||typeof payment.body!=="object"||!("status" in payment.body)||payment.body.status!=="PENDING")return null;
+    const qr=await transport(`/payments/${encodeURIComponent(order.provider_charge_id)}/pixQrCode`);
+    const q=qr.body as {encodedImage?:unknown;payload?:unknown}|null;
+    return qr.ok&&q&&typeof q.encodedImage==="string"&&q.encodedImage.length>0&&q.encodedImage.length<2_000_000
+      &&/^[A-Za-z0-9+/=]+$/.test(q.encodedImage)&&typeof q.payload==="string"&&q.payload.length>0&&q.payload.length<2000
+      ?{image:q.encodedImage,code:q.payload}:null;
+  }catch{return null;}
+}
diff --git a/lib/contratacao/checkout-contexto-v1.ts b/lib/contratacao/checkout-contexto-v1.ts
new file mode 100644
--- /dev/null
+++ b/lib/contratacao/checkout-contexto-v1.ts
@@ -0,0 +1,95 @@
+import { financeiroContextoAtivo, conferirUnidadesFinanceiras, cobrancaCanonicaDoContexto,
+  type PedidoFinanceiroContexto, type UnidadeFinanceiraContexto } from "./financeiro-contexto-v1.ts";
+import { dadosComerciaisPersistidos } from "./comercial-v1.ts";
+import { urlDesafio3ds } from "./cartao-3ds.ts";
+import {recorrenciaContextoAtiva} from "./recorrencia-contexto-v1.ts";
+import {identidadeComercialOficial,checkoutComercialOficialAtivo,financeiroComercialOficialAtivo,ORIGEM_COMERCIAL_OFICIAL} from "./ambiente-comercial-oficial-v1.ts";
+
+export type PedidoCheckoutContexto = PedidoFinanceiroContexto & {
+  cnpj:string; buyer_name:string; buyer_whatsapp:string; billing_period:string;
+  checkout_creation_started_at:string|null; payment_creation_started_at:string|null;
+  provider_subscription_id:string|null;
+};
+type Registro=Record<string,unknown>;
+export type TransporteCheckoutContexto = (path:string,options?:{method?:"GET"|"POST";body?:Registro;timeoutMs?:number}) =>
+  Promise<{ok:boolean;body:unknown}>;
+export type InstrumentoContexto = {kind:"pix"}|{kind:"card";deviceInfo:Registro;card:Registro};
+export type PortasCheckoutContexto = {
+  reserve:()=>Promise<boolean>;
+  bindCustomer:(customerId:string,due:string)=>Promise<boolean>;
+  bindCharge:(chargeId:string)=>Promise<boolean>;
+  recurrenceReady?:()=>Promise<boolean>;
+  transport:TransporteCheckoutContexto;
+};
+export type ResultadoCheckoutContexto = {
+  state:"disabled"|"invalid"|"recurrence_not_ready"|"pending_reconciliation"|"created";
+  challengeUrl?:string;
+};
+const record=(v:unknown):v is Registro=>!!v&&typeof v==="object"&&!Array.isArray(v);
+function dataValida(d:string){try{return /^\d{4}-\d{2}-\d{2}$/.test(d)&&new Date(d+"T00:00:00Z").toISOString().slice(0,10)===d;}catch{return false;}}
+export function checkoutContextoAtivo(env:Record<string,string|undefined>=process.env) {
+  if(identidadeComercialOficial(env))return checkoutComercialOficialAtivo(env);
+  return financeiroContextoAtivo(env)&&env.V2G_COMMERCIAL_CHECKOUT_V1_ENABLED==="true"
+    &&env.V2G_CHECKOUT_ENABLED==="true"&&env.V2G_CHECKOUT_API_ENABLED==="true";
+}
+export function consultaCheckoutContextoAtiva(env:Record<string,string|undefined>=process.env) {
+  return identidadeComercialOficial(env)?financeiroComercialOficialAtivo(env):checkoutContextoAtivo(env);
+}
+export function conferirPedidoCheckout(order:PedidoCheckoutContexto,units:UnidadeFinanceiraContexto[]) {
+  const d=dadosComerciaisPersistidos(order.intake_snapshot);
+  return !!d&&conferirUnidadesFinanceiras(order,units)&&order.cnpj===d.cnpj&&order.billing_period===d.periodo
+    &&order.buyer_name===d.nome&&order.buyer_whatsapp===d.whatsapp;
+}
+
+/** Reserva ANTES do primeiro POST. Resultado perdido jamais reabre a intenção.
+ * Não aceita preço, identidade, unidade ou URL do navegador. Cartão fica somente
+ * no argumento efêmero; nenhuma porta de persistência recebe PAN/CVV/token.
+ */
+export async function iniciarCheckoutContexto(order:PedidoCheckoutContexto,units:UnidadeFinanceiraContexto[],
+  instrument:InstrumentoContexto,due:string,ports:PortasCheckoutContexto,
+  env:Record<string,string|undefined>=process.env):Promise<ResultadoCheckoutContexto> {
+  if(!checkoutContextoAtivo(env))return {state:"disabled"};
+  if(!conferirPedidoCheckout(order,units)||!dataValida(due)
+    ||(order.payment_method==="asaas_pix"?instrument.kind!=="pix":order.payment_method!=="asaas_card"||instrument.kind!=="card"))return {state:"invalid"};
+  // Mensal nunca cai no caminho avulso sem o pacote e sua reserva nominal.
+  if(order.billing_period==="monthly") {
+    try {if(!recorrenciaContextoAtiva(env)||instrument.kind!=="card"||!ports.recurrenceReady||!await ports.recurrenceReady())
+      return {state:"recurrence_not_ready"};}catch{return {state:"recurrence_not_ready"};}
+  }
+  if(order.status!=="awaiting_payment"||order.checkout_creation_started_at||order.payment_creation_started_at
+    ||order.provider_customer_id||order.provider_charge_id||order.provider_subscription_id)return {state:"pending_reconciliation"};
+  if(instrument.kind==="card"&&(!record(instrument.card)||!record(instrument.deviceInfo)
+    ||!instrument.card.creditCard||!instrument.card.creditCardHolderInfo||!instrument.card.remoteIp
+    ||env.V2G_CHECKOUT_3DS_ENABLED!=="true"||env.V2G_CHECKOUT_3DS_SCHEMA_ENABLED!=="true"))return {state:"invalid"};
+  try {
+    if(!await ports.reserve())return {state:"pending_reconciliation"};
+    const customer=await ports.transport("/customers",{method:"POST",body:{name:order.legal_name,cpfCnpj:order.cnpj,
+      email:order.buyer_email,mobilePhone:order.buyer_whatsapp,externalReference:order.id,notificationDisabled:true}});
+    if(!customer.ok||!record(customer.body)||typeof customer.body.id!=="string"||!/^cus_[A-Za-z0-9]+$/.test(customer.body.id))
+      return {state:"pending_reconciliation"};
+    const customerId=customer.body.id;
+    const canonicalCustomer=await ports.transport(`/customers/${encodeURIComponent(customerId)}`);
+    if(!canonicalCustomer.ok||!record(canonicalCustomer.body)||canonicalCustomer.body.id!==customerId
+      ||canonicalCustomer.body.externalReference!==order.id||canonicalCustomer.body.deleted
+      ||canonicalCustomer.body.cpfCnpj!==order.cnpj||canonicalCustomer.body.email!==order.buyer_email
+      ||!await ports.bindCustomer(customerId,due))return {state:"pending_reconciliation"};
+    const response=await ports.transport("/payments",{method:"POST",timeoutMs:instrument.kind==="card"?65000:20000,body:{
+      customer:customerId,billingType:instrument.kind==="pix"?"PIX":"CREDIT_CARD",dueDate:due,value:order.total_cents/100,
+      externalReference:order.id,description:"Gestão de anúncios V2G",
+      ...(instrument.kind==="card"?{creditCard:instrument.card.creditCard,creditCardHolderInfo:instrument.card.creditCardHolderInfo,
+        remoteIp:instrument.card.remoteIp,deviceInfo:instrument.deviceInfo,
+        threeDSecure:{callbackUrl:`${identidadeComercialOficial(env)?ORIGEM_COMERCIAL_OFICIAL:"https://v2g-webapp-qa.vercel.app"}/contratar/finalizar`}}:{}),
+    }});
+    if(!response.ok||!record(response.body)||typeof response.body.id!=="string"||!/^pay_[A-Za-z0-9]+$/.test(response.body.id))
+      return {state:"pending_reconciliation"};
+    const chargeId=response.body.id,canonical=await ports.transport(`/payments/${encodeURIComponent(chargeId)}`);
+    const reserved={...order,provider_customer_id:customerId,provider_first_due_date:due};
+    if(!canonical.ok||!cobrancaCanonicaDoContexto(reserved,chargeId,canonical.body)||!record(canonical.body)
+      ||!await ports.bindCharge(chargeId))return {state:"pending_reconciliation"};
+    const challenge=canonical.body.threeDSecureChallengeUrl??response.body.threeDSecureChallengeUrl;
+    if(challenge!=null){const challengeUrl=urlDesafio3ds(challenge);if(!challengeUrl)return {state:"pending_reconciliation"};
+      return {state:"created",challengeUrl};}
+    // A resposta/callback nunca registra pagamento nem libera acesso.
+    return {state:"created"};
+  }catch{return {state:"pending_reconciliation"};}
+}
