+/* V2G — linguagem da LP aprovada em 06/10/2026, adaptada à operação.
+   Escopo: o Casco. Tokens globais da área do produto sem alterar LP, legais
+   ou onboarding. Claro é a referência; cookie e preferência do aparelho
+   continuam decidindo o tema. Fundos de ação nunca são usados como tinta. */
+.app-shell.v2g-editorial {
+  --offwhite: #ECF5F2;
+  --canvas: #F8FBFA;
+  --surface: #ECF5F2;
+  --surface-2: #FFFFFF;
+  --surface-rgb: 236 245 242;
+  --offwhite-rgb: 236 245 242;
+  --ink: #102A35;
+  --ink-soft: #49606A;
+  --ink-mute: #526A73;
+  --navy: var(--ink);
+  --navy-rgb: 16 42 53;
+  --cobalt: #0B40DA;
+  --cobalt-dark: #092EAA;
+  --cobalt-rgb: 11 64 218;
+  --cobalt-ink: #0B40DA;
+  --ice: #B0E9FD;
+  --ice-rgb: 176 233 253;
+  --ice-soft: #E4F4F9;
+  --lime: #EAFF64;
+  --lime-rgb: 234 255 100;
+  --white: #FFFFFF;
+  --line: #CCD9D6;
+  --control-line: #70877E;
+  --task-surface: #E2EEE9;
+  --good: #24683F;
+  --good-soft: #E1EFE5;
+  --warn: #805916;
+  --warn-soft: #F5EBD7;
+  --crit: #A43530;
+  --crit-soft: #F8E7E5;
+  --plate: #051225;
+  --plate-ink: #ECF5F2;
+  --plate-ink-rgb: 236 245 242;
+  --sidebar-bg: var(--plate);
+  --sidebar-ink: #BED0DB;
+  --sidebar-ink-strong: #FFFFFF;
+  --sidebar-active-bg: var(--cobalt);
+  --sidebar-line: #314052;
+  --card-ice-bg: var(--ice-soft);
+  --card-ice-ink: var(--ink);
+  --card-cobalt-bg: var(--cobalt);
+  --card-cobalt-ink: var(--white);
+  --card-lime-bg: var(--good-soft);
+  --card-lime-ink: var(--good);
+  --fundo-pagina: var(--canvas);
+  --fundo-superficie: var(--surface);
+  --fundo-topo: var(--canvas);
+  --fundo-barra: var(--sidebar-bg);
+  --texto-forte: var(--ink);
+  --texto-fraco: var(--ink-soft);
+  --linha-divisoria: var(--line);
+  --texto-sobre-escuro: var(--white);
+  --fundo-controle: var(--surface);
+  --texto-discreto: var(--ink-mute);
+  --texto-discreto-sobre-placa: var(--sidebar-ink);
+  --raio-controle: 4px;
+  --raio-cartao: 4px;
+  --raio-card: 4px;
+  --raio-item: 4px;
+  --raio-interno: 4px;
+  --raio-selo: 4px;
+  --sidebar-w: 240px;
+  --barra-h: 70px;
+  --shell-max: 1440px;
+  --alt-principal: 48px;
+  --fs-editorial: clamp(28px, 2.6vw, 36px);
+  color-scheme: light;
+  background: var(--canvas);
+  color: var(--ink);
+  font-family: var(--body);
+  font-weight: 400;
+  line-height: 1.6;
+  grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
+}
