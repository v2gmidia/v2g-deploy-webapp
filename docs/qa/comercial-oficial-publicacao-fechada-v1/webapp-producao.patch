+"use client";
+
+import {useActionState,useState} from "react";
+import {salvarContextoComercial,type ContextoState} from "./comercial-actions";
+import {SCHEMA_COMERCIAL,type LeadComercial,type DadosComerciais,type UnidadeComercial} from "@/lib/contratacao/comercial-v1";
+import {valorDoPedidoCentavos,type PeriodoDeCobranca} from "@/lib/contratacao/preco";
+import {executarComFeedback} from "../(public)/entrar/acao-local";
+import {useFocoResultado} from "../(public)/entrar/EsperaFormulario";
+import styles from "./ComercialFormulario.module.css";
+
+export function ComercialFormulario({reference,unitId,initial,emailDoAcesso,retomada=false,preview=false,previewError=false,saved=false,checkoutDisponivel=false}: {
+  reference:string;unitId:string;initial?:LeadComercial|DadosComerciais;emailDoAcesso?:string;retomada?:boolean;preview?:boolean;previewError?:boolean;saved?:boolean;
+  checkoutDisponivel?:boolean;
+}) {
+  const [state,action,pending]=useActionState<ContextoState,FormData>((previous,form)=>preview
+    ? Promise.resolve(previewError
+      ? {erro:"Falha simulada da prévia. Confira os dados preservados e tente novamente; nenhum registro foi criado."}
+      : {mensagem:"Prévia local: dados conferidos na tela. Nenhum registro ou pagamento foi criado."})
+    : executarComFeedback(()=>salvarContextoComercial(previous,form),{erro:"Não foi possível confirmar. Seus dados continuam no formulário; tente novamente na mesma contratação."}),saved ? {reference,mensagem:"Dados já confirmados nesta contratação. Nenhum pagamento foi iniciado e nenhum acesso foi liberado."} : {});
+  const errorRef=useFocoResultado(pending,state.erro);
+  const [kind,setKind]=useState(initial?.contractorType ?? "");
+  const [count,setCount]=useState(initial?.contas ?? 1);
+  const [units,setUnits]=useState<UnidadeComercial[]>(initial?.units?.length ? initial.units
+    : [{id:unitId,advertiserName:initial?.contractorType==="direct" ? initial.razaoSocial : ""}]);
