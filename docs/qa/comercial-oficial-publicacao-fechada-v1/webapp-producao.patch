+    const desafio = urlDesafio3ds(corpo.threeDSecureChallengeUrl);
+    if (!desafio) return { erro: "A autenticação do cartão precisa de conferência. Procure a V2G antes de tentar novamente." };
+    redirect(desafio);
+  }
+  redirect(`/contratar/pagamento?ref=${encodeURIComponent(referencia)}`);
+}
diff --git a/lib/contratacao/ler-cobertura-nominal-v1.ts b/lib/contratacao/ler-cobertura-nominal-v1.ts
new file mode 100644
--- /dev/null
+++ b/lib/contratacao/ler-cobertura-nominal-v1.ts
@@ -0,0 +1,182 @@
+import "server-only";
+
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { lerTodasPaginas, lerTodasPaginasEmLotes } from "../multiconta/paginacao";
+import {
+  COLUNAS_COBERTURA_NOMINAL,
+  coberturaNominalAtiva,
+  sujeitoNominalVerificado,
+  validarAtribuicaoNominal,
+  type CoberturaNominalPersistida,
+  type LeituraCoberturasNominais,
+} from "./cobertura-nominal-v1";
+import { UUID_COMERCIAL, type SujeitoComercial } from "./comercial-v1";
+import {
+  conferirUnidadesFinanceiras,
+  ehPedidoContexto,
+  prepararCoberturaNominal,
+  type PedidoFinanceiroContexto,
+  type UnidadeFinanceiraContexto,
+} from "./financeiro-contexto-v1";
+import { consultarDireitoFinanceiroNominal } from "./direito-financeiro-nominal-v1";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+
+type NegocioDaCobertura = { id: string; profile_id: string };
+type RelacaoDaCobertura = {
+  agency_business_id: string;
+  advertiser_business_id: string;
+  owner_profile_id: string;
+  revoked_at: string | null;
+};
+type ContaDaCobertura = { id: string; business_id: string };
+
+const COLUNAS_PEDIDO = "id,external_ref,intake_context_id,intake_source,intake_snapshot,contractor_type,buyer_email,buyer_profile_id,business_id,legal_name,status,unit_count,total_cents,payment_method,provider_customer_id,provider_charge_id,provider_first_due_date,billing_period,provider_subscription_id";
+const COLUNAS_UNIDADE = "id,intake_context_id,intake_unit_id,advertiser_name,advertiser_business_id,ad_account_id,ordinal,order_id";
+
+function leituraIndisponivel(): LeituraCoberturasNominais {
+  return { state: "unavailable", coverages: [] };
+}
+
+function coberturaBasicaValida(c: CoberturaNominalPersistida, sujeito: SujeitoComercial & { email: string }) {
+  return UUID_COMERCIAL.test(c.order_id) && UUID_COMERCIAL.test(c.context_id)
+    && UUID_COMERCIAL.test(c.unit_id) && UUID_COMERCIAL.test(c.intake_unit_id)
+    && UUID_COMERCIAL.test(c.owner_profile_id) && UUID_COMERCIAL.test(c.contractor_business_id)
+    && UUID_COMERCIAL.test(c.advertiser_business_id)
+    && (c.ad_account_id === null || UUID_COMERCIAL.test(c.ad_account_id))
+    && c.owner_profile_id === sujeito.id && c.buyer_email === sujeito.email.trim().toLowerCase()
+    && typeof c.created_at === "string" && (c.account_bound_at === null || typeof c.account_bound_at === "string")
+    && (c.ad_account_id === null) === (c.account_bound_at === null);
+}
+
+function reciboConfere(c: CoberturaNominalPersistida, porUnidade: Map<string, CoberturaNominalPersistida>) {
+  const s = validarAtribuicaoNominal(c.selection);
+  if (!s || s.orderId !== c.order_id || s.contextId !== c.context_id || s.unitId !== c.unit_id
+    || s.intakeUnitId !== c.intake_unit_id
+    || s.adAccountId !== null && s.adAccountId !== c.ad_account_id) return false;
+  if (s.contractor.mode === "existing" && s.contractor.businessId !== c.contractor_business_id) return false;
+  if (s.advertiser.mode === "existing") return s.advertiser.businessId === c.advertiser_business_id;
+  if (s.advertiser.mode === "contractor") return c.contractor_business_id === c.advertiser_business_id;
+  if (s.advertiser.mode === "unit") {
+    const origem = porUnidade.get(s.advertiser.unitId);
+    return !!origem && origem.order_id === c.order_id
+      && origem.advertiser_business_id === c.advertiser_business_id;
+  }
+  return s.advertiser.mode === "new";
+}
+
+/**
+ * Resolve somente direitos nominais já persistidos e financeiramente vigentes.
+ * OFF não consulta o schema novo. Uma falha nominal nunca remove direitos
+ * independentes: os consumidores decidem esses caminhos separadamente.
+ */
+export async function lerCoberturasNominaisDoTitular(
+  admin: SupabaseClient,
+  sujeito: SujeitoComercial | null,
+): Promise<LeituraCoberturasNominais> {
+  if (!coberturaNominalAtiva()) return { state: "off", coverages: [] };
+  if (!sujeitoNominalVerificado(sujeito)) return leituraIndisponivel();
+  const email = sujeito.email.trim().toLowerCase();
+
+  try {
+    if(!await schemaComercialOficialPronto(admin))return leituraIndisponivel();
+    const coberturas = await lerTodasPaginas<CoberturaNominalPersistida>((inicio, fim) => admin
+      .from("commercial_nominal_unit_bindings_v1")
+      .select(COLUNAS_COBERTURA_NOMINAL)
+      .eq("owner_profile_id", sujeito.id).eq("buyer_email", email)
+      .order("order_id", { ascending: true }).order("unit_id", { ascending: true })
+      .range(inicio, fim));
+    if (!coberturas) return leituraIndisponivel();
+    if (!coberturas.length) return { state: "ok", coverages: [] };
+    const porUnidade = new Map(coberturas.map(c => [c.unit_id, c]));
+    if (porUnidade.size !== coberturas.length
+      || coberturas.some(c => !coberturaBasicaValida(c, { ...sujeito, email }) || !reciboConfere(c, porUnidade)))
+      return leituraIndisponivel();
+
+    const orderIds = [...new Set(coberturas.map(c => c.order_id))];
+    const [pedidos, unidades] = await Promise.all([
+      lerTodasPaginasEmLotes<PedidoFinanceiroContexto>(orderIds, (lote, inicio, fim) => admin
+        .from("commercial_orders").select(COLUNAS_PEDIDO).in("id", lote)
+        .order("id", { ascending: true }).range(inicio, fim)),
+      lerTodasPaginasEmLotes<UnidadeFinanceiraContexto & { order_id: string }>(orderIds, (lote, inicio, fim) => admin
+        .from("commercial_order_units").select(COLUNAS_UNIDADE).in("order_id", lote)
+        .order("order_id", { ascending: true }).order("ordinal", { ascending: true }).range(inicio, fim)),
+    ]);
+    if (!pedidos || !unidades || pedidos.length !== orderIds.length) return leituraIndisponivel();
+    const pedidoPorId = new Map(pedidos.map(p => [p.id, p]));
+    if (pedidoPorId.size !== pedidos.length || pedidos.some(p => !ehPedidoContexto(p.external_ref)
+      || p.buyer_email !== email || p.buyer_profile_id !== sujeito.id || p.business_id === null))
+      return leituraIndisponivel();
+
+    const unidadesPorPedido = new Map<string, UnidadeFinanceiraContexto[]>();
+    for (const unidade of unidades) {
+      const grupo = unidadesPorPedido.get(unidade.order_id) ?? [];
+      grupo.push(unidade);
+      unidadesPorPedido.set(unidade.order_id, grupo);
+    }
+    if (pedidos.some(p => !conferirUnidadesFinanceiras(p, unidadesPorPedido.get(p.id) ?? [])))
+      return leituraIndisponivel();
+    const unidadePorId = new Map(unidades.map(u => [u.id, u]));
+
+    const businessIds = [...new Set(coberturas.flatMap(c => [c.contractor_business_id, c.advertiser_business_id]))];
+    const accountIds = [...new Set(coberturas.flatMap(c => c.ad_account_id ? [c.ad_account_id] : []))];
+    const agencyIds = [...new Set(pedidos.filter(p => p.contractor_type === "agency")
+      .flatMap(p => p.business_id ? [p.business_id] : []))];
+    const [negocios, contas, relacoes] = await Promise.all([
+      lerTodasPaginasEmLotes<NegocioDaCobertura>(businessIds, (lote, inicio, fim) => admin
+        .from("businesses").select("id,profile_id").in("id", lote)
+        .order("id", { ascending: true }).range(inicio, fim)),
+      accountIds.length ? lerTodasPaginasEmLotes<ContaDaCobertura>(accountIds, (lote, inicio, fim) => admin
+        .from("ad_accounts").select("id,business_id").in("id", lote)
+        .order("id", { ascending: true }).range(inicio, fim)) : Promise.resolve([]),
+      agencyIds.length ? lerTodasPaginasEmLotes<RelacaoDaCobertura>(agencyIds, (lote, inicio, fim) => admin
+        .from("agency_advertisers")
+        .select("agency_business_id,advertiser_business_id,owner_profile_id,revoked_at")
+        .in("agency_business_id", lote).order("agency_business_id", { ascending: true })
+        .order("advertiser_business_id", { ascending: true }).range(inicio, fim)) : Promise.resolve([]),
+    ]);
+    if (!negocios || !contas || !relacoes || negocios.length !== businessIds.length)
+      return leituraIndisponivel();
+    const negocioPorId = new Map(negocios.map(b => [b.id, b]));
+    if (negocioPorId.size !== negocios.length || negocios.some(b => b.profile_id !== sujeito.id))
+      return leituraIndisponivel();
+    const contaPorId = new Map(contas.map(a => [a.id, a]));
+    const relacaoPorPar = new Map(relacoes.map(r => [`${r.agency_business_id}:${r.advertiser_business_id}`, r]));
+
+    const estados = new Map<string, Awaited<ReturnType<typeof consultarDireitoFinanceiroNominal>>>();
+    for (const pedido of pedidos) estados.set(pedido.id, await consultarDireitoFinanceiroNominal(admin, pedido));
+    const usadasPorPedido = new Map<string, string[]>();
+    const elegiveis: CoberturaNominalPersistida[] = [];
+    for (const cobertura of coberturas) {
+      const pedido = pedidoPorId.get(cobertura.order_id);
+      const unidade = unidadePorId.get(cobertura.unit_id);
+      const contratante = negocioPorId.get(cobertura.contractor_business_id);
+      const anunciante = negocioPorId.get(cobertura.advertiser_business_id);
+      if (!pedido || !unidade || unidade.intake_context_id !== cobertura.context_id
+        || unidade.intake_unit_id !== cobertura.intake_unit_id
+        || unidade.advertiser_business_id !== cobertura.advertiser_business_id
+        || unidade.ad_account_id !== cobertura.ad_account_id || !contratante || !anunciante) continue;
+      const relacao = pedido.contractor_type === "agency"
+        ? relacaoPorPar.get(`${contratante.id}:${anunciante.id}`) ?? null : null;
+      const conta = cobertura.ad_account_id ? contaPorId.get(cobertura.ad_account_id) ?? null : null;
+      const usadas = usadasPorPedido.get(pedido.id) ?? [];
+      const plano = prepararCoberturaNominal(pedido, unidade, estados.get(pedido.id) ?? "verification_unavailable", {
+        profileId: sujeito.id, email, emailConfirmed: true,
+        contractor: { id: contratante.id, ownerProfileId: contratante.profile_id },
+        advertiser: { id: anunciante.id, ownerProfileId: anunciante.profile_id },
+        relation: relacao ? { agencyBusinessId: relacao.agency_business_id,
+          advertiserBusinessId: relacao.advertiser_business_id,
+          ownerProfileId: relacao.owner_profile_id, revoked: relacao.revoked_at !== null } : null,
+        adAccount: conta ? { id: conta.id, businessId: conta.business_id } : null,
+      }, usadas);
+      if (!plano.eligible) continue;
+      elegiveis.push(cobertura);
+      if (cobertura.ad_account_id) {
+        usadas.push(cobertura.ad_account_id);
+        usadasPorPedido.set(pedido.id, usadas);
+      }
+    }
+    return { state: "ok", coverages: elegiveis };
+  } catch {
+    return leituraIndisponivel();
+  }
+}
diff --git a/lib/contratacao/mensagens-contexto-v1.ts b/lib/contratacao/mensagens-contexto-v1.ts
new file mode 100644
--- /dev/null
+++ b/lib/contratacao/mensagens-contexto-v1.ts
@@ -0,0 +1,77 @@
+import type {PedidoFinanceiroContexto,UnidadeFinanceiraContexto} from "./financeiro-contexto-v1.ts";
+import {conferirUnidadesFinanceiras,origemFinanceiraContexto} from "./financeiro-contexto-v1.ts";
+import {identidadeComercialOficial,ORIGEM_COMERCIAL_OFICIAL} from "./ambiente-comercial-oficial-v1.ts";
+const emailValido=(v:unknown):v is string=>typeof v==="string" && v.length<=254 && /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(v) && !/[\x00-\x1f\x7f]/.test(v);
+/** Somente preparação. Nenhum envio, confirmação de conta ou concessão. */
+export function prepararMensagensContexto(order:PedidoFinanceiroContexto,units:UnidadeFinanceiraContexto[],financialState:string,
+  env:Record<string,string|undefined>) {
+  if(financialState!=="payment_approved" || order.status!=="payment_approved" || !conferirUnidadesFinanceiras(order,units))return null;
+  const nominal=[...units].sort((a,b)=>a.ordinal-b.ordinal).map(u=>`${u.ordinal}. ${u.advertiser_name}`).join("\n");
+  const summary=[`Pedido: ${order.id}`,`Contratante: ${order.legal_name}`,`Tipo: ${order.contractor_type==="agency" ? "Agência" : "Cliente direto"}`,
+    `Valor confirmado: ${new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL"}).format(order.total_cents/100)}`,
+    `Cobrança: ${order.provider_charge_id}`,"Contas de anúncios contratadas:",nominal];
+  if(identidadeComercialOficial(env)) {
+    const from=env.V2G_PRODUCTION_PAYMENT_EMAIL_FROM,to=order.buyer_email;
+    const buyer=env.V2G_COMMERCIAL_BUYER_PREPARE_ENABLED==="true"&&emailValido(from)&&emailValido(to)?{
+      from:`V2G <${from}>`,to:[to],subject:"V2G | Pagamento confirmado",
+      text:["O Asaas confirmou o pagamento desta cobrança.",...summary,
+        "Para entrar ou criar seu acesso, use o e-mail desta compra e o CPF/CNPJ do contratante.",
+        `Abrir meu acesso: ${ORIGEM_COMERCIAL_OFICIAL}/entrar?next=%2Fpreparar-acesso`,
+        "Confirme seu próprio e-mail e escolha o destino de cada unidade. O link não concede acesso sozinho.",
+        order.contractor_type==="agency"?"O acesso é da agência, com seus anunciantes na carteira. Não foram criados logins para os clientes.":"Escolha seu negócio para receber a unidade contratada.",
+        "Esta confirmação não é nota fiscal. Contrato e preparação da campanha são acompanhados separadamente."].join("\n"),
+    }:null;
+    const internalTo=env.V2G_COMMERCIAL_INTERNAL_NOTICE_TO;
+    const internal=env.V2G_COMMERCIAL_INTERNAL_NOTICE_ENABLED==="true"&&internalTo==="victor.cabral@v2gmidia.com.br"&&emailValido(from)?{
+      from:`V2G <${from}>`,to:[internalTo],subject:"V2G | Pagamento confirmado — acompanhamento interno",
+      text:[...summary,`Origem: ${origemFinanceiraContexto(order.intake_source)}`,"Acesso depende da identidade confirmada e da seleção das unidades.",
+        `Consulta interna: ${ORIGEM_COMERCIAL_OFICIAL}/pedidos`].join("\n"),
+    }:null;
+    return {buyer,internal};
+  }
+  if(env.ASAAS_ENVIRONMENT==="production")return null;
+  // Esta versão só pode preparar e-mail de QA para a caixa já autorizada. Não
+  // há fallback para buyer_email nem para o login de um operador.
+  const from=env.V2G_PAYMENT_EMAIL_FROM,qaTo=env.V2G_PAYMENT_EMAIL_QA_TO;
+  const buyer=env.V2G_COMMERCIAL_BUYER_PREPARE_ENABLED==="true" && emailValido(from) && qaTo==="victor.cabral@v2gmidia.com.br" ? {
+    from:`V2G <${from}>`,to:[qaTo],subject:"[TESTE QA] V2G | Pagamento confirmado",
+    text:["[TESTE QA — sem prova de dinheiro real]","O Asaas confirmou o pagamento desta cobrança.",...summary,
+      "Pagamento, confirmação do e-mail e liberação do negócio são etapas distintas.",
+      "Para entrar ou criar seu acesso, use o e-mail desta compra e o CPF/CNPJ do contratante.",
+      "Abrir meu acesso: https://v2g-webapp-qa.vercel.app/entrar?next=%2Fpreparar-acesso",
+      "Confirme seu próprio e-mail quando solicitado. Depois escolha o destino de cada unidade contratada.",
+      order.contractor_type==="agency"
+        ? "A conta é da agência. Os anunciantes são acompanhados dentro dela; esta compra não cria logins para seus clientes."
+        : "Selecione o seu negócio para receber a unidade contratada.",
+      "Este link não concede acesso sozinho. A liberação depende do pagamento conferido, do e-mail confirmado e dos destinos escolhidos.",
+      "Esta confirmação não é nota fiscal. Contrato e preparação da campanha são acompanhados separadamente."].join("\n"),
+  } : null;
+  const to=env.V2G_COMMERCIAL_INTERNAL_NOTICE_TO;
+  const internal=env.V2G_COMMERCIAL_INTERNAL_NOTICE_ENABLED==="true" && to==="victor.cabral@v2gmidia.com.br" && emailValido(from) ? {
+    from:`V2G <${from}>`,to:[to],subject:"[TESTE QA] V2G | Pagamento confirmado — acompanhamento interno",
+    text:["[TESTE QA]",...summary,`Origem: ${origemFinanceiraContexto(order.intake_source)}`,
+      "Pagamento registrado; acesso por unidade ainda depende do vínculo exato.",
+      "Consulta interna: https://v2g-webapp-qa.vercel.app/pedidos"].join("\n"),
+  } : null;
+  return {buyer,internal};
+}
+
+export type AvisoInterno={id:string;status:"blocked"|"queued"|"sending"|"accepted"|"review";payload:unknown};
+/** Porta explícita para futura entrega. Não contém cliente de e-mail/fetch. */
+export async function despacharAvisoInternoContexto(item:AvisoInterno,ports:{
+  enabled:boolean;canSend:()=>Promise<boolean>;reserve:()=>Promise<boolean>;
+  send:(payload:unknown,idempotencyKey:string)=>Promise<string|null>;
+  record:(status:"accepted"|"review",providerId:string|null)=>Promise<boolean>;
+}) {
+  if(!ports.enabled)return "disabled";
+  if(item.status==="accepted")return "accepted";
+  if(item.status!=="queued")return "review";
+  try {
+    if(!await ports.canSend())return "suppressed";
+    if(!await ports.reserve())return "reserved_elsewhere";
+    let id:string|null=null;
+    try {id=await ports.send(item.payload,`commercial-internal/v1/${item.id}`);}catch{/* Resultado ambíguo: nunca libera repetição automática. */}
+    if(!id){await ports.record("review",null);return "review";}
+    return await ports.record("accepted",id) ? "accepted" : "review";
+  }catch{return "review";}
+}
diff --git a/lib/contratacao/mensagens-renovacao-contexto-v1.ts b/lib/contratacao/mensagens-renovacao-contexto-v1.ts
