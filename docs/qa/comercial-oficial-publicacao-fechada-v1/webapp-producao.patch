diff --git a/app/api/comercial/entrada/route.ts b/app/api/comercial/entrada/route.ts
new file mode 100644
--- /dev/null
+++ b/app/api/comercial/entrada/route.ts
@@ -0,0 +1,36 @@
+import { createHmac } from "node:crypto";
+import { NextRequest,NextResponse } from "next/server";
+import { comercialV1Ativo,hostComercialPermitido } from "@/lib/contratacao/ambiente-comercial-v1";
+import { lerHandoffComercial } from "@/lib/contratacao/handoff-comercial-v1";
+import { hashComercial } from "@/lib/contratacao/contexto-comercial-v1";
+import { createAdminClient } from "@/lib/supabase/admin";
+import {schemaComercialOficialPronto} from "@/lib/contratacao/schema-comercial-oficial-v1";
+
+export const runtime="nodejs";
+export async function POST(req:NextRequest) {
+  const response=(status:number,value:object)=>NextResponse.json(value,{status,headers:{"Cache-Control":"no-store"}});
+  if (!comercialV1Ativo()) return response(404,{erro:"indisponivel"});
+  if (!hostComercialPermitido(req.headers)) return response(403,{erro:"indisponivel"});
+  let body="";
+  const reader=req.body?.getReader();
+  if (!reader) return response(400,{erro:"solicitacao_invalida"});
+  try {
+    const chunks:Uint8Array[]=[]; let size=0;
+    for (;;) {const next=await reader.read(); if(next.done)break; size+=next.value.length;
+      if(size>65536){await reader.cancel();return response(413,{erro:"solicitacao_invalida"});} chunks.push(next.value);}
+    body=Buffer.concat(chunks).toString("utf8");
+  } catch {return response(400,{erro:"solicitacao_invalida"});}
+  const secret=process.env.V2G_COMMERCIAL_LP_HANDOFF_SECRET;
+  const envelope=lerHandoffComercial(body,req.headers.get("x-v2g-signature"),secret);
+  if (!envelope) return response(403,{erro:"solicitacao_invalida"});
+  // PRF: capability determinística de alta entropia para replay idempotente da
+  // mesma referência; armazenar só hash, consumir uma vez na troca por cookie.
+  const resumeToken=createHmac("sha256",secret!).update(`commercial-resume/v1/${envelope.data.reference.toLowerCase()}`).digest("hex");
+  try {
+    const admin=createAdminClient();if(!await schemaComercialOficialPronto(admin))return response(503,{erro:"indisponivel"});
+    const saved=await admin.rpc("criar_contexto_comercial_v1",{p_id:envelope.data.reference.toLowerCase(),
+      p_original:envelope.data,p_source:envelope.source,p_session_hash:hashComercial(resumeToken)});
+    if(saved.error || saved.data!==envelope.data.reference.toLowerCase()) return response(409,{erro:"contexto_indisponivel"});
+    return response(200,{reference:saved.data,resumeToken});
+  } catch {return response(503,{erro:"contexto_indisponivel"});}
+}
diff --git a/app/api/comercial/retomar/route.ts b/app/api/comercial/retomar/route.ts
new file mode 100644
--- /dev/null
+++ b/app/api/comercial/retomar/route.ts
@@ -0,0 +1,51 @@
+import {randomBytes} from "node:crypto";
+import { NextRequest,NextResponse } from "next/server";
+import { comercialV1Ativo,origemComercialPermitida,hostComercialPermitido } from "@/lib/contratacao/ambiente-comercial-v1";
+import { UUID_COMERCIAL } from "@/lib/contratacao/comercial-v1";
+import { hashComercial } from "@/lib/contratacao/contexto-comercial-v1";
+import { contextoComercialDoServidor } from "@/lib/contratacao/comercial-v1-servidor";
+import {createClient} from "@/lib/supabase/server";
+import {createAdminClient} from "@/lib/supabase/admin";
+import {identidadeComercialOficial,ORIGEM_COMERCIAL_OFICIAL} from "@/lib/contratacao/ambiente-comercial-oficial-v1";
+import {schemaComercialOficialPronto} from "@/lib/contratacao/schema-comercial-oficial-v1";
+
+export async function POST(req:NextRequest) {
+  const deny=()=>NextResponse.json({erro:"contexto_indisponivel"},{status:403,headers:{"Cache-Control":"no-store"}});
+  if(!comercialV1Ativo()) return deny();
+  // Cross-origin permitido somente para a ponte LP nominal. Cookie/identidade
+  // existente nunca substituem o segredo neste POST vindo de outro site.
+  const lp=process.env.V2G_COMMERCIAL_LP_ORIGIN;
+  const lpPermitida=identidadeComercialOficial()?lp==="https://www.v2gmidia.com.br":!!lp&&/^https:\/\/[^/?#]+$/.test(lp);
+  const fromLP=lpPermitida&&req.headers.get("origin")===lp;
+  const sameOrigin=origemComercialPermitida(req.headers);
+  if(!sameOrigin && !fromLP) return deny();
+  if(!hostComercialPermitido(req.headers))return deny();
+  const length=Number(req.headers.get("content-length"));
+  if(!Number.isFinite(length)||length<1||length>2048) return deny();
+  try {
+    const body=await req.text(); if(Buffer.byteLength(body)>2048)return deny();
+    const form=new URLSearchParams(body), reference=form.get("reference")?.toLowerCase(),token=form.get("resumeToken");
+    if(!reference||!UUID_COMERCIAL.test(reference)) return deny();
+    let cookieSecret="auth";
+    if(token) {
+      if(!/^[a-f0-9]{64}$/.test(token))return deny();
+      cookieSecret=randomBytes(32).toString("hex");
+      const admin=createAdminClient();if(!await schemaComercialOficialPronto(admin))return deny();
+      const exchanged=await admin.rpc("trocar_retomada_comercial_v1",{
+        p_id:reference,p_resume_hash:hashComercial(token),p_session_hash:hashComercial(cookieSecret)});
+      if(exchanged.error||exchanged.data!==true)return deny();
+    } else {
+      if(!sameOrigin)return deny();
+      const {data:{user}}=await (await createClient()).auth.getUser();
+      if(!await contextoComercialDoServidor(reference,user))return deny();
+    }
+    // Destino relativo fixo: não usar URL/origin/next recebido para redirect.
+    const host=req.headers.get("host")!;
+    const origin=identidadeComercialOficial()?ORIGEM_COMERCIAL_OFICIAL:host==="v2g-webapp-qa.vercel.app" ? "https://v2g-webapp-qa.vercel.app" : `http://${host}`;
+    const response=NextResponse.redirect(new URL("/contratar",origin),303);
+    response.headers.set("Cache-Control","no-store");
+    response.cookies.set("v2g_commercial_context",`${reference}.${cookieSecret}`,{
+      httpOnly:true,secure:process.env.NODE_ENV==="production",sameSite:"lax",path:"/",maxAge:1800});
+    return response;
+  } catch {return deny();}
+}
