+import type { SupabaseClient } from "@supabase/supabase-js";
+import type {EstadoPagamentoPublico} from "./estado-pagamento-publico";
+import {estadoInicialNominal,type EventoInicialNominal} from "./estado-inicial-nominal-v1";
+
+export type PedidoParaDireitoNominal = {
+  id: string;
+  status: string;
+  provider_charge_id: string | null;
+  total_cents: number;
+  provider_first_due_date: string | null;
+  billing_period?: string;
+};
+
+/**
+ * Direito nominal exige o fato positivo exato da cobrança inicial. O status
+ * do cabeçalho sozinho nunca libera acesso e nenhuma consulta sai da base.
+ */
+export async function consultarDireitoFinanceiroNominal(
+  admin: Pick<SupabaseClient, "from"> & Partial<Pick<SupabaseClient,"rpc">>,
+  pedido: PedidoParaDireitoNominal,
+): Promise<EstadoPagamentoPublico> {
+  if (pedido.status === "cancelled") return "cancelled";
+  if (pedido.status !== "payment_approved" || !pedido.provider_charge_id
+    || !Number.isSafeInteger(pedido.total_cents) || pedido.total_cents <= 0
+    || typeof pedido.provider_first_due_date !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(pedido.provider_first_due_date))
+    return "awaiting_payment";
+  try {
+    const { data, error } = await admin.from("commercial_payment_events")
+      .select("event_type,provider_charge_id,provider_subscription_id,amount_cents,due_date")
+      .eq("order_id", pedido.id).eq("provider_charge_id", pedido.provider_charge_id)
+      .order("received_at", { ascending: false }).limit(100);
+    const initial=estadoInicialNominal(pedido,data as EventoInicialNominal[],!error&&Array.isArray(data)&&data.length<100);
+    if(initial!=="payment_approved")return initial;
+    if(pedido.billing_period==="monthly") {
+      if(!admin.rpc)return "verification_unavailable";
+      const cycle=await admin.rpc("estado_ciclo_nominal_v1",{p_order:pedido.id});
+      if(cycle.error||!["payment_approved","awaiting_payment","payment_review","refunded"].includes(cycle.data))return "verification_unavailable";
+      return cycle.data as EstadoPagamentoPublico;
+    }
+    return "payment_approved";
+  } catch {
+    return "verification_unavailable";
+  }
+}
