+"use client";
+import {useActionState} from "react";
+import {prepararCheckoutAction,type FinalizarContextoState} from "./actions";
+export function PrepararPedido(){
+  const [state,action,pending]=useActionState<FinalizarContextoState,FormData>(prepararCheckoutAction,{});
+  return <form action={action} aria-busy={pending}>
+    {state.erro&&<p className="form-error" role="alert">{state.erro}</p>}
+    <button disabled={pending} type="submit">{pending?"Conferindo pedido…":"Preparar este pedido"}</button>
+    <p>Preparar o pedido não inicia pagamento nem libera acesso.</p>
+  </form>;
+}
diff --git a/app/contratar/financeiro-actions.ts b/app/contratar/financeiro-actions.ts
new file mode 100644
--- /dev/null
+++ b/app/contratar/financeiro-actions.ts
@@ -0,0 +1,38 @@
+"use server";
+import {cookies,headers} from "next/headers";
+import {createClient} from "@/lib/supabase/server";
+import {createAdminClient} from "@/lib/supabase/admin";
+import {financeiroContextoAtivo,PREFIXO_PEDIDO_CONTEXTO} from "@/lib/contratacao/financeiro-contexto-v1";
+import {origemComercialPermitida} from "@/lib/contratacao/ambiente-comercial-v1";
+import {UUID_COMERCIAL} from "@/lib/contratacao/comercial-v1";
+import {lerCookieComercial,hashComercial} from "@/lib/contratacao/contexto-comercial-v1";
+import {contextoComercialDoServidor} from "@/lib/contratacao/comercial-v1-servidor";
+import {consultarEstadoPagamento} from "@/lib/contratacao/consultar-estado-pagamento";
+import type {EstadoPagamentoPublico} from "@/lib/contratacao/estado-pagamento-publico";
+
+type PedidoState={erro?:string;orderId?:string;status?:EstadoPagamentoPublico};
+/** Porta separada, não acoplada ao botão dos passos 1/2. Não chama provedor. */
+export async function prepararPedidoFinanceiroAction(_previous:PedidoState,form:FormData):Promise<PedidoState> {
+  if(!financeiroContextoAtivo() || !origemComercialPermitida(await headers()))return {erro:"A preparação financeira está indisponível."};
+  const reference=form.get("reference");
+  if(typeof reference!=="string" || !UUID_COMERCIAL.test(reference) || form.getAll("reference").length!==1
+    || [...form.keys()].some(k=>k!=="reference" && !k.startsWith("$ACTION_")))return {erro:"Retome a contratação confirmada para continuar."};
+  try {
+    const {data:{user}}=await (await createClient()).auth.getUser();
+    const cookie=lerCookieComercial((await cookies()).get("v2g_commercial_context")?.value);
+    const secret=cookie?.reference===reference && cookie.secret!=="auth" ? cookie.secret : undefined;
+    const context=await contextoComercialDoServidor(reference,user,secret);
+    if(!context?.confirmed_data)return {erro:"Não foi possível conferir esta contratação."};
+    if(user && (typeof user.email!=="string" || user.email.trim().toLowerCase()!==context.recipient_email))
+      return {erro:"Este contexto pertence a outro e-mail. Saia da conta ou retome a contratação com o destinatário correto."};
+    const actor=user?.email_confirmed_at ? user.id : null,email=user?.email_confirmed_at ? user.email?.trim().toLowerCase() : null;
+    const admin=createAdminClient();
+    const r=await admin.rpc("criar_pedido_contexto_v1",{p_context:reference,p_session_hash:secret ? hashComercial(secret) : null,
+      p_actor:actor,p_verified_email:email});
+    if(r.error || typeof r.data!=="string" || !UUID_COMERCIAL.test(r.data))return {erro:"Não foi possível confirmar o pedido. Preserve a referência e procure a equipe antes de iniciar outro."};
+    const current=await admin.from("commercial_orders").select("id,intake_context_id,external_ref,status,provider_charge_id").eq("id",r.data).single();
+    if(current.error || !current.data || current.data.intake_context_id!==reference || current.data.external_ref!==PREFIXO_PEDIDO_CONTEXTO+reference)
+      return {erro:"Pedido registrado, mas a conferência do estado está pendente. Retome a mesma contratação antes de pagar."};
+    return {orderId:r.data,status:await consultarEstadoPagamento(admin,current.data)};
+  }catch{return {erro:"Não foi possível conferir o pedido agora. Retome a mesma contratação; nenhum pagamento foi iniciado."};}
+}
