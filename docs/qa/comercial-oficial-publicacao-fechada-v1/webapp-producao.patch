+import "server-only";
+import { createAdminClient } from "@/lib/supabase/admin";
+import { carregarContextoComercial, type ContextoComercial } from "./contexto-comercial-v1";
+import type { SujeitoComercial } from "./comercial-v1";
+import { comercialV1Ativo } from "./ambiente-comercial-v1";
+import {financeiroComercialOficialAtivo,coberturaComercialOficialAtiva} from "./ambiente-comercial-oficial-v1";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+
+export async function contextoComercialDoServidor(reference:string,subject:SujeitoComercial|null,secret?:string) {
+  if (!comercialV1Ativo()&&!financeiroComercialOficialAtivo()&&!coberturaComercialOficialAtiva()) return null;
+  try {
+    const admin=createAdminClient();if(!await schemaComercialOficialPronto(admin))return null;
+    return await carregarContextoComercial(reference,subject,secret,async id=>{
+      const result = await admin.from("commercial_intake_contexts")
+        .select("id,original_data,confirmed_data,source,recipient_email,session_hash,expires_at,exchanged_at")
+        .eq("id",id).maybeSingle();
+      return result.error ? null : result.data as ContextoComercial|null;
+    });
+  } catch {return null;}
+}
