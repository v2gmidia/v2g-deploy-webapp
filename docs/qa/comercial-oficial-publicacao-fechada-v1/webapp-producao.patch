+import "server-only";
+import type {SupabaseClient} from "@supabase/supabase-js";
+import {ehPedidoContexto,conferirUnidadesFinanceiras,type PedidoFinanceiroContexto,type UnidadeFinanceiraContexto} from "./financeiro-contexto-v1";
+import {comercialV1Ativo} from "./ambiente-comercial-v1";
+import {financeiroComercialOficialAtivo,coberturaComercialOficialAtiva} from "./ambiente-comercial-oficial-v1";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+import {COLUNAS_PEDIDO_CONTEXTO} from "./processar-financeiro-contexto-v1";
+import {estadoInicialNominal,type EventoInicialNominal} from "./estado-inicial-nominal-v1";
+import {cicloMensalNaData,dataRecorrenteValida} from "./recorrencia-contexto-v1";
+import {vencimentoNoMesSeguinte} from "./fluxo-cartao-mensal";
+import type {EstadoPagamentoPublico} from "./estado-pagamento-publico";
+
+export const TAMANHO_PAGINA_NOMINAL=10;
+type Operator={email_confirmed_at?:string|null;app_metadata?:Record<string,unknown>};
+type Order=PedidoFinanceiroContexto&{created_at:string;provider_card_flow:string;subscription_creation_started_at:string|null;provider_subscription_first_due_date:string|null};
+type Unit=UnidadeFinanceiraContexto&{order_id:string};
+type Event=EventoInicialNominal&{order_id:string};
+type Subscription={order_id:string;provider_subscription_id:string|null;first_due_date:string;bound_at:string|null};
+type Cycle={order_id:string;provider_subscription_id:string;provider_charge_id:string;due_date:string};
+type Queue={order_id:string;provider_charge_id:string;status:string};
+export type EstadoFilaNominal="none"|"blocked"|"queued"|"sending"|"accepted"|"review"|"unavailable";
+export type PedidoNominalOperacao={
+  id:string;name:string;type:"agency"|"direct";email:string;amountCents:number;period:string;
+  units:{id:string;name:string;destinationIndicated:boolean}[]|null;
+  initial:EstadoPagamentoPublico;current:EstadoPagamentoPublico;due:string|null;
+  subscription:"not_applicable"|"not_started"|"reconciliation"|"registered"|"unavailable";
+  buyerQueue:EstadoFilaNominal;internalQueue:EstadoFilaNominal;
+};
+export type ResultadoPedidosNominais={state:"disabled"|"unavailable"|"ready";page:number;hasNext:boolean;pageLimitReached?:boolean;items:PedidoNominalOperacao[]};
+export function paginaNominal(value:unknown){return typeof value==="string"&&/^[1-9]\d{0,2}$/.test(value)?Number(value):1;}
+const empty=(state:ResultadoPedidosNominais["state"],page:number):ResultadoPedidosNominais=>({state,page,hasNext:false,items:[]});
+const knownState=(v:unknown):v is EstadoPagamentoPublico=>typeof v==="string"&&["payment_approved","awaiting_payment","payment_review","refunded"].includes(v);
+const group=<T extends {order_id:string}>(rows:T[],id:string)=>rows.filter(x=>x.order_id===id);
+function queueState(rows:Queue[]|null,order:string,charge:string|null):EstadoFilaNominal {
+  if(!charge)return "none";
+  if(!rows)return "unavailable";
+  const matches=rows.filter(x=>x.order_id===order&&x.provider_charge_id===charge);
+  if(!matches.length)return "none";
+  if(matches.length!==1)return "unavailable";
+  const state=matches[0]!.status;
+  return ["blocked","queued","sending","accepted","review"].includes(state)?state as EstadoFilaNominal:"unavailable";
+}
+/** Leitura somente no servidor. O chamador deriva operador de getUser; o DTO
+ * não contém payload de fila, IP, documento, token ou comandos financeiros. */
+export async function lerPedidosNominaisOperador(admin:SupabaseClient,operator:Operator|null,pageInput:unknown,
+  env:Record<string,string|undefined>=process.env,day=new Intl.DateTimeFormat("sv-SE",{timeZone:"America/Sao_Paulo"}).format(new Date())):Promise<ResultadoPedidosNominais> {
+  const page=paginaNominal(pageInput);
+  if(!(comercialV1Ativo(env)||financeiroComercialOficialAtivo(env)||coberturaComercialOficialAtiva(env))||!operator?.email_confirmed_at||operator.app_metadata?.papel!=="operador")return empty("disabled",page);
+  try {
+    if(!await schemaComercialOficialPronto(admin,env))return empty("unavailable",page);
+    const offset=(page-1)*TAMANHO_PAGINA_NOMINAL;
+    const header=await admin.from("commercial_orders").select(COLUNAS_PEDIDO_CONTEXTO+",created_at,provider_card_flow,subscription_creation_started_at,provider_subscription_first_due_date")
+      .eq("origin","self_service").not("intake_context_id","is",null).order("created_at",{ascending:false}).order("id",{ascending:false})
+      .range(offset,offset+TAMANHO_PAGINA_NOMINAL);
+    if(header.error||!Array.isArray(header.data))return empty("unavailable",page);
+    const orders=(header.data as unknown as Order[]).slice(0,TAMANHO_PAGINA_NOMINAL);
+    if(orders.some(o=>!ehPedidoContexto(o.external_ref)||!["agency","direct"].includes(o.contractor_type)))return empty("unavailable",page);
+    if(!orders.length)return empty("ready",page);
+    const ids=orders.map(o=>o.id),charges=orders.flatMap(o=>o.provider_charge_id?[o.provider_charge_id]:[]);
+    const [unitsRead,eventsRead,subRead]=await Promise.all([
+      admin.from("commercial_order_units").select("id,order_id,intake_context_id,intake_unit_id,advertiser_name,advertiser_business_id,ad_account_id,ordinal").in("order_id",ids).order("ordinal").limit(1001),
+      charges.length?admin.from("commercial_payment_events").select("order_id,event_type,provider_charge_id,provider_subscription_id,amount_cents,due_date")
+        .in("order_id",ids).in("provider_charge_id",charges).order("received_at",{ascending:false}).limit(1001):Promise.resolve({data:[],error:null}),
+      admin.from("commercial_nominal_subscriptions_v1").select("order_id,provider_subscription_id,first_due_date,bound_at").in("order_id",ids).limit(11),
+    ]);
