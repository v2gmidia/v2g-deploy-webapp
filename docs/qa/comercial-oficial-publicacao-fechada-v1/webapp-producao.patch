+++ b/lib/contratacao/processar-entrega-contexto-v1.ts
@@ -0,0 +1,72 @@
+import "server-only";
+import type {SupabaseClient} from "@supabase/supabase-js";
+import {COLUNAS_PEDIDO_CONTEXTO} from "./processar-financeiro-contexto-v1";
+import {conferirUnidadesFinanceiras,type PedidoFinanceiroContexto,type UnidadeFinanceiraContexto} from "./financeiro-contexto-v1";
+import {consultarDireitoFinanceiroNominal} from "./direito-financeiro-nominal-v1";
+import {prepararMensagensContexto} from "./mensagens-contexto-v1";
+import {entregaContextoAtiva,entregarMensagemContexto,type ItemEntregaContexto,type PayloadEntregaContexto} from "./entrega-contexto-v1";
+import {prepararMensagensRenovacaoContexto} from "./mensagens-renovacao-contexto-v1";
+import {recorrenciaContextoAtiva} from "./recorrencia-contexto-v1";
+import {identidadeComercialOficial} from "./ambiente-comercial-oficial-v1";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+
+/** A mesma fila que o webhook preparou. Transporte explicitamente substituível
+ * nos ensaios; nunca carregar .env ou fazer fetch real nos testes. */
+export async function processarEntregaContextoV1(admin:SupabaseClient,orderId:string,
+  send:(payload:PayloadEntregaContexto,key:string)=>Promise<string|null>,env:Record<string,string|undefined>=process.env,renewalCharge?:string) {
+  if(!entregaContextoAtiva(env))return {state:"disabled" as const};
+  if(!await schemaComercialOficialPronto(admin,env))return {state:"pending" as const};
+  try {
+    const r=await admin.from("commercial_orders").select(COLUNAS_PEDIDO_CONTEXTO).eq("id",orderId).maybeSingle();
+    const order=r.data as PedidoFinanceiroContexto|null;
+    if(r.error||!order)return {state:"pending" as const};
+    if(renewalCharge&&(!recorrenciaContextoAtiva(env)||!/^pay_[A-Za-z0-9]+$/.test(renewalCharge)||renewalCharge===order.provider_charge_id))return {state:"suppressed" as const};
+    const charge=renewalCharge??order.provider_charge_id;
+    const cycle=renewalCharge?await admin.from("commercial_nominal_cycles_v1").select("due_date")
+      .eq("order_id",orderId).eq("provider_charge_id",renewalCharge).maybeSingle():null;
+    if(renewalCharge&&(cycle?.error||!cycle?.data))return {state:"pending" as const};
+    const rows=await admin.from("commercial_order_units").select("id,intake_context_id,intake_unit_id,advertiser_name,advertiser_business_id,ad_account_id,ordinal")
+      .eq("order_id",orderId).order("ordinal").limit(101);
+    if(rows.error||!conferirUnidadesFinanceiras(order,rows.data as UnidadeFinanceiraContexto[]))return {state:"pending" as const};
+    const canSend=async()=>{
+      if(renewalCharge){const state=await admin.rpc("estado_renovacao_nominal_v1",{p_order:orderId,p_charge:renewalCharge});return !state.error&&state.data==="payment_approved";}
+      const current=await admin.from("commercial_orders").select("id,status,provider_charge_id,total_cents,provider_first_due_date,billing_period")
+        .eq("id",orderId).maybeSingle();
+      return !current.error&&!!current.data&&current.data.provider_charge_id===order.provider_charge_id
+        &&await consultarDireitoFinanceiroNominal(admin,current.data)==="payment_approved";
+    };
+    if(!await canSend())return {state:"suppressed" as const};
+    const expected=renewalCharge?prepararMensagensRenovacaoContexto(order,rows.data as UnidadeFinanceiraContexto[],renewalCharge,cycle!.data!.due_date,env)
+      :prepararMensagensContexto(order,rows.data as UnidadeFinanceiraContexto[],"payment_approved",env);
+    if(!expected?.buyer||!expected.internal?.from)return {state:"pending" as const};
+    const results:Record<string,string>={};
+    for(const kind of ["buyer","internal"] as const){
+      const table=kind==="buyer"?"commercial_payment_email_outbox":"commercial_internal_notice_outbox";
+      let q=admin.from(table).select("id,status,payload").eq("order_id",orderId).eq("provider_charge_id",charge);
+      if(kind==="internal")q=q.eq("notice_type","payment_confirmed");
+      const row=await q.maybeSingle();
+      if(row.error||!row.data){results[kind]="pending";continue;}
+      const item=row.data as ItemEntregaContexto;
+      results[kind]=await entregarMensagemContexto(kind,item,expected[kind] as PayloadEntregaContexto,{
+        canSend,send,
+        reserve:async()=>{const saved=await admin.from(table).update({status:"sending",updated_at:new Date().toISOString()})
+          .eq("id",item.id).eq("status","queued").select("id").maybeSingle();return !saved.error&&!!saved.data;},
+        record:async(status,id)=>{const saved=await admin.from(table).update({status,provider_message_id:id,updated_at:new Date().toISOString()})
+          .eq("id",item.id).eq("status","sending").select("id").maybeSingle();return !saved.error&&!!saved.data;},
+      },env);
+    }
+    return {state:Object.values(results).includes("pending")?"pending" as const:"processed" as const,...results};
+  }catch{return {state:"pending" as const};}
+}
+
+/** Não é chamado enquanto as guardas de envio estão OFF. */
+export async function enviarEntregaContexto(payload:PayloadEntregaContexto,key:string) {
+  if(!entregaContextoAtiva())return null;
+  const apiKey=identidadeComercialOficial()?process.env.V2G_PRODUCTION_PAYMENT_EMAIL_RESEND_API_KEY:process.env.V2G_PAYMENT_EMAIL_RESEND_API_KEY;
+  if(!apiKey)return null;
+  const response=await fetch("https://api.resend.com/emails",{method:"POST",headers:{
+    Authorization:`Bearer ${apiKey}`,"Content-Type":"application/json","Idempotency-Key":key,
+  },body:JSON.stringify(payload),signal:AbortSignal.timeout(10000)});
+  const body:unknown=await response.json().catch(()=>null);
+  return response.ok&&body&&typeof body==="object"&&"id" in body&&typeof body.id==="string"&&body.id?body.id:null;
+}
diff --git a/lib/contratacao/processar-financeiro-contexto-v1.ts b/lib/contratacao/processar-financeiro-contexto-v1.ts
new file mode 100644
--- /dev/null
+++ b/lib/contratacao/processar-financeiro-contexto-v1.ts
@@ -0,0 +1,132 @@
+import "server-only";
+import type {SupabaseClient} from "@supabase/supabase-js";
+import type {EventoFinanceiro} from "./evento-financeiro";
+import {financeiroContextoAtivo,ehPedidoContexto,canonicoDoPedidoContexto,cobrancaCanonicaDoContexto,conferirUnidadesFinanceiras,
+ type PedidoFinanceiroContexto,type UnidadeFinanceiraContexto} from "./financeiro-contexto-v1";
+import {consultarEstadoPagamento} from "./consultar-estado-pagamento";
+import {prepararMensagensContexto} from "./mensagens-contexto-v1";
+import {replayEstornadoJaRegistrado} from "./confirmacao-canonica";
+import {recorrenciaContextoAtiva} from "./recorrencia-contexto-v1";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+
+export const COLUNAS_PEDIDO_CONTEXTO="id,external_ref,intake_context_id,intake_snapshot,intake_source,contractor_type,buyer_email,buyer_profile_id,business_id,legal_name,status,unit_count,total_cents,payment_method,provider_customer_id,provider_charge_id,provider_first_due_date,billing_period,provider_subscription_id";
+export type ConsultaCanonicaContexto=(path:string)=>Promise<{ok:boolean;body:unknown}>;
+
+async function lerPreparacaoFinanceira(admin:SupabaseClient,id:string) {
+  const result=await admin.from("commercial_orders").select(COLUNAS_PEDIDO_CONTEXTO).eq("id",id).maybeSingle();
+  const order=result.data as PedidoFinanceiroContexto|null;
+  if(result.error || !order || !ehPedidoContexto(order.external_ref))return null;
+  const rows=await admin.from("commercial_order_units")
+    .select("id,intake_context_id,intake_unit_id,advertiser_name,advertiser_business_id,ad_account_id,ordinal")
+    .eq("order_id",id).order("ordinal").limit(101);
+  return !rows.error && conferirUnidadesFinanceiras(order,rows.data as UnidadeFinanceiraContexto[]) ? order : null;
+}
+/** IDs internos conciliados, nunca dados de criação enviados pelo navegador.
+ * Não faz POST financeiro nem reabre reserva após resultado perdido. */
+export async function reservarPreparacaoFinanceiraContexto(admin:SupabaseClient,orderId:string,customerId:string,dueDate:string,
+ consult:ConsultaCanonicaContexto,env:Record<string,string|undefined>=process.env) {
+  if(!financeiroContextoAtivo(env))return "disabled";
+  if(!await schemaComercialOficialPronto(admin,env))return "disabled";
+  if(!/^cus_[A-Za-z0-9]+$/.test(customerId)||!/^\d{4}-\d{2}-\d{2}$/.test(dueDate))return "rejected";
+  try {
+    const order=await lerPreparacaoFinanceira(admin,orderId);
+    if(!order || order.status!=="awaiting_payment" || order.provider_charge_id)return "pending_reconciliation";
+    const response=await consult(`/customers/${encodeURIComponent(customerId)}`);
+    const c=response.body && typeof response.body==="object" && !Array.isArray(response.body) ? response.body as Record<string,unknown> : null;
+    if(!response.ok || !c || c.id!==customerId || c.externalReference!==orderId || c.deleted)return "rejected";
+    const r=await admin.rpc("reservar_pagamento_contexto_v1",{p_order:orderId,p_customer:customerId,p_due:dueDate});
+    return !r.error && r.data===true ? "reserved" : "pending_reconciliation";
+  }catch{return "pending_reconciliation";}
+}
+/** Associa somente cobrança já existente e relida do provedor; não a cria. */
+export async function conciliarVinculoFinanceiroContexto(admin:SupabaseClient,orderId:string,chargeId:string,
+ consult:ConsultaCanonicaContexto,env:Record<string,string|undefined>=process.env) {
+  if(!financeiroContextoAtivo(env))return "disabled";
+  if(!await schemaComercialOficialPronto(admin,env))return "disabled";
+  if(!/^pay_[A-Za-z0-9]+$/.test(chargeId))return "rejected";
+  try {
+    const order=await lerPreparacaoFinanceira(admin,orderId);
+    if(!order)return "pending_reconciliation";
+    const canonical=await consult(`/payments/${encodeURIComponent(chargeId)}`);
+    if(!canonical.ok || !cobrancaCanonicaDoContexto(order,chargeId,canonical.body))return "rejected";
+    const r=await admin.rpc("vincular_cobranca_contexto_v1",{p_order:orderId,p_customer:order.provider_customer_id,p_charge:chargeId,p_due:order.provider_first_due_date});
+    return !r.error && r.data===true ? "bound" : "pending_reconciliation";
+  }catch{return "pending_reconciliation";}
+}
+
+export async function processarFinanceiroContextoV1(admin:SupabaseClient,orderId:string,event:EventoFinanceiro,
+ consult:ConsultaCanonicaContexto,env:Record<string,string|undefined>=process.env) {
+  if(!financeiroContextoAtivo(env))return {status:503,body:{erro:"financeiro_contexto_fechado"}};
+  if(!await schemaComercialOficialPronto(admin,env))return {status:503,body:{erro:"schema_pendente"}};
+  try {
+    const read=await admin.from("commercial_orders").select(COLUNAS_PEDIDO_CONTEXTO).eq("id",orderId).maybeSingle();
+    const order=read.data as PedidoFinanceiroContexto|null;
+    if(read.error || !order || !ehPedidoContexto(order.external_ref))return {status:503,body:{erro:"vinculo_pendente"}};
+    if(event.assinaturaId) {
+      const recurrence=await import("./processar-recorrencia-contexto-v1");
+      return recurrence.processarRenovacaoNominalV1(admin,orderId,event,consult,env);
+    }
+    // O relógio do rascunho não participa do processamento de fato já vinculado.
+    if(!order.provider_charge_id || !order.provider_customer_id)return {status:503,body:{erro:"vinculo_pendente"}};
+    const canonical=await consult(`/payments/${encodeURIComponent(event.cobrancaId)}`);
+    if(!canonical.ok)return {status:503,body:{erro:"confirmacao_pendente"}};
+    if(!canonicoDoPedidoContexto(order,event,canonical.body)) {
+      if(["PAYMENT_CONFIRMED","PAYMENT_RECEIVED"].includes(event.tipo)) {
+        const prior=await admin.from("commercial_payment_events").select("provider_event_id",{count:"exact",head:true})
+          .eq("provider_event_id",event.eventoId).eq("order_id",order.id).eq("provider_charge_id",event.cobrancaId)
+          .eq("event_type",event.tipo).eq("amount_cents",event.valorCentavos).eq("due_date",event.vencimento).is("provider_subscription_id",null);
+        if(replayEstornadoJaRegistrado(order.id,event,canonical.body,!prior.error&&prior.count===1))
+          return {status:200,body:{ok:true,historico:true,access:"scope_binding_required"}};
+      }
+      return {status:422,body:{erro:"confirmacao_divergente"}};
+    }
+    const recorded=await admin.rpc("registrar_pagamento_contexto_v1",{p_order:orderId,p_event:event.eventoId,p_type:event.tipo,
+      p_customer:event.clienteId,p_charge:event.cobrancaId,p_amount:event.valorCentavos,p_due:event.vencimento});
+    if(recorded.error)return {status:503,body:{erro:"gravacao_pendente"}};
+    if(recorded.data!==true)return {status:422,body:{erro:"evento_divergente"}};
+    // A conciliação da assinatura não impede o efeito do pagamento já confirmado.
+    // Mantemos 503 para a retentativa, após preparar/entregar sob suas próprias guardas.
+    let recurrencePending=false;
+    if(order.billing_period==="monthly"&&recorrenciaContextoAtiva(env)&&["PAYMENT_CONFIRMED","PAYMENT_RECEIVED"].includes(event.tipo)) {
+      try {
+        const recurrence=await import("./processar-recorrencia-contexto-v1");
+        recurrencePending=!await recurrence.processarAssinaturaNominalV1(admin,orderId,consult,env);
+      }catch{recurrencePending=true;}
+    }
+    // O fato já está persistido. Efeitos falhos são conciliáveis; não voltam ao
+    // início de uma compra, não recriam assinatura e não concedem acesso.
+    let preparation:"prepared"|"blocked"|"pending"="blocked";
+    if(["PAYMENT_CONFIRMED","PAYMENT_RECEIVED"].includes(event.tipo)) {
+      try {
+        const refreshed=await admin.from("commercial_orders").select(COLUNAS_PEDIDO_CONTEXTO).eq("id",orderId).single();
+        const paid=refreshed.data as PedidoFinanceiroContexto|null;
+        const rows=await admin.from("commercial_order_units")
+          .select("id,intake_context_id,intake_unit_id,advertiser_name,advertiser_business_id,ad_account_id,ordinal")
+          .eq("order_id",orderId).order("ordinal").limit(101);
+        if(refreshed.error || !paid || rows.error || !conferirUnidadesFinanceiras(paid,rows.data as UnidadeFinanceiraContexto[]))preparation="pending";
+        else {
+          const state=await consultarEstadoPagamento(admin,paid);
+          if(state==="verification_unavailable" || state==="awaiting_payment")preparation="pending";
+          const messages=prepararMensagensContexto(paid,rows.data as UnidadeFinanceiraContexto[],state,env);
+          if(messages) {
+            const queued=await admin.rpc("preparar_efeitos_contexto_v1",{p_order:orderId,p_charge:event.cobrancaId,
+              p_buyer:messages.buyer,p_internal:messages.internal});
+            const missingConfig=(env.V2G_COMMERCIAL_BUYER_PREPARE_ENABLED==="true"&&!messages.buyer)
+              || (env.V2G_COMMERCIAL_INTERNAL_NOTICE_ENABLED==="true"&&!messages.internal);
+            preparation=queued.error||queued.data!==true||missingConfig ? "pending" : messages.buyer||messages.internal ? "prepared" : "blocked";
+          }
+        }
+      }catch{preparation="pending";}
+    }
+    if(preparation==="pending")return {status:503,body:{erro:"preparacao_pendente",paymentRecorded:true,access:"scope_binding_required"}};
+    if(preparation==="prepared"&&env.V2G_COMMERCIAL_EMAIL_DISPATCH_V1_ENABLED==="true") {
+      const delivery=await import("./processar-entrega-contexto-v1");
+      const result=await delivery.processarEntregaContextoV1(admin,orderId,delivery.enviarEntregaContexto,env);
+      if(result.state==="pending")return {status:503,body:{erro:"entrega_pendente",paymentRecorded:true,access:"scope_binding_required"}};
+      if(recurrencePending)return {status:503,body:{erro:"recorrencia_pendente",paymentRecorded:true,preparation,delivery:result,access:"scope_binding_required"}};
+      return {status:200,body:{ok:true,preparation,delivery:result,access:"scope_binding_required"}};
+    }
+    if(recurrencePending)return {status:503,body:{erro:"recorrencia_pendente",paymentRecorded:true,preparation,access:"scope_binding_required"}};
+    return {status:200,body:{ok:true,preparation,access:"scope_binding_required"}};
+  }catch{return {status:503,body:{erro:"confirmacao_pendente"}};}
+}
diff --git a/lib/contratacao/processar-recorrencia-contexto-v1.ts b/lib/contratacao/processar-recorrencia-contexto-v1.ts
new file mode 100644
--- /dev/null
+++ b/lib/contratacao/processar-recorrencia-contexto-v1.ts
@@ -0,0 +1,117 @@
+import "server-only";
+import {isIP} from "node:net";
+import type {SupabaseClient} from "@supabase/supabase-js";
+import {garantirAssinaturaApos3ds,type PedidoParaAssinatura3ds} from "./assinatura-apos-3ds";
+import {consultarDireitoFinanceiroNominal} from "./direito-financeiro-nominal-v1";
+import {recorrenciaContextoAtiva,VERSAO_RECORRENCIA_NOMINAL,assinaturaNominalConfere,renovacaoNominalConfere,
+  type ReciboAssinaturaNominal,type PedidoRecorrente} from "./recorrencia-contexto-v1";
+import {conferirUnidadesFinanceiras,ehPedidoContexto,type PedidoFinanceiroContexto,type UnidadeFinanceiraContexto} from "./financeiro-contexto-v1";
+import type {EventoFinanceiro} from "./evento-financeiro";
+import type {TransporteCheckoutContexto} from "./checkout-contexto-v1";
+import {prepararMensagensRenovacaoContexto} from "./mensagens-renovacao-contexto-v1";
+import {replayEstornadoJaRegistrado} from "./confirmacao-canonica";
+import {vencimentoNoMesSeguinte} from "./fluxo-cartao-mensal";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+
+const COLUNAS="id,external_ref,intake_context_id,intake_snapshot,intake_source,contractor_type,buyer_email,buyer_profile_id,business_id,legal_name,status,unit_count,total_cents,payment_method,billing_period,provider_card_flow,provider_customer_id,provider_charge_id,provider_first_due_date,provider_subscription_id,subscription_creation_started_at,provider_subscription_first_due_date";
+const RECIBO="order_id,first_due_date,provider_subscription_id,reserved_at,bound_at";
+const objeto=(v:unknown):Record<string,unknown>|null=>v&&typeof v==="object"&&!Array.isArray(v)?v as Record<string,unknown>:null;
+const hoje=()=>new Intl.DateTimeFormat("sv-SE",{timeZone:"America/Sao_Paulo"}).format(new Date());
+
+export async function schemaRecorrenciaNominalPronto(admin:SupabaseClient,env:Record<string,string|undefined>=process.env) {
+  if(!recorrenciaContextoAtiva(env))return false;
+  if(!await schemaComercialOficialPronto(admin,env))return false;
+  try {const r=await admin.rpc("recorrencia_nominal_schema_v1");return !r.error&&r.data===VERSAO_RECORRENCIA_NOMINAL;}catch{return false;}
+}
+
+/** Usa o token devolvido na cobrança canônica apenas em memória. A reserva é
+ * persistida antes do POST. Recuperação ambígua consulta a assinatura; não cria outra. */
+export async function processarAssinaturaNominalV1(admin:SupabaseClient,orderId:string,transport:TransporteCheckoutContexto,
+  env:Record<string,string|undefined>=process.env) {
+  if(!await schemaRecorrenciaNominalPronto(admin,env))return false;
+  try {
+    const row=await admin.from("commercial_orders").select(COLUNAS).eq("id",orderId).maybeSingle();
+    const order=row.data as (PedidoFinanceiroContexto&PedidoParaAssinatura3ds&PedidoRecorrente)|null;
+    if(row.error||!order||!ehPedidoContexto(order.external_ref)||order.billing_period!=="monthly"||order.payment_method!=="asaas_card")return false;
+    const receipt=await admin.from("commercial_nominal_subscriptions_v1").select(RECIBO).eq("order_id",orderId).maybeSingle();
+    if(receipt.error||(order.subscription_creation_started_at&&!receipt.data))return false;
+    if(order.provider_subscription_id) return !!receipt.data&&receipt.data.provider_subscription_id===order.provider_subscription_id
+      &&receipt.data.first_due_date===order.provider_subscription_first_due_date&&!!receipt.data.bound_at;
+    const list=async(path:string)=>{const r=await transport(path),b=objeto(r.body);return r.ok&&b?.hasMore===false
+      &&Array.isArray(b.data)&&b.data.every(objeto)?b.data as Record<string,unknown>[]:null;};
+    return await garantirAssinaturaApos3ds(order,{
+      lerCobranca:async id=>{const r=await transport(`/payments/${encodeURIComponent(id)}`);return r.ok?objeto(r.body):null;},
+      lerIpPagador:async()=>{const r=await admin.from("checkout_3ds_context").select("payer_ip,expires_at").eq("order_id",orderId).maybeSingle();
+        const ip=typeof r.data?.payer_ip==="string"?r.data.payer_ip.replace(/\/\d+$/,""):"";
+        return !r.error&&r.data&&isIP(ip)&&new Date(r.data.expires_at).getTime()>Date.now()?ip:null;},
+      buscarAssinaturas:async id=>list(`/subscriptions?externalReference=${encodeURIComponent(id)}&limit=100`),
+      lerParcelas:async id=>list(`/subscriptions/${encodeURIComponent(id)}/payments?limit=100`),
+      semOcorrencias:async()=>await consultarDireitoFinanceiroNominal(admin,order)==="payment_approved",
+      reservar:async due=>{const r=await admin.rpc("reservar_assinatura_nominal_v1",{p_order:orderId,p_due:due});return !r.error&&r.data===true;},
+      criar:async body=>{const r=await transport("/subscriptions",{method:"POST",body,timeoutMs:65000});
+        const created=r.ok?objeto(r.body):null;if(!created||typeof created.id!=="string"||!/^sub_[A-Za-z0-9]+$/.test(created.id))return null;
+        const canonical=await transport(`/subscriptions/${encodeURIComponent(created.id)}`);return canonical.ok?objeto(canonical.body):null;},
+      salvar:async(id,due)=>{const canonical=await transport(`/subscriptions/${encodeURIComponent(id)}`);
+        const s=objeto(canonical.body);
+        if(!canonical.ok||!s||!assinaturaNominalConfere({...order,provider_subscription_id:id},
+          {order_id:orderId,first_due_date:due,provider_subscription_id:id,reserved_at:"reserved",bound_at:"binding"},s)||s.status!=="ACTIVE"||s.deleted===true)return false;
+        if(s.nextDueDate!==due) {
+          if(s.nextDueDate!==vencimentoNoMesSeguinte(due))return false;
+          const installments=await list(`/subscriptions/${encodeURIComponent(id)}/payments?limit=100`),p=installments?.[0];
+          if(!installments||installments.length!==1||!p||typeof p.id!=="string"||!/^pay_[A-Za-z0-9]+$/.test(p.id)
+            ||p.subscription!==id||p.customer!==order.provider_customer_id||p.externalReference!==orderId||p.billingType!=="CREDIT_CARD"
+            ||p.value!==order.total_cents/100||p.dueDate!==due||p.deleted===true||!["PENDING","CONFIRMED","RECEIVED"].includes(String(p.status)))return false;
+        }
+        const r=await admin.rpc("vincular_assinatura_nominal_v1",{p_order:orderId,p_subscription:id,p_due:due});return !r.error&&r.data===true;},
+    },hoje());
+  }catch{return false;}
+}
+
+/** Renovações têm ledger próprio; não substituem a cobrança inicial nem criam
+ * unidades, negócios, perfis ou vínculos. O webhook é só uma pista para releitura. */
+export async function processarRenovacaoNominalV1(admin:SupabaseClient,orderId:string,event:EventoFinanceiro,transport:TransporteCheckoutContexto,
+  env:Record<string,string|undefined>=process.env) {
+  if(!await schemaRecorrenciaNominalPronto(admin,env))return {status:503,body:{erro:"recorrencia_contexto_fechada"}};
+  try {
+    const read=await admin.from("commercial_orders").select(COLUNAS).eq("id",orderId).maybeSingle();
+    const order=read.data as (PedidoFinanceiroContexto&PedidoRecorrente)|null;
+    const r=await admin.from("commercial_nominal_subscriptions_v1").select(RECIBO).eq("order_id",orderId).maybeSingle();
+    if(read.error||!order||!ehPedidoContexto(order.external_ref)||r.error||!r.data)return {status:503,body:{erro:"vinculo_pendente"}};
+    const receipt=r.data as ReciboAssinaturaNominal;
+    if(!event.assinaturaId||event.assinaturaId!==receipt.provider_subscription_id)return {status:422,body:{erro:"assinatura_divergente"}};
+    const [payment,subscription]=await Promise.all([transport(`/payments/${encodeURIComponent(event.cobrancaId)}`),transport(`/subscriptions/${encodeURIComponent(event.assinaturaId)}`)]);
+    if(!payment.ok||!subscription.ok)return {status:503,body:{erro:"confirmacao_pendente"}};
+    if(!assinaturaNominalConfere(order,receipt,subscription.body))return {status:422,body:{erro:"assinatura_divergente"}};
+    if(!renovacaoNominalConfere(order,receipt,event,payment.body)) {
+      const previous=await admin.from("commercial_nominal_renewal_events_v1").select("provider_event_id",{count:"exact",head:true})
+        .eq("provider_event_id",event.eventoId).eq("order_id",orderId).eq("provider_charge_id",event.cobrancaId)
+        .eq("provider_subscription_id",event.assinaturaId).eq("event_type",event.tipo).eq("amount_cents",event.valorCentavos).eq("due_date",event.vencimento);
+      if(replayEstornadoJaRegistrado(orderId,event,payment.body,!previous.error&&previous.count===1))return {status:200,body:{ok:true,historico:true}};
+      return {status:422,body:{erro:"renovacao_divergente"}};
+    }
+    const saved=await admin.rpc("registrar_renovacao_nominal_v1",{p_order:orderId,p_event:event.eventoId,p_type:event.tipo,
+      p_customer:event.clienteId,p_subscription:event.assinaturaId,p_charge:event.cobrancaId,p_amount:event.valorCentavos,p_due:event.vencimento});
+    if(saved.error)return {status:503,body:{erro:"gravacao_pendente"}};
+    if(saved.data!==true)return {status:422,body:{erro:"evento_divergente"}};
+    if(!["PAYMENT_CONFIRMED","PAYMENT_RECEIVED"].includes(event.tipo))return {status:200,body:{ok:true,access:"unchanged_scope"}};
+    const state=await admin.rpc("estado_renovacao_nominal_v1",{p_order:orderId,p_charge:event.cobrancaId});
+    if(state.error)return {status:503,body:{erro:"conferencia_pendente",paymentRecorded:true}};
+    if(state.data!=="payment_approved")return {status:200,body:{ok:true,access:"unchanged_scope"}};
+    const rows=await admin.from("commercial_order_units").select("id,intake_context_id,intake_unit_id,advertiser_name,advertiser_business_id,ad_account_id,ordinal")
+      .eq("order_id",orderId).order("ordinal").limit(101);
+    if(rows.error||!conferirUnidadesFinanceiras(order,rows.data as UnidadeFinanceiraContexto[]))return {status:503,body:{erro:"unidades_pendentes",paymentRecorded:true}};
+    const messages=prepararMensagensRenovacaoContexto(order,rows.data as UnidadeFinanceiraContexto[],event.cobrancaId,event.vencimento,env);
+    if(messages?.buyer||messages?.internal) {
+      const queued=await admin.rpc("preparar_efeitos_renovacao_nominal_v1",{p_order:orderId,p_charge:event.cobrancaId,p_buyer:messages.buyer,p_internal:messages.internal});
+      if(queued.error||queued.data!==true)return {status:503,body:{erro:"preparacao_pendente",paymentRecorded:true}};
+      if((env.V2G_COMMERCIAL_BUYER_PREPARE_ENABLED==="true"&&!messages.buyer)
+        ||(env.V2G_COMMERCIAL_INTERNAL_NOTICE_ENABLED==="true"&&!messages.internal))return {status:503,body:{erro:"configuracao_entrega_pendente",paymentRecorded:true}};
+      if(env.V2G_COMMERCIAL_EMAIL_DISPATCH_V1_ENABLED==="true") {
+        const delivery=await import("./processar-entrega-contexto-v1");
+        const result=await delivery.processarEntregaContextoV1(admin,orderId,delivery.enviarEntregaContexto,env,event.cobrancaId);
+        if(result.state==="pending")return {status:503,body:{erro:"entrega_pendente",paymentRecorded:true}};
+      }
+    }else if(env.V2G_COMMERCIAL_BUYER_PREPARE_ENABLED==="true"||env.V2G_COMMERCIAL_INTERNAL_NOTICE_ENABLED==="true")return {status:503,body:{erro:"configuracao_entrega_pendente",paymentRecorded:true}};
+    return {status:200,body:{ok:true,access:"unchanged_scope"}};
+  }catch{return {status:503,body:{erro:"confirmacao_pendente"}};}
+}
