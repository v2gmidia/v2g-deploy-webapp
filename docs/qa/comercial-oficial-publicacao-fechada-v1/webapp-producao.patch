+      </fieldset>
+      <fieldset disabled={pending||finished} className={styles.group}>
+        <legend>Quem acompanha a contratação?</legend>
+        <label>Nome completo<input name="nome" defaultValue={initial?.nome ?? ""} autoComplete="name" maxLength={120} required/></label>
+        <label>E-mail para acessar a conta<input name="email" type="email" defaultValue={emailDoAcesso ?? initial?.email ?? ""} readOnly={retomada||!!emailDoAcesso} autoComplete="email" required/></label>
+        <label>WhatsApp com DDD<input name="whatsapp" type="tel" defaultValue={initial?.whatsapp ?? ""} autoComplete="tel" required/></label>
+        {retomada && <p className={styles.help}>Para mudar o e-mail do pré-cadastro, peça à equipe uma nova conferência do destinatário.</p>}
+      </fieldset>
+      <fieldset disabled={pending||finished} className={styles.group}>
+        <legend>{kind==="agency" ? "Anunciantes atendidos pela agência" : "Negócio que será atendido"}</legend>
+        <label>Contas de anúncios<input name="contas" type="number" value={effectiveCount} readOnly={kind!=="agency"} min={1} max={100} step={1} onChange={e=>quantidade(Number(e.target.value))} required/></label>
