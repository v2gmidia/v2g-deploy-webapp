@@ -0,0 +1,47 @@
+import { financeiroContextoAtivo } from "./financeiro-contexto-v1.ts";
+import {identidadeComercialOficial,ORIGEM_COMERCIAL_OFICIAL} from "./ambiente-comercial-oficial-v1.ts";
+
+export type PayloadEntregaContexto={from:string;to:string[];subject:string;text:string};
+export type ItemEntregaContexto={id:string;status:string;payload:unknown};
+export type ResultadoEntregaContexto="disabled"|"suppressed"|"accepted"|"review"|"reserved_elsewhere";
+export function entregaContextoAtiva(env:Record<string,string|undefined>=process.env) {
+  if(identidadeComercialOficial(env))return financeiroContextoAtivo(env)&&env.V2G_COMMERCIAL_EMAIL_DISPATCH_V1_ENABLED==="true"
+    &&env.V2G_PRODUCTION_PAYMENT_EMAIL_ENABLED==="true";
+  return financeiroContextoAtivo(env)&&env.V2G_COMMERCIAL_EMAIL_DISPATCH_V1_ENABLED==="true"
+    &&env.V2G_PAYMENT_EMAIL_ENABLED==="true"&&env.V2G_PAYMENT_EMAIL_QA_TO==="victor.cabral@v2gmidia.com.br";
+}
+export function payloadEntregaConfere(value:unknown,expected:PayloadEntregaContexto,env:Record<string,string|undefined>=process.env):value is PayloadEntregaContexto {
+  if(!value||typeof value!=="object"||Array.isArray(value))return false;
+  const v=value as Record<string,unknown>;
+  if(identidadeComercialOficial(env))return Object.keys(v).length===4&&v.from===expected.from&&v.subject===expected.subject&&v.text===expected.text
+    &&expected.from===`V2G <${env.V2G_PRODUCTION_PAYMENT_EMAIL_FROM}>`&&/^V2G <[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+>$/.test(expected.from)
+    &&typeof v.subject==="string"&&v.subject.startsWith("V2G | ")&&typeof v.text==="string"&&!v.text.includes("[TESTE QA")
+    &&v.text.includes(ORIGEM_COMERCIAL_OFICIAL+"/")&&!v.text.includes("v2g-webapp-qa.vercel.app")
+    &&Array.isArray(v.to)&&v.to.length===1&&expected.to.length===1&&v.to[0]===expected.to[0]
+    &&typeof v.to[0]==="string"&&/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(v.to[0]);
+  return Object.keys(v).length===4&&v.from===expected.from&&v.subject===expected.subject&&v.text===expected.text
+    &&typeof v.text==="string"&&v.text.startsWith("[TESTE QA")
+    &&Array.isArray(v.to)&&v.to.length===1&&v.to[0]==="victor.cabral@v2gmidia.com.br"
+    &&expected.to.length===1&&expected.to[0]===v.to[0]&&/^V2G <[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+>$/.test(expected.from);
+}
+/** Outbox durável, com reserva condicional. Resultado ambíguo não reenvia.
+ * Nenhum estado aqui equivale a entrega na caixa: accepted é só aceite do provedor.
+ */
+export async function entregarMensagemContexto(kind:"buyer"|"internal",item:ItemEntregaContexto,expected:PayloadEntregaContexto,
+  ports:{canSend:()=>Promise<boolean>;reserve:()=>Promise<boolean>;send:(payload:PayloadEntregaContexto,key:string)=>Promise<string|null>;
+    record:(state:"accepted"|"review",providerId:string|null)=>Promise<boolean>},
+  env:Record<string,string|undefined>=process.env):Promise<ResultadoEntregaContexto> {
+  if(!entregaContextoAtiva(env))return "disabled";
+  if(!payloadEntregaConfere(item.payload,expected,env))return "review";
+  if(item.status==="accepted")return "accepted";
+  if(item.status!=="queued")return "review";
+  try {
+    if(!await ports.canSend())return "suppressed";
+    if(!await ports.reserve())return "reserved_elsewhere";
+    if(!await ports.canSend()){await ports.record("review",null);return "suppressed";}
+    let id:string|null=null;
+    try{id=await ports.send(item.payload,`commercial-${kind}/v1/${item.id}`);}catch{/* Incerto: conciliar. */}
+    if(!id){await ports.record("review",null);return "review";}
+    return await ports.record("accepted",id)?"accepted":"review";
+  }catch{return "review";}
+}
