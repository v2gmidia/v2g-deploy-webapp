+++ b/app/contratar/finalizar/actions.ts
@@ -0,0 +1,57 @@
+"use server";
+import {headers} from "next/headers";
+import {redirect} from "next/navigation";
+import {createAdminClient} from "@/lib/supabase/admin";
+import {origemComercialPermitida} from "@/lib/contratacao/ambiente-comercial-v1";
+import {checkoutContextoAtivo,type InstrumentoContexto} from "@/lib/contratacao/checkout-contexto-v1";
+import {lerCheckoutDoServidor,executarCheckoutDoServidor} from "@/lib/contratacao/checkout-contexto-v1-servidor";
+import {prepararPedidoFinanceiroAction} from "../financeiro-actions";
+import {validarDadosCartao} from "@/lib/contratacao/dados-cartao";
+import {lerDispositivo3ds} from "@/lib/contratacao/cartao-3ds";
+import {ipConfiavelDaVercel,segurancaCheckoutAtiva,verificarTurnstile,hashDeSeguranca} from "@/lib/seguranca/checkout";
+
+export type FinalizarContextoState={erro?:string;mensagem?:string};
+export async function prepararCheckoutAction(_previous:FinalizarContextoState,form:FormData):Promise<FinalizarContextoState>{
+  if(!checkoutContextoAtivo()||!origemComercialPermitida(await headers()))return {erro:"A preparação está indisponível."};
+  if([...form.keys()].some(k=>!k.startsWith("$ACTION_")))return {erro:"Retome a contratação confirmada."};
+  const loaded=await lerCheckoutDoServidor();if(!loaded)return {erro:"Não foi possível conferir esta contratação."};
+  const input=new FormData();input.set("reference",loaded.context.id);
+  const result=await prepararPedidoFinanceiroAction({},input);
+  if(result.erro)return {erro:result.erro};
+  redirect("/contratar/finalizar");
+}
+
+export async function pagarContextoAction(_previous:FinalizarContextoState,form:FormData):Promise<FinalizarContextoState>{
+  const h=await headers();
+  if(!checkoutContextoAtivo()||!origemComercialPermitida(h)||h.get("x-forwarded-proto")!=="https"||!segurancaCheckoutAtiva())
+    return {erro:"O pagamento está indisponível neste ambiente."};
+  const allowed=new Set(["confirmarPagamento","cf-turnstile-response","holderName","holderDocument","cardNumber","expiryMonth","expiryYear","ccv","postalCode","addressNumber","deviceInfo"]);
+  for(const key of form.keys())if(!key.startsWith("$ACTION_")&&(!allowed.has(key)||form.getAll(key).length!==1||typeof form.get(key)!=="string"))
+    return {erro:"Confira os dados deste pagamento."};
+  if(form.get("confirmarPagamento")!=="yes")return {erro:"Confira o pedido antes de pagar."};
+  const loaded=await lerCheckoutDoServidor();if(!loaded?.order)return {erro:"Retome a contratação confirmada antes de pagar."};
+  // Não iniciar cobrança avulsa para uma oferta mensal ainda sem recorrência nominal.
+  if(loaded.order.billing_period==="monthly") {
+    const {schemaRecorrenciaNominalPronto}=await import("@/lib/contratacao/processar-recorrencia-contexto-v1");
+    if(!await schemaRecorrenciaNominalPronto(createAdminClient()))return {erro:"O pagamento mensal está em preparação. Nenhuma cobrança foi iniciada."};
+  }
+  const ip=ipConfiavelDaVercel(h),token=form.get("cf-turnstile-response");
+  if(!ip||typeof token!=="string"||!await verificarTurnstile(token,ip))return {erro:"Atualize a verificação de segurança."};
+  const ipHash=hashDeSeguranca(ip),contact=hashDeSeguranca(loaded.order.buyer_email);
+  if(!ipHash||!contact)return {erro:"Não foi possível conferir a segurança."};
+  const limit=await createAdminClient().rpc("consumir_limite_checkout",{p_scope:"payment",p_ip_hash:ipHash,p_contact_hash:contact});
+  if(limit.error||limit.data!==true)return {erro:"Aguarde antes de tentar novamente ou fale com a V2G."};
+  let instrument:InstrumentoContexto={kind:"pix"};
+  if(loaded.order.payment_method==="asaas_card"){
+    const card=validarDadosCartao(form);if(!card.dados)return {erro:card.erro};
+    const raw=form.get("deviceInfo"),deviceInfo=typeof raw==="string"?lerDispositivo3ds(raw,ip,h.get("user-agent")??""):null;
+    if(!deviceInfo)return {erro:"Não foi possível conferir o dispositivo para autenticar o cartão."};
+    const d=card.dados;
+    instrument={kind:"card",deviceInfo,card:{creditCard:{holderName:d.holderName,number:d.cardNumber,expiryMonth:d.expiryMonth,expiryYear:d.expiryYear,ccv:d.ccv},
+      creditCardHolderInfo:{name:d.holderName,email:loaded.order.buyer_email,cpfCnpj:d.holderDocument,postalCode:d.postalCode,addressNumber:d.addressNumber,mobilePhone:loaded.order.buyer_whatsapp},remoteIp:ip}};
+  }
+  const result=await executarCheckoutDoServidor(loaded,instrument);
+  if(result.state==="created"){if(result.challengeUrl)redirect(result.challengeUrl);redirect("/contratar/finalizar");}
+  if(result.state==="pending_reconciliation")return {erro:"O resultado precisa de conferência. Não pague novamente; acompanhe esta mesma contratação."};
+  return {erro:"Não foi possível iniciar este pagamento. Nenhuma nova tentativa foi enviada."};
+}
