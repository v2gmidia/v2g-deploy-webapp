@@ -0,0 +1,15 @@
+import type {PedidoFinanceiroContexto,UnidadeFinanceiraContexto} from "./financeiro-contexto-v1.ts";
+import {prepararMensagensContexto} from "./mensagens-contexto-v1.ts";
+import {dataRecorrenteValida} from "./recorrencia-contexto-v1.ts";
+import {identidadeComercialOficial} from "./ambiente-comercial-oficial-v1.ts";
+
+export function prepararMensagensRenovacaoContexto(order:PedidoFinanceiroContexto,units:UnidadeFinanceiraContexto[],charge:string,due:string,
+  env:Record<string,string|undefined>) {
+  if(!/^pay_[A-Za-z0-9]+$/.test(charge)||charge===order.provider_charge_id||!dataRecorrenteValida(due))return null;
+  const initial=prepararMensagensContexto({...order,provider_charge_id:charge},units,"payment_approved",env);
+  if(!initial)return null;
+  const prefix=identidadeComercialOficial(env)?"":"[TESTE QA] ";
+  const line=`${prefix}Renovação mensal confirmada. Vencimento: ${due}. As unidades e seus destinos são os mesmos desta contratação.`;
+  return {buyer:initial.buyer?{...initial.buyer,subject:`${prefix}V2G | Renovação mensal confirmada`,text:line+"\n"+initial.buyer.text}:null,
+    internal:initial.internal?{...initial.internal,subject:`${prefix}V2G | Renovação mensal — acompanhamento interno`,text:line+"\n"+initial.internal.text}:null};
+}
