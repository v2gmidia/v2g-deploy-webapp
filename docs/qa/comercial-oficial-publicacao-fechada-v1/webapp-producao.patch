+import "server-only";
+import {coberturaNominalAtiva,sujeitoNominalVerificado,validarAtribuicaoNominal,
+  type CoberturaNominalPersistida} from "./cobertura-nominal-v1.ts";
+import {UUID_COMERCIAL,type SujeitoComercial} from "./comercial-v1.ts";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+
+type PortaNominal={rpc(name:string,args:Record<string,unknown>):PromiseLike<{data:unknown;error:unknown}>};
+export type ResultadoAtribuicaoNominal={ok:true;coverage:CoberturaNominalPersistida}|{ok:false;erro:string};
+/** Só recebe identidade de getUser no servidor. Não consulta nem cria pagamento. */
+export async function atribuirCoberturaNominal(admin:PortaNominal,raw:unknown,sujeito:SujeitoComercial|null,
+  env:Record<string,string|undefined>=process.env):Promise<ResultadoAtribuicaoNominal> {
+  if(!coberturaNominalAtiva(env))return {ok:false,erro:"A atribuição está indisponível."};
+  const binding=validarAtribuicaoNominal(raw);
+  if(!binding||!sujeitoNominalVerificado(sujeito))return {ok:false,erro:"Entre com o e-mail confirmado da compra e confira os destinos."};
+  try {
+    if(!await schemaComercialOficialPronto(admin,env))return {ok:false,erro:"A atribuição está em preparação. Nenhum destino foi alterado."};
+    const {data,error}=await admin.rpc("atribuir_cobertura_nominal_v1",{p_binding:binding,p_actor:sujeito.id,
+      p_email:sujeito.email.trim().toLowerCase()});
+    // Um resultado parcial/inesperado nunca vira confirmação de acesso.
+    const c=data as CoberturaNominalPersistida|null;
+    if(error||!c||c.order_id!==binding.orderId||c.context_id!==binding.contextId||c.unit_id!==binding.unitId
+      ||c.intake_unit_id!==binding.intakeUnitId||c.owner_profile_id!==sujeito.id
+      ||c.buyer_email!==sujeito.email.trim().toLowerCase()
+      ||typeof c.contractor_business_id!=="string"||!UUID_COMERCIAL.test(c.contractor_business_id)
+      ||typeof c.advertiser_business_id!=="string"||!UUID_COMERCIAL.test(c.advertiser_business_id)
+      ||(c.ad_account_id!==null&&(typeof c.ad_account_id!=="string"||!UUID_COMERCIAL.test(c.ad_account_id)))
+      ||typeof c.created_at!=="string"||!validarAtribuicaoNominal(c.selection)
+      ||(c.ad_account_id===null)!==(c.account_bound_at===null))
+      return {ok:false,erro:"Não foi possível conferir a atribuição. Preserve o pedido e tente novamente."};
+    return {ok:true,coverage:c};
+  }catch{return {ok:false,erro:"A conferência está indisponível. Nenhum novo pagamento foi iniciado."};}
+}
