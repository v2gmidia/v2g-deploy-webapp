@@ -0,0 +1,35 @@
+import { checkoutSandboxSeguro } from "./ambiente-checkout.ts";
+import {entradaComercialOficialAtiva,identidadeComercialOficial,origemComercialOficialPermitida} from "./ambiente-comercial-oficial-v1.ts";
+
+export function comercialV1Ativo(env: Record<string,string|undefined> = process.env) {
+  return entradaComercialOficialAtiva(env)||checkoutSandboxSeguro({nodeEnv:env.NODE_ENV,habilitado:env.V2G_COMMERCIAL_ENTRY_V1_ENABLED,
+    asaasAmbiente:env.ASAAS_ENVIRONMENT,supabaseUrl:env.NEXT_PUBLIC_SUPABASE_URL,
+    qaRef:env.V2G_CHECKOUT_SANDBOX_DB_REF,qaDeployEnabled:env.V2G_CHECKOUT_QA_DEPLOY_ENABLED,
+    vercelProjectId:env.VERCEL_PROJECT_ID,vercelProjectProductionUrl:env.VERCEL_PROJECT_PRODUCTION_URL,
+    siteUrl:env.NEXT_PUBLIC_SITE_URL});
+}
+
+export function origemComercialPermitida(headers: {get(name:string):string|null}, env: Record<string,string|undefined> = process.env) {
+  if(identidadeComercialOficial(env))return origemComercialOficialPermitida(headers,true,env);
+  if (!comercialV1Ativo(env)) return false;
+  const host = headers.get("host"), origin = headers.get("origin");
+  if (!origin || !host) return false;
+  try {
+    const u = new URL(origin);
+    if (u.origin !== origin || u.host !== host) return false;
+    return env.NODE_ENV === "production" ? origin === "https://v2g-webapp-qa.vercel.app"
+      : (u.protocol === "http:" && ["localhost","127.0.0.1"].includes(u.hostname))
+        || origin === "https://v2g-webapp-qa.vercel.app";
+  } catch { return false; }
+}
+
+export function hostComercialPermitido(headers:{get(name:string):string|null},env:Record<string,string|undefined>=process.env) {
+  // A retomada recebe POST da LP, cuja Origin é conferida na própria rota.
+  // Este helper valida somente o destino; não substitui a conferência de Origin.
+  if(identidadeComercialOficial(env))return headers.get("host")==="app.v2gmidia.com.br"&&headers.get("x-forwarded-proto")==="https";
+  if(!comercialV1Ativo(env))return false;
+  const host=headers.get("host");
+  if(host==="v2g-webapp-qa.vercel.app")return true;
+  if(env.NODE_ENV==="production" || !host)return false;
+  try {const url=new URL(`http://${host}`);return url.host===host && ["localhost","127.0.0.1"].includes(url.hostname);}catch{return false;}
+}
