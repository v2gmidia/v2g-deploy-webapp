+    --navy-rgb: 236 245 242;
+    --cobalt-ink: #9FBFFF;
+    --ice-soft: #1A3046;
+    --line: #354A60;
+    --control-line: #6D859A;
+    --task-surface: #182D42;
+    --good: #A6D8B5;
