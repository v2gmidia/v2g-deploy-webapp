+import {randomUUID} from "node:crypto";
+import {cookies} from "next/headers";
+import {createClient} from "@/lib/supabase/server";
+import {Marca} from "@/components/ui/Marca";
+import {contextoComercialDoServidor} from "@/lib/contratacao/comercial-v1-servidor";
+import {lerCookieComercial} from "@/lib/contratacao/contexto-comercial-v1";
+import {validarLeadComercial,dadosComerciaisPersistidos,completarUnidadesParaTela} from "@/lib/contratacao/comercial-v1";
+import {ComercialFormulario} from "./ComercialFormulario";
+import {iniciarOutroContextoComercial} from "./comercial-actions";
+import {checkoutContextoAtivo} from "@/lib/contratacao/checkout-contexto-v1";
+
+export async function ComercialEntrada() {
+  const {data:{user}}=await (await createClient()).auth.getUser();
+  const cookie=lerCookieComercial((await cookies()).get("v2g_commercial_context")?.value);
+  const context=cookie ? await contextoComercialDoServidor(cookie.reference,user,cookie.secret) : null;
+  const original=context?.confirmed_data ?? context?.original_data;
+  const initial=completarUnidadesParaTela(validarLeadComercial(original) ? original : dadosComerciaisPersistidos(original),randomUUID);
+  const reference=context?.id ?? cookie?.reference ?? randomUUID();
+  return <main className="contratar-shell">
+    <header className="contratar-topo"><Marca href="/entrar" editorial/><a href="/entrar">Já tenho acesso</a></header>
+    <div className="contratar-grid"><section className="contratar-intro">
+      <h1>Uma contratação. Os anunciantes certos.</h1>
+      <p>Contrate para seu negócio ou para os clientes da sua agência. Comece pelos dados de quem contrata e de cada anunciante que será atendido.</p>
+      <p className="contratar-limite">Uma conta de acesso pode acompanhar vários anunciantes. Cada unidade precisa de sua própria contratação e das confirmações para começar.</p>
+      {cookie&&!context && <p className="form-warning">Não foi possível retomar os dados anteriores. Entre com o e-mail do pré-cadastro ou peça à equipe uma nova retomada. Nenhum dado anterior foi exibido.</p>}
+      <details><summary>Já deixou seus dados com a equipe?</summary><p>Informe a referência usando a conta com o e-mail confirmado do pré-cadastro.</p><form method="post" action="/api/comercial/retomar"><label>Referência<input name="reference" required autoComplete="off"/></label><button type="submit">Retomar dados</button></form></details>
+      {cookie && <form action={iniciarOutroContextoComercial}><button type="submit">Iniciar outra contratação</button><p>O registro anterior será preservado.</p></form>}
+    </section><ComercialFormulario key={reference} reference={reference} unitId={randomUUID()} initial={initial} retomada={!!context} saved={!!context?.confirmed_data} emailDoAcesso={user?.email ?? undefined} checkoutDisponivel={checkoutContextoAtivo()}/></div>
+  </main>;
+}
