+import {comercialV1Ativo} from "./ambiente-comercial-v1.ts";
+import {identidadeComercialOficial,coberturaComercialOficialAtiva} from "./ambiente-comercial-oficial-v1.ts";
+import {UUID_COMERCIAL,type SujeitoComercial} from "./comercial-v1.ts";
+
+export const SCHEMA_COBERTURA_NOMINAL="v2g.cobertura.nominal.v1" as const;
+export const COLUNAS_COBERTURA_NOMINAL="order_id,context_id,unit_id,intake_unit_id,owner_profile_id,buyer_email,contractor_business_id,advertiser_business_id,ad_account_id,selection,created_at,account_bound_at";
+export function coberturaNominalAtiva(env:Record<string,string|undefined>=process.env) {
+  if(identidadeComercialOficial(env))return coberturaComercialOficialAtiva(env);
+  return env.V2G_NOMINAL_COVERAGE_V1_ENABLED==="true" && comercialV1Ativo(env)
+    && env.V2G_CHECKOUT_SANDBOX_DB_REF==="zskpijnqgkqwxksqmzmf"
+    && env.NEXT_PUBLIC_SUPABASE_URL==="https://zskpijnqgkqwxksqmzmf.supabase.co";
+}
+export type SelecaoContratante={mode:"existing";businessId:string}|{mode:"new";name:string};
+export type SelecaoAnunciante=SelecaoContratante|{mode:"unit";unitId:string}|{mode:"contractor"};
+export type AtribuicaoNominal={schemaVersion:typeof SCHEMA_COBERTURA_NOMINAL;orderId:string;contextId:string;
+  unitId:string;intakeUnitId:string;contractor:SelecaoContratante;advertiser:SelecaoAnunciante;adAccountId:string|null;confirmSelection:true};
+export type CoberturaNominalPersistida={order_id:string;context_id:string;unit_id:string;intake_unit_id:string;
+  owner_profile_id:string;buyer_email:string;contractor_business_id:string;advertiser_business_id:string;
+  ad_account_id:string|null;selection:AtribuicaoNominal;created_at:string;account_bound_at:string|null};
+export type LeituraCoberturasNominais={state:"off"|"unavailable"|"ok";coverages:CoberturaNominalPersistida[]};
+
+const object=(v:unknown):v is Record<string,unknown>=>!!v&&typeof v==="object"&&!Array.isArray(v);
+const exact=(v:Record<string,unknown>,keys:readonly string[])=>Object.keys(v).length===keys.length&&Object.keys(v).every(k=>keys.includes(k));
+function selection(value:unknown,advertiser:boolean):SelecaoAnunciante|null {
+  if(!object(value))return null;
+  if(value.mode==="existing"&&exact(value,["mode","businessId"])&&typeof value.businessId==="string"&&UUID_COMERCIAL.test(value.businessId))
+    return {mode:"existing",businessId:value.businessId.toLowerCase()};
+  if(value.mode==="new"&&exact(value,["mode","name"])&&typeof value.name==="string"&&value.name.trim().length>=2&&value.name.length<=200&&!/[\x00-\x1f\x7f]/.test(value.name))
+    return {mode:"new",name:value.name.trim()};
+  if(advertiser&&value.mode==="unit"&&exact(value,["mode","unitId"])&&typeof value.unitId==="string"&&UUID_COMERCIAL.test(value.unitId))
+    return {mode:"unit",unitId:value.unitId.toLowerCase()};
+  if(advertiser&&value.mode==="contractor"&&exact(value,["mode"]))return {mode:"contractor"};
+  return null;
+}
+export function validarAtribuicaoNominal(raw:unknown):AtribuicaoNominal|null {
+  if(!object(raw)||!exact(raw,["schemaVersion","orderId","contextId","unitId","intakeUnitId","contractor","advertiser","adAccountId","confirmSelection"])
+    ||raw.schemaVersion!==SCHEMA_COBERTURA_NOMINAL||raw.confirmSelection!==true)return null;
+  for(const k of ["orderId","contextId","unitId","intakeUnitId"])
+    if(typeof raw[k]!=="string"||!UUID_COMERCIAL.test(raw[k]))return null;
+  const contractor=selection(raw.contractor,false),advertiser=selection(raw.advertiser,true);
+  if(!contractor||contractor.mode==="unit"||contractor.mode==="contractor"||!advertiser)return null;
+  if(raw.adAccountId!==null&&(typeof raw.adAccountId!=="string"||!UUID_COMERCIAL.test(raw.adAccountId)))return null;
+  return {schemaVersion:SCHEMA_COBERTURA_NOMINAL,orderId:String(raw.orderId).toLowerCase(),contextId:String(raw.contextId).toLowerCase(),
+    unitId:String(raw.unitId).toLowerCase(),intakeUnitId:String(raw.intakeUnitId).toLowerCase(),contractor,advertiser,
+    adAccountId:raw.adAccountId===null?null:String(raw.adAccountId).toLowerCase(),confirmSelection:true};
+}
+export function sujeitoNominalVerificado(s:SujeitoComercial|null):s is SujeitoComercial&{email:string;email_confirmed_at:string} {
+  return !!s&&UUID_COMERCIAL.test(s.id)&&!!s.email_confirmed_at&&typeof s.email==="string"
+    &&/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(s.email)&&!/[\x00-\x1f\x7f]/.test(s.email);
+}
