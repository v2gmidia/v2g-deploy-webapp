+import {comercialV1Ativo} from "./ambiente-comercial-v1.ts";
+import {identidadeComercialOficial,financeiroComercialOficialAtivo} from "./ambiente-comercial-oficial-v1.ts";
+import {UUID_COMERCIAL,FONTE_COMERCIAL_LP,dadosComerciaisPersistidos} from "./comercial-v1.ts";
+import {confirmacaoCanonicaConfere} from "./confirmacao-canonica.ts";
+import type {EventoFinanceiro} from "./evento-financeiro.ts";
+
+export const PREFIXO_PEDIDO_CONTEXTO="commercial-v1:";
+export function financeiroContextoAtivo(env:Record<string,string|undefined>=process.env) {
+  if(identidadeComercialOficial(env))return financeiroComercialOficialAtivo(env);
+  return env.V2G_COMMERCIAL_FINANCIAL_V1_ENABLED==="true" && comercialV1Ativo(env);
+}
+export function ehPedidoContexto(reference:unknown):reference is string {
+  return typeof reference==="string" && reference.startsWith(PREFIXO_PEDIDO_CONTEXTO)
+    && UUID_COMERCIAL.test(reference.slice(PREFIXO_PEDIDO_CONTEXTO.length));
+}
+export type PedidoFinanceiroContexto={
+  id:string;external_ref:string;intake_context_id:string;intake_source:unknown;intake_snapshot:unknown;contractor_type:"direct"|"agency";
+  buyer_email:string;buyer_profile_id:string|null;business_id:string|null;legal_name:string;status:string;unit_count:number;
+  total_cents:number;payment_method:string;provider_customer_id:string|null;provider_charge_id:string|null;provider_first_due_date:string|null;
+  billing_period?:string;provider_subscription_id?:string|null;
+};
+export type UnidadeFinanceiraContexto={id:string;intake_context_id:string;intake_unit_id:string;advertiser_name:string;advertiser_business_id:string|null;ad_account_id:string|null;ordinal:number};
+function snapshotFinanceiroValido(order:PedidoFinanceiroContexto) {
+  const snapshot=dadosComerciaisPersistidos(order.intake_snapshot);
+  const source=origemFinanceiraContexto(order.intake_source);
+  return ehPedidoContexto(order.external_ref) && UUID_COMERCIAL.test(order.id)
+    && order.intake_context_id===order.external_ref.slice(PREFIXO_PEDIDO_CONTEXTO.length)
+    && source && snapshot && snapshot.referencia===order.intake_context_id && snapshot.contas===order.unit_count
+    && snapshot.totalCentavos===order.total_cents && snapshot.email===order.buyer_email && snapshot.contractorType===order.contractor_type
+    && snapshot.metodo===order.payment_method && snapshot.razaoSocial===order.legal_name ? snapshot : undefined;
+}
+function unidadeFinanceiraValida(order:PedidoFinanceiroContexto,u:UnidadeFinanceiraContexto) {
+  const snapshot=snapshotFinanceiroValido(order);
+  return !!snapshot && !!u && u.intake_context_id===order.intake_context_id && UUID_COMERCIAL.test(u.id) && UUID_COMERCIAL.test(u.intake_unit_id)
+    && Number.isInteger(u.ordinal) && u.ordinal>=1 && u.ordinal<=snapshot.contas
+    && snapshot.units[u.ordinal-1]?.id===u.intake_unit_id && snapshot.units[u.ordinal-1]?.advertiserName===u.advertiser_name
+    && (u.advertiser_business_id===null || UUID_COMERCIAL.test(u.advertiser_business_id))
+    && (u.ad_account_id===null || UUID_COMERCIAL.test(u.ad_account_id));
+}
+export function conferirUnidadesFinanceiras(order:PedidoFinanceiroContexto,units:UnidadeFinanceiraContexto[]) {
+  if(!snapshotFinanceiroValido(order) || !Array.isArray(units) || units.length!==order.unit_count || units.length<1 || units.length>100
+    || (order.contractor_type==="direct" && units.length!==1))return false;
+  const ids=new Set<string>(),ordinals=new Set<number>();
+  for(const u of units) {
+    if(!unidadeFinanceiraValida(order,u) || ids.has(u.intake_unit_id) || ordinals.has(u.ordinal))return false;
+    ids.add(u.intake_unit_id);ordinals.add(u.ordinal);
+  }
+  return true;
+}
+export function origemFinanceiraContexto(value:unknown):string|null {
+  if(!value || typeof value!=="object" || Array.isArray(value))return null;
+  const s=value as Record<string,unknown>;
+  if(s.kind==="compra_direta")return "compra_direta";
+  if(s.kind==="lead_lp" && s.sourceSystem===FONTE_COMERCIAL_LP && typeof s.leadId==="string" && /^[1-9][0-9]{0,18}$/.test(s.leadId))
+    return `${s.sourceSystem} · registro ${s.leadId}`;
+  return null;
+}
+/** Só verifica identidade canônica da cobrança inicial. Não cria/cobra/assina. */
+export function cobrancaCanonicaDoContexto(order:PedidoFinanceiroContexto,chargeId:string,raw:unknown) {
+  if(!snapshotFinanceiroValido(order) || !/^pay_[A-Za-z0-9]+$/.test(chargeId)
+    || !order.provider_customer_id || !order.provider_first_due_date
+    || (order.provider_charge_id!==null && order.provider_charge_id!==chargeId)
+    || !raw || typeof raw!=="object" || Array.isArray(raw))return false;
+  const p=raw as Record<string,unknown>;
+  return p.id===chargeId && p.customer===order.provider_customer_id && p.externalReference===order.id && !p.deleted
+    && (p.subscription??null)===null && p.dueDate===order.provider_first_due_date
+    && p.billingType===(order.payment_method==="asaas_pix" ? "PIX" : "CREDIT_CARD")
+    && typeof p.value==="number" && Number.isFinite(p.value) && Math.abs(p.value*100-order.total_cents)<0.00001;
+}
+export function canonicoDoPedidoContexto(order:PedidoFinanceiroContexto,event:EventoFinanceiro,raw:unknown) {
+  if(!raw || typeof raw!=="object" || Array.isArray(raw))return false;
+  const p=raw as Record<string,unknown>;
+  if(event.assinaturaId!==null || event.cobrancaId!==order.provider_charge_id || event.clienteId!==order.provider_customer_id
+    || event.valorCentavos!==order.total_cents || event.vencimento!==order.provider_first_due_date
+    || (order.payment_method==="asaas_pix" ? event.forma!=="PIX" : order.payment_method!=="asaas_card" || event.forma!=="CREDIT_CARD"))return false;
+  if(!cobrancaCanonicaDoContexto(order,event.cobrancaId,p))return false;
+  return !["PAYMENT_CONFIRMED","PAYMENT_RECEIVED"].includes(event.tipo) || confirmacaoCanonicaConfere(order.id,event,raw);
+}
+
+export type VinculoCobertura={
+  profileId:string;email:string;emailConfirmed:boolean;
+  contractor:{id:string;ownerProfileId:string};advertiser:{id:string;ownerProfileId:string};
+  relation:{agencyBusinessId:string;advertiserBusinessId:string;ownerProfileId:string;revoked:boolean}|null;
+  adAccount:{id:string;businessId:string}|null;
+};
+/** Plano de acesso, não grant. Um contrato pago não amplia toda a carteira. */
+export function prepararCoberturaNominal(order:PedidoFinanceiroContexto,unit:UnidadeFinanceiraContexto,
+  financialState:string,binding:VinculoCobertura|null,usedAccountIds:readonly string[]=[]) {
+  const blocked=(reason:string)=>({eligible:false as const,reason,grantCreated:false as const});
+  if(financialState!=="payment_approved" || order.status!=="payment_approved")return blocked("payment_not_eligible");
+  if(!unidadeFinanceiraValida(order,unit))return blocked("nominal_unit_mismatch");
+  if(!binding)return blocked("scope_binding_required");
+  if(![binding.profileId,binding.contractor.id,binding.advertiser.id].every(id=>UUID_COMERCIAL.test(id)))return blocked("identity_or_scope_mismatch");
+  if(!binding.emailConfirmed || binding.email.trim().toLowerCase()!==order.buyer_email
+    || (order.buyer_profile_id!==null && order.buyer_profile_id!==binding.profileId)
+    || binding.contractor.ownerProfileId!==binding.profileId || binding.advertiser.ownerProfileId!==binding.profileId
+    || order.business_id!==binding.contractor.id || unit.advertiser_business_id!==binding.advertiser.id)return blocked("identity_or_scope_mismatch");
+  if(order.contractor_type==="agency") {
+    const r=binding.relation;
+    if(!r||r.revoked||r.agencyBusinessId!==binding.contractor.id||r.advertiserBusinessId!==binding.advertiser.id||r.ownerProfileId!==binding.profileId)
+      return blocked("agency_relation_required");
+  } else if(binding.contractor.id!==binding.advertiser.id)return blocked("direct_scope_mismatch");
+  if(binding.adAccount && (!UUID_COMERCIAL.test(binding.adAccount.id)||binding.adAccount.businessId!==binding.advertiser.id || unit.ad_account_id!==binding.adAccount.id
+    || usedAccountIds.includes(binding.adAccount.id)))return blocked("account_scope_or_duplicate");
+  if(unit.ad_account_id!==null && !binding.adAccount)return blocked("account_not_verified");
+  return {eligible:true as const,reason:"prepared_only",grantCreated:false as const,profileId:binding.profileId,
+    contractorBusinessId:binding.contractor.id,advertiserBusinessId:binding.advertiser.id,unitId:unit.id,
+    metaConnected:false as const,campaignPublished:false as const};
+}
