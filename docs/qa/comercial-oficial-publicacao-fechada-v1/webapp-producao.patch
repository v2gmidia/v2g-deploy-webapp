@@ -0,0 +1,23 @@
+"use server";
+import {headers} from "next/headers";
+import {createClient} from "@/lib/supabase/server";
+import {createAdminClient} from "@/lib/supabase/admin";
+import {origemComercialPermitida} from "@/lib/contratacao/ambiente-comercial-v1";
+import {coberturaNominalAtiva} from "@/lib/contratacao/cobertura-nominal-v1";
+import {atribuirCoberturaNominal} from "@/lib/contratacao/atribuir-cobertura-v1";
+
+type State={ok?:boolean;erro?:string;unitId?:string};
+export async function atribuirCoberturaNominalAction(_previous:State,form:FormData):Promise<State> {
+  if(!coberturaNominalAtiva()||!origemComercialPermitida(await headers()))return {erro:"A atribuição está indisponível."};
+  if(form.getAll("binding").length!==1||[...form.keys()].some(k=>k!=="binding"&&!k.startsWith("$ACTION_")))
+    return {erro:"Confira a unidade e os destinos selecionados."};
+  const raw=form.get("binding");
+  if(typeof raw!=="string"||raw.length>4096)return {erro:"Confira a unidade e os destinos selecionados."};
+  try {
+    const binding:unknown=JSON.parse(raw);
+    const {data:{user},error}=await (await createClient()).auth.getUser();
+    if(error||!user)return {erro:"Entre com o e-mail confirmado da compra."};
+    const r=await atribuirCoberturaNominal(createAdminClient(),binding,user);
+    return r.ok?{ok:true,unitId:r.coverage.unit_id}:{erro:r.erro};
+  }catch{return {erro:"Não foi possível conferir a atribuição agora."};}
+}
