+import { lerDocumentoContratante } from "./documento-contratante.ts";
+
+export type DadosCartao = {
+  holderName: string;
+  holderDocument: string;
+  cardNumber: string;
+  expiryMonth: string;
+  expiryYear: string;
+  ccv: string;
+  postalCode: string;
+  addressNumber: string;
