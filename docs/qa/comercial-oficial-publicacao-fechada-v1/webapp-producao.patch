@@ -0,0 +1,127 @@
+import { validarCompra, type DadosDaCompra } from "./qualificacao.ts";
+
+export const SCHEMA_COMERCIAL = "v2g.comercial.v1" as const;
+export const FONTE_COMERCIAL_LP = "v2g_site.commercial_leads.v1" as const;
+export const UUID_COMERCIAL = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+export type UnidadeComercial = { id: string; advertiserName: string };
+export type DadosComerciais = DadosDaCompra & {
+  schemaVersion: typeof SCHEMA_COMERCIAL;
+  contractorType: "direct" | "agency";
+  vendeWhatsApp: "sim";
+  units: UnidadeComercial[];
+};
+export type OrigemComercial = { kind: "compra_direta" } | {
+  kind: "lead_lp"; sourceSystem:typeof FONTE_COMERCIAL_LP; leadId: string; attribution: Record<string,string|null>;
+  consent: { at: string; text: string };
+};
+
+export type LeadComercial = {
+  schemaVersion: "v2g.comercial.lead.v1"; reference: string;
+  nome: string; email: string; whatsapp: string; razaoSocial: string; cnpj?: string;
+  contractorType?: "direct" | "agency"; contas?: number; units?: UnidadeComercial[];
+};
+/** Interesse não escolhe plano, pagamento ou qualificação de venda pelo anunciante. */
+export function validarLeadComercial(v: unknown): v is LeadComercial {
+  if (!objeto(v) || v.schemaVersion !== "v2g.comercial.lead.v1" || typeof v.reference !== "string"
+      || !UUID_COMERCIAL.test(v.reference) || Object.keys(v).some(k=>!["schemaVersion","reference","nome","email","whatsapp","razaoSocial","cnpj","contractorType","contas","units"].includes(k))) return false;
+  for (const [key,max] of [["nome",120],["email",254],["whatsapp",30],["razaoSocial",200]] as const)
+    if (typeof v[key] !== "string" || !v[key].trim() || v[key].length > max || /[\x00-\x1f]/.test(v[key])) return false;
+  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v.email)) || !/^\d{10,13}$/.test(String(v.whatsapp).replace(/\D/g,""))) return false;
+  if (v.cnpj !== undefined && (typeof v.cnpj !== "string" || v.cnpj.length>18 || /[\x00-\x1f]/.test(v.cnpj))) return false;
+  if (v.contractorType !== undefined && v.contractorType !== "direct" && v.contractorType !== "agency") return false;
+  if (v.contas !== undefined && (!Number.isSafeInteger(v.contas) || Number(v.contas)<1 || Number(v.contas)>100)) return false;
+  if (v.contractorType === "direct" && v.contas !== undefined && v.contas !== 1) return false;
+  if (v.units !== undefined) {
+    if (!Array.isArray(v.units) || v.units.length>100 || (v.contas !== undefined && v.units.length!==v.contas)) return false;
+    const ids = new Set<string>();
+    for (const u of v.units) {
+      if (!objeto(u) || Object.keys(u).some(k=>!["id","advertiserName"].includes(k))
+          || typeof u.id!=="string" || !UUID_COMERCIAL.test(u.id) || ids.has(u.id.toLowerCase())
+          || typeof u.advertiserName!=="string" || u.advertiserName.trim().length<2 || u.advertiserName.length>200 || /[\x00-\x1f]/.test(u.advertiserName)) return false;
+      ids.add(u.id.toLowerCase());
+    }
+    if (v.contractorType === "direct" && v.units.length>1) return false;
+  }
+  return true;
+}
+
+function objeto(v: unknown): v is Record<string, unknown> {
+  return !!v && typeof v === "object" && !Array.isArray(v);
+}
+/** Contrato novo, sem alterar os campos ou a qualificação do checkout legado. */
+export function validarComercial(v: unknown): { dados: DadosComerciais; erro?: never } | { erro: string; dados?: never } {
+  if (!objeto(v) || v.schemaVersion !== SCHEMA_COMERCIAL || !UUID_COMERCIAL.test(String(v.reference ?? v.referencia ?? "")))
+    return { erro: "Atualize a contratação e confirme os dados novamente." };
+  const permitidos = new Set(["schemaVersion","reference","referencia","contractorType","nome","email","whatsapp","razaoSocial","cnpj","contas","periodo","metodo","vendeWhatsApp","units"]);
+  if (Object.keys(v).some(k => !permitidos.has(k))) return {erro:"A contratação contém campos não reconhecidos."};
+  for (const [key,max] of [["nome",120],["email",254],["whatsapp",30],["razaoSocial",200],["cnpj",18],
+    ["periodo",30],["metodo",20],["vendeWhatsApp",3]] as const) {
+    if(typeof v[key]!=="string" || v[key].length>max || /[\x00-\x1f\x7f]/.test(v[key]))
+      return {erro:"Confira os campos de texto da contratação."};
+  }
+  const ref=v.reference ?? v.referencia;
+  if(typeof ref!=="string" || !UUID_COMERCIAL.test(ref)
+      || (typeof v.contas!=="string" && typeof v.contas!=="number")
+      || !/^[1-9][0-9]{0,2}$/.test(String(v.contas)))return {erro:"Confira a referência e a quantidade de contas."};
+  if (v.reference !== undefined && v.referencia !== undefined && v.reference !== v.referencia)
+    return {erro:"A referência da contratação é divergente."};
+  if (v.contractorType !== "direct" && v.contractorType !== "agency") return {erro:"Escolha Cliente direto ou Agência."};
+  if(!/^[0-9()+ .-]+$/.test(String(v.whatsapp)))return {erro:"Informe um WhatsApp com DDD válido."};
+  const form = new FormData();
+  for (const k of ["nome","email","whatsapp","razaoSocial","cnpj","contas","periodo","metodo","vendeWhatsApp"])
+    form.set(k,String(v[k] ?? ""));
+  form.set("referencia",String(v.reference ?? v.referencia));
+  const compra = validarCompra(form);
+  if (!compra.dados) return {erro:compra.erro ?? "Confira os dados."};
+  if (v.contractorType === "direct" && compra.dados.contas !== 1)
+    return {erro:"Cliente direto contrata uma conta nesta oferta. Para atender vários anunciantes, escolha Agência."};
+  if (!Array.isArray(v.units) || v.units.length !== compra.dados.contas) return {erro:"Informe um anunciante para cada conta contratada."};
+  const units: UnidadeComercial[] = [];
+  const ids = new Set<string>();
+  for (const u of v.units) {
+    if (!objeto(u) || Object.keys(u).some(k => k !== "id" && k !== "advertiserName")
+        || typeof u.id !== "string" || !UUID_COMERCIAL.test(u.id) || ids.has(u.id.toLowerCase())
+        || typeof u.advertiserName !== "string" || u.advertiserName.trim().length < 2
+        || u.advertiserName.trim().length > 200 || /[\x00-\x1f]/.test(u.advertiserName))
+      return {erro:"Confira os nomes e identificadores das unidades. Não informe contas ou acessos de terceiros."};
+    ids.add(u.id.toLowerCase()); units.push({id:u.id.toLowerCase(),advertiserName:u.advertiserName.trim()});
+  }
+  return {dados:{...compra.dados,referencia:compra.dados.referencia.toLowerCase(),schemaVersion:SCHEMA_COMERCIAL,contractorType:v.contractorType,vendeWhatsApp:"sim",units}};
+}
+
+export function lerFormularioComercial(form: FormData):ReturnType<typeof validarComercial> {
+  let units: unknown;
+  try { units = JSON.parse(String(form.get("units") ?? "")); } catch { return {erro:"Confira as unidades da contratação."}; }
+  const data: Record<string,unknown> = {schemaVersion:form.get("schemaVersion"),reference:form.get("referencia"),units};
+  for (const k of ["contractorType","nome","email","whatsapp","razaoSocial","cnpj","contas","periodo","metodo","vendeWhatsApp"]) data[k] = form.get(k);
+  if (form.get("confirmarDados") !== "yes") return {erro:"Confira os dados e confirme antes de salvar."};
+  // Um campo escondido não é prova de origem nem de lead.
+  for (const k of ["sourceLeadId","source_lead_id","source_system","origin","origem","business_id","profile_id"])
+    if (form.has(k)) return {erro:"A origem precisa ser conferida pelo servidor. Retome o contexto original."};
+  return validarComercial(data);
+}
+
+export type SujeitoComercial = {id:string;email?:string|null;email_confirmed_at?:string|null};
+export function podeRetomarComercial(sujeito: SujeitoComercial | null, email: string): boolean {
+  return !!sujeito && UUID_COMERCIAL.test(sujeito.id) && !!sujeito.email_confirmed_at
+    && typeof sujeito.email === "string" && sujeito.email.trim().toLowerCase() === email;
+}
+
+/** Projeta somente campos conhecidos de um snapshot canônico, sem confiar em preço persistido. */
+export function dadosComerciaisPersistidos(v:unknown) {
+  if(!objeto(v))return undefined;
+  const input:Record<string,unknown>={};
+  for(const key of ["schemaVersion","referencia","contractorType","nome","email","whatsapp","razaoSocial","cnpj","contas","periodo","metodo","vendeWhatsApp","units"])
+    input[key]=v[key];
+  if(v.schemaVersion!==SCHEMA_COMERCIAL)return undefined;
+  return validarComercial(input).dados;
+}
+
+/** Placeholders de tela não alteram o snapshot nem atribuem identidade ao anunciante. */
+export function completarUnidadesParaTela(initial:LeadComercial|DadosComerciais|undefined,criarId:()=>string) {
+  if(!initial)return undefined;
+  const n=initial.contas ?? initial.units?.length ?? 1;
+  return {...initial,units:Array.from({length:Math.max(1,n)},(_,index)=>initial.units?.[index] ?? {
+    id:criarId(),advertiserName:index===0 && initial.contractorType==="direct" ? initial.razaoSocial : "",
+  })};
+}
