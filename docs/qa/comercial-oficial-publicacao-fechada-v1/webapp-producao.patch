+import type { NegocioAcessivel } from "./escolha";
+import type { PedidoComPagamento } from "../contratacao/direito-por-pedido";
+import type { AcessoPilotoQa } from "../piloto-qa/acesso";
+
+export type NegocioDoPerfil = NegocioAcessivel & { created_at: string };
+export type PedidoDoNegocio = PedidoComPagamento & {
+  external_ref: string;
+  business_id: string | null;
+  status: string;
+  buyer_email: string | null;
+  buyer_profile_id: string | null;
+  direitoFinanceiro?: boolean;
+};
+export type CoberturaNominalDoNegocio = {
+  contractor_business_id: string;
+  advertiser_business_id: string;
+};
+
+/** A propriedade da linha não basta: cada negócio comprado precisa estar liberado. */
+export function negociosLiberados(entrada: {
+  negocios: NegocioDoPerfil[];
+  pedidos: PedidoDoNegocio[];
+  perfilId: string;
+  emailVerificado: string | null;
+  legadoEm: string | null;
+  operador: boolean;
+  acessosContratados?: { business_id: string; accepted_by: string | null; recipient_email: string;
+    accepted_at: string | null; revoked_at: string | null }[];
+  acessosPilotoQa?: AcessoPilotoQa[];
+  coberturasNominais?: CoberturaNominalDoNegocio[];
+  agora?: number;
+}): NegocioAcessivel[] {
+  const { negocios, pedidos, perfilId, emailVerificado, legadoEm, operador } = entrada;
+  const agora = entrada.agora ?? Date.now();
+  const marcoLegado = legadoEm ? Date.parse(legadoEm) : NaN;
+  const email = emailVerificado?.trim().toLowerCase() ?? null;
+  const pedidosPorNegocio = new Map<string, PedidoDoNegocio[]>();
+  for (const pedido of pedidos) {
+    if (!pedido.business_id) continue;
+    const grupo = pedidosPorNegocio.get(pedido.business_id) ?? [];
+    grupo.push(pedido);
+    pedidosPorNegocio.set(pedido.business_id, grupo);
+  }
+  const tinhaNegocioNoMarco = Number.isFinite(marcoLegado) && negocios.some((negocio) =>
+    Number.isFinite(Date.parse(negocio.created_at)) && Date.parse(negocio.created_at) <= marcoLegado);
+  const primeiroSemPedido = negocios
+    .filter((negocio) => Number.isFinite(Date.parse(negocio.created_at))
+      && Date.parse(negocio.created_at) > marcoLegado
+      && !pedidosPorNegocio.has(negocio.id))
+    .sort((a, b) => Date.parse(a.created_at) - Date.parse(b.created_at))[0]?.id;
+
+  return negocios.filter((negocio) => {
+    if (operador) return true;
+    // Um pedido real, até pendente ou estornado, encerra este atalho de QA.
+    if (email && !pedidosPorNegocio.has(negocio.id)
+      && entrada.acessosPilotoQa?.some(g => g.business_id === negocio.id
+      && g.profile_id === perfilId && g.revoked_at === null
+      && Number.isFinite(Date.parse(g.expires_at)) && Date.parse(g.expires_at) > agora)) return true;
+    if (email && entrada.acessosContratados?.some(g => g.business_id === negocio.id
+      && g.accepted_by === perfilId && g.recipient_email === email && g.accepted_at && !g.revoked_at)) return true;
+    if (email && entrada.coberturasNominais?.some(c =>
+      c.contractor_business_id === negocio.id || c.advertiser_business_id === negocio.id)) return true;
+    const pedidosDoNegocio = pedidosPorNegocio.get(negocio.id) ?? [];
+    const aprovado = pedidosDoNegocio.some((pedido) => pedido.status === "payment_approved" && pedido.direitoFinanceiro === true
+      && !!email && pedido.buyer_email?.trim().toLowerCase() === email
+      && (pedido.buyer_profile_id === perfilId || pedido.buyer_profile_id === null));
+    if (aprovado && email) return true;
+
+    if (!Number.isFinite(marcoLegado)) return false;
+    const criadoEm = Date.parse(negocio.created_at);
+    if (!Number.isFinite(criadoEm)) return false;
+    // Linhas anteriores à trava continuam alcançáveis, inclusive quando há
+    // uma nova compra ainda pendente para o mesmo negócio.
+    if (criadoEm <= marcoLegado) return true;
+    // Um legado sem negócio pode terminar seu primeiro cadastro. Negócios
+    // nascidos de pedidos posteriores só entram depois da aprovação.
+    return !tinhaNegocioNoMarco && pedidos.length === 0 && pedidosDoNegocio.length === 0
+      && negocio.id === primeiroSemPedido;
+  }).map(({ id, name }) => ({ id, name }));
+}
