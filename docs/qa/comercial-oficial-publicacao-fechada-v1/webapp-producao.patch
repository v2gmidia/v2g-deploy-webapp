+    const [buyerRead,internalRead]=queueCharges.length?await Promise.all([
+      admin.from("commercial_payment_email_outbox").select("order_id,provider_charge_id,status").in("order_id",ids).in("provider_charge_id",queueCharges).limit(11),
+      admin.from("commercial_internal_notice_outbox").select("order_id,provider_charge_id,status").eq("notice_type","payment_confirmed")
+        .in("order_id",ids).in("provider_charge_id",queueCharges).limit(11),
+    ]):[{data:[],error:null},{data:[],error:null}];
+    const queue=(r:typeof buyerRead)=>!r.error&&Array.isArray(r.data)&&r.data.length<=orders.length?r.data as Queue[]:null;
+    const buyer=queue(buyerRead),internal=queue(internalRead),items:PedidoNominalOperacao[]=[];
+    // No máximo quatro consultas de ciclo simultâneas; demais fontes são bateladas.
+    for(let start=0;start<orders.length;start+=4){const batch=await Promise.all(orders.slice(start,start+4).map(async o=>{
+      const us=units?group(units,o.id):null,coherent=!!us&&conferirUnidadesFinanceiras(o,us);
