@@ -0,0 +1,59 @@
+"use server";
+
+import {randomBytes} from "node:crypto";
+import {cookies,headers} from "next/headers";
+import {redirect} from "next/navigation";
+import {createClient} from "@/lib/supabase/server";
+import {createAdminClient} from "@/lib/supabase/admin";
+import {origemComercialPermitida,comercialV1Ativo} from "@/lib/contratacao/ambiente-comercial-v1";
+import {schemaComercialOficialPronto} from "@/lib/contratacao/schema-comercial-oficial-v1";
+import {lerFormularioComercial} from "@/lib/contratacao/comercial-v1";
+import {hashComercial,lerCookieComercial} from "@/lib/contratacao/contexto-comercial-v1";
+import {contextoComercialDoServidor} from "@/lib/contratacao/comercial-v1-servidor";
+
+export type ContextoState={erro?:string;mensagem?:string;reference?:string};
+export async function salvarContextoComercial(_previous:ContextoState,form:FormData):Promise<ContextoState> {
+  if(!comercialV1Ativo()||!origemComercialPermitida(await headers()))return {erro:"Esta contratação está indisponível neste endereço."};
+  const parsed=lerFormularioComercial(form);
+  if(!parsed.dados)return {erro:parsed.erro};
+  const data=parsed.dados;
+  try {
+    const {data:{user}}=await (await createClient()).auth.getUser();
+    if(user?.email && user.email.trim().toLowerCase()!==data.email)return {erro:"Use o e-mail deste acesso ou saia da conta antes de continuar."};
+    const jar=await cookies();
+    const resume=lerCookieComercial(jar.get("v2g_commercial_context")?.value);
+    const admin=createAdminClient();
+    if(!await schemaComercialOficialPronto(admin))return {erro:"Esta contratação está em preparação. Nenhum pagamento foi iniciado."};
+    let sessionSecret:string|undefined;
+    if(resume) {
+      if(resume.reference!==data.referencia)return {erro:"Retome a contratação original antes de continuar."};
+      const context=await contextoComercialDoServidor(resume.reference,user,resume.secret);
+      if(!context || context.recipient_email!==data.email)return {erro:"Não foi possível conferir esta retomada. Entre com o e-mail do cadastro ou inicie uma contratação sem reaproveitar dados."};
+      sessionSecret=resume.secret==="auth" ? undefined : resume.secret;
+    } else {
+      // A compra direta não exige conta; este segredo protege somente seu rascunho.
+      const previous=jar.get("v2g_commercial_browser")?.value;
+      sessionSecret=previous && /^[a-f0-9]{64}$/.test(previous) ? previous : randomBytes(32).toString("hex");
+      jar.set("v2g_commercial_browser",sessionSecret,{httpOnly:true,secure:process.env.NODE_ENV==="production",sameSite:"lax",path:"/",maxAge:1800});
+      // Antes da escrita: timeout/refresh deve conservar a referência, inclusive
+      // quando o registro ocorreu mas a confirmação da resposta se perdeu.
+      jar.set("v2g_commercial_context",`${data.referencia}.${sessionSecret}`,{httpOnly:true,secure:process.env.NODE_ENV==="production",sameSite:"lax",path:"/",maxAge:1800});
+      const created=await admin.rpc("criar_contexto_comercial_v1",{p_id:data.referencia,p_original:data,
+        p_source:{kind:"compra_direta"},p_session_hash:hashComercial(sessionSecret)});
+      if(created.error || created.data!==data.referencia)return {erro:"Não foi possível salvar. Preserve esta referência e procure a equipe antes de enviar outra contratação."};
+    }
+    const confirmed=await admin.rpc("confirmar_contexto_comercial_v1",{p_id:data.referencia,p_final:data,
+      p_session_hash:sessionSecret ? hashComercial(sessionSecret) : null,
+      p_actor:user?.email_confirmed_at ? user.id : null,p_verified_email:user?.email_confirmed_at ? user.email?.trim().toLowerCase() : null});
+    if(confirmed.error || confirmed.data!==data.referencia)return {erro:"Não foi possível confirmar. Confira a mesma contratação antes de tentar novamente; nenhum pagamento foi iniciado."};
+    return {reference:data.referencia,mensagem:"Dados confirmados. A equipe pode conferir a contratação. Nenhum pagamento foi iniciado e nenhum acesso foi liberado."};
+  } catch {return {erro:"Não foi possível conferir o registro agora. Seus dados continuam no formulário; tente novamente na mesma contratação."};}
+}
+
+export async function iniciarOutroContextoComercial() {
+  if(!comercialV1Ativo()||!origemComercialPermitida(await headers()))return;
+  const jar=await cookies();
+  jar.delete("v2g_commercial_context");
+  jar.delete("v2g_commercial_browser");
+  redirect("/contratar");
+}
