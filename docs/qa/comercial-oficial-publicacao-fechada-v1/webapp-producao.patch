+        </select></label>
+        {total!==null && <p className="contratar-resumo"><strong>{new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL"}).format(total/100)}</strong><span>{period==="monthly" ? "por mês" : "à vista"} · {effectiveCount} {effectiveCount===1 ? "conta" : "contas"}</span></p>}
+        <p className={styles.help}>Verba de anúncios à parte. Acesso e primeira campanha dependem das confirmações de pagamento e dos preparativos de cada etapa.</p>
+      </fieldset>
+      <label className={styles.confirm}><input name="confirmarDados" type="checkbox" value="yes" checked={checked} onChange={e=>{e.stopPropagation();setChecked(e.target.checked);}} required disabled={pending||finished}/><span>Conferi o contratante, o contato, os anunciantes e as condições acima.</span></label>
+      <button type="submit" disabled={pending||finished||!checked}>{pending ? "Salvando dados…" : "Confirmar dados da contratação"}</button>
+      <p className={styles.help}>Esta confirmação salva os dados para conferência. Não inicia cobrança nem libera acesso.</p>
+    </form>
+  </section>;
+}
