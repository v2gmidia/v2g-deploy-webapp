@@ -0,0 +1,49 @@
+import { notFound, redirect } from "next/navigation";
+import { createClient } from "@/lib/supabase/server";
+import { createAdminClient } from "@/lib/supabase/admin";
+import { coberturaNominalAtiva } from "@/lib/contratacao/cobertura-nominal-v1";
+import { prepararCoberturaNominalDoTitular } from "@/lib/contratacao/preparar-cobertura-nominal-v1";
+import { temAcessoWebApp } from "@/lib/contratacao/acesso";
+import { FormularioCobertura } from "./FormularioCobertura";
+import styles from "./preparar-acesso.module.css";
+
+export const dynamic = "force-dynamic";
+
+export default async function PrepararAcessoPage() {
+  if (!coberturaNominalAtiva()) notFound();
+  const supabase = await createClient();
+  const { data: { user }, error } = await supabase.auth.getUser();
+  if (error || !user) redirect("/entrar?next=/preparar-acesso");
+  if (!user.email || !user.email_confirmed_at) redirect("/acesso-pendente");
+  const preparacao = await prepararCoberturaNominalDoTitular(createAdminClient(), user);
+  if (preparacao.state === "off") notFound();
+  if (preparacao.state === "unavailable") return <main className={styles.pagina}>
+    <header className={styles.topo}><p className="eyebrow">PREPARAR ACESSO</p><h1>Não conseguimos conferir suas unidades agora.</h1>
+      <p>Nenhum destino foi alterado. Atualize a página ou fale com a equipe antes de iniciar outra contratação.</p></header>
+    <a className="cta" href="/preparar-acesso">Tentar novamente</a>
+  </main>;
+  if (!preparacao.orders.length) {
+    if (await temAcessoWebApp(supabase, user)) redirect("/inicio");
+    redirect("/acesso-pendente");
+  }
+  const todasAtribuidas = preparacao.orders.every(order => order.units.every(unit => unit.binding));
+  if (todasAtribuidas && await temAcessoWebApp(supabase, user)) redirect("/inicio");
+  const algumaAtribuida = preparacao.orders.some(order => order.units.some(unit => unit.binding));
+  const nomePorId = new Map(preparacao.businesses.map(b => [b.id, b.name]));
+
+  return <main className={styles.pagina}>
+    <header className={styles.topo}><p className="eyebrow">PREPARAR ACESSO</p><h1>Escolha o destino de cada unidade.</h1>
+      <p>O pagamento confirma a quantidade contratada. Aqui você escolhe, entre os cadastros da sua conta, qual negócio é o contratante e qual anunciante recebe cada unidade. Isso não conecta a conta de anúncios nem publica campanha.</p></header>
+    {preparacao.orders.map(order => <section className={styles.pedido} key={order.id}>
+      <header><div><h2>{order.contractorType === "agency" ? "Contratação da agência" : "Contratação direta"}</h2>
+        <p>{order.legalName} · {order.units.length} {order.units.length === 1 ? "unidade" : "unidades"}</p></div>
+        <span>{order.units.filter(u => u.binding).length} de {order.units.length} atribuídas</span></header>
+      {order.units.map(unit => unit.binding ? <article className={styles.concluida} key={unit.id}>
+        <b>Unidade {unit.ordinal} · {unit.advertiser_name}</b>
+        <p>Destino confirmado: {nomePorId.get(unit.binding.advertiser_business_id) ?? unit.binding.advertiser_business_id.slice(0, 8)}. {unit.binding.ad_account_id ? "Conta atribuída." : "Conta ainda não atribuída."}</p>
+      </article> : <FormularioCobertura key={unit.id} order={order} businesses={preparacao.businesses} unit={unit} />)}
+    </section>)}
+    <div className={styles.acoes}>{algumaAtribuida && <a className="cta" href="/inicio">Abrir unidades já preparadas</a>}
+      <a href="/acesso-pendente">Voltar à situação do acesso</a></div>
+  </main>;
+}
