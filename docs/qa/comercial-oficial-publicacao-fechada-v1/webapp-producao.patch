+import "server-only";
+
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { lerTodasPaginas, lerTodasPaginasEmLotes } from "../multiconta/paginacao";
+import {
+  COLUNAS_COBERTURA_NOMINAL,
+  coberturaNominalAtiva,
+  sujeitoNominalVerificado,
+  type CoberturaNominalPersistida,
+} from "./cobertura-nominal-v1";
+import { type SujeitoComercial } from "./comercial-v1";
+import {
+  conferirUnidadesFinanceiras,
+  ehPedidoContexto,
+  type PedidoFinanceiroContexto,
+  type UnidadeFinanceiraContexto,
+} from "./financeiro-contexto-v1";
+import { consultarDireitoFinanceiroNominal } from "./direito-financeiro-nominal-v1";
+import {schemaComercialOficialPronto} from "./schema-comercial-oficial-v1";
+
+export type NegocioSelecionavelNominal = { id: string; name: string };
+export type UnidadeParaAtribuicaoNominal = UnidadeFinanceiraContexto & {
+  binding: CoberturaNominalPersistida | null;
+};
+export type PedidoParaAtribuicaoNominal = {
+  id: string;
+  contextId: string;
+  contractorType: "direct" | "agency";
+  legalName: string;
+  contractorBusinessId: string | null;
+  units: UnidadeParaAtribuicaoNominal[];
+};
+export type PreparacaoCoberturaNominal = {
+  state: "off" | "unavailable" | "ok";
+  orders: PedidoParaAtribuicaoNominal[];
+  businesses: NegocioSelecionavelNominal[];
+};
+
+const COLUNAS_PEDIDO = "id,external_ref,intake_context_id,intake_source,intake_snapshot,contractor_type,buyer_email,buyer_profile_id,business_id,legal_name,status,unit_count,total_cents,payment_method,provider_customer_id,provider_charge_id,provider_first_due_date,billing_period,provider_subscription_id";
+const COLUNAS_UNIDADE = "id,intake_context_id,intake_unit_id,advertiser_name,advertiser_business_id,ad_account_id,ordinal,order_id";
+
+export async function prepararCoberturaNominalDoTitular(
+  admin: SupabaseClient,
+  sujeito: SujeitoComercial | null,
+): Promise<PreparacaoCoberturaNominal> {
+  const vazio = (state: PreparacaoCoberturaNominal["state"]): PreparacaoCoberturaNominal =>
+    ({ state, orders: [], businesses: [] });
+  if (!coberturaNominalAtiva()) return vazio("off");
+  if (!sujeitoNominalVerificado(sujeito)) return vazio("unavailable");
+  const email = sujeito.email.trim().toLowerCase();
+  try {
+    if(!await schemaComercialOficialPronto(admin))return vazio("unavailable");
+    const pedidosLidos = await lerTodasPaginas<PedidoFinanceiroContexto>((inicio, fim) => admin
+      .from("commercial_orders").select(COLUNAS_PEDIDO)
+      .eq("buyer_email", email).eq("status", "payment_approved")
+      .order("id", { ascending: true }).range(inicio, fim));
+    if (!pedidosLidos) return vazio("unavailable");
+    const candidatos = pedidosLidos.filter(p => ehPedidoContexto(p.external_ref)
+      && (p.buyer_profile_id === null || p.buyer_profile_id === sujeito.id));
+    if (!candidatos.length) return vazio("ok");
+    const orderIds = candidatos.map(p => p.id);
+    const [unidades, bindings, businesses] = await Promise.all([
+      lerTodasPaginasEmLotes<UnidadeFinanceiraContexto & { order_id: string }>(orderIds, (lote, inicio, fim) => admin
+        .from("commercial_order_units").select(COLUNAS_UNIDADE).in("order_id", lote)
+        .order("order_id", { ascending: true }).order("ordinal", { ascending: true }).range(inicio, fim)),
+      lerTodasPaginas<CoberturaNominalPersistida>((inicio, fim) => admin
+        .from("commercial_nominal_unit_bindings_v1").select(COLUNAS_COBERTURA_NOMINAL)
+        .eq("owner_profile_id", sujeito.id).eq("buyer_email", email)
+        .order("order_id", { ascending: true }).order("unit_id", { ascending: true }).range(inicio, fim)),
+      lerTodasPaginas<NegocioSelecionavelNominal>((inicio, fim) => admin.from("businesses")
+        .select("id,name").eq("profile_id", sujeito.id)
+        .order("created_at", { ascending: true }).order("id", { ascending: true }).range(inicio, fim)),
+    ]);
+    if (!unidades || !bindings || !businesses) return vazio("unavailable");
+    const bindingPorUnidade = new Map(bindings.map(b => [b.unit_id, b]));
+    if (bindingPorUnidade.size !== bindings.length) return vazio("unavailable");
+    const grupos = new Map<string, (UnidadeFinanceiraContexto & { order_id: string })[]>();
+    for (const unidade of unidades) {
+      const grupo = grupos.get(unidade.order_id) ?? [];
+      grupo.push(unidade);
+      grupos.set(unidade.order_id, grupo);
+    }
+    const orders: PedidoParaAtribuicaoNominal[] = [];
+    for (const pedido of candidatos) {
+      const units = grupos.get(pedido.id) ?? [];
+      if (!conferirUnidadesFinanceiras(pedido, units)) return vazio("unavailable");
+      if (await consultarDireitoFinanceiroNominal(admin, pedido) !== "payment_approved") continue;
+      const vinculadas = units.map(unit => ({ ...unit, binding: bindingPorUnidade.get(unit.id) ?? null }));
+      const contratos = new Set(vinculadas.flatMap(u => u.binding ? [u.binding.contractor_business_id] : []));
+      if (contratos.size > 1 || pedido.business_id && contratos.size === 1 && !contratos.has(pedido.business_id))
+        return vazio("unavailable");
+      orders.push({ id: pedido.id, contextId: pedido.intake_context_id,
+        contractorType: pedido.contractor_type, legalName: pedido.legal_name,
+        contractorBusinessId: pedido.business_id ?? (contratos.size ? [...contratos][0]! : null), units: vinculadas });
+    }
+    return { state: "ok", orders, businesses };
+  } catch {
+    return vazio("unavailable");
+  }
+}
