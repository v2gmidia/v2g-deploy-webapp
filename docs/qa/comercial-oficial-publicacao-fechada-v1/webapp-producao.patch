+import {notFound} from "next/navigation";
+import {headers} from "next/headers";
+import {Marca} from "@/components/ui/Marca";
+import {createAdminClient} from "@/lib/supabase/admin";
+import {hostComercialPermitido} from "@/lib/contratacao/ambiente-comercial-v1";
+import {checkoutContextoAtivo,consultaCheckoutContextoAtiva} from "@/lib/contratacao/checkout-contexto-v1";
+import {identidadeComercialOficial} from "@/lib/contratacao/ambiente-comercial-oficial-v1";
+import {lerCheckoutDoServidor,lerPixDoContexto} from "@/lib/contratacao/checkout-contexto-v1-servidor";
+import {consultarDireitoFinanceiroNominal} from "@/lib/contratacao/direito-financeiro-nominal-v1";
+import {consultarEstadoPagamento} from "@/lib/contratacao/consultar-estado-pagamento";
+import {schemaRecorrenciaNominalPronto} from "@/lib/contratacao/processar-recorrencia-contexto-v1";
+import {PagamentoFormulario} from "../pagamento/PagamentoFormulario";
+import {CopiarPix} from "../pagamento/CopiarPix";
+import {PrepararPedido} from "./PrepararPedido";
+import {pagarContextoAction} from "./actions";
+import "../contratar.css";
+export const dynamic="force-dynamic";
+export const metadata={title:"Conferir pagamento | V2G",robots:{index:false,follow:false}};
+
+export default async function FinalizarContextoPage(){
+  if(!consultaCheckoutContextoAtiva()||!hostComercialPermitido(await headers()))notFound();
+  const sandbox=!identidadeComercialOficial(),purchaseEnabled=checkoutContextoAtivo();
+  const loaded=await lerCheckoutDoServidor();if(!loaded)notFound();
+  const {order,snapshot}=loaded;
+  const state=order?await (order.status==="payment_approved"?consultarDireitoFinanceiroNominal(createAdminClient(),order):consultarEstadoPagamento(createAdminClient(),order)):"awaiting_payment";
+  const pix=order&&state==="awaiting_payment"?await lerPixDoContexto(order):null;
+  const started=!!(order?.checkout_creation_started_at||order?.payment_creation_started_at||order?.provider_charge_id);
+  const monthly=snapshot.periodo==="monthly";
+  const monthlyReady=monthly?await schemaRecorrenciaNominalPronto(createAdminClient()):false;
+  return <main className="contratar-shell">
+    <header className="contratar-topo"><Marca href="/contratar" editorial/><a href="/contratar">Conferir cadastro</a></header>
+    <div className="contratar-grid"><section className="contratar-intro">
+      {sandbox&&<p className="form-warning">Ambiente de teste QA. Compras públicas não foram liberadas.</p>}
+      <h1>{state==="payment_approved"?"Pagamento confirmado.":"Confira sua contratação."}</h1>
+      <h2>{snapshot.razaoSocial}</h2>
+      <p>{snapshot.contractorType==="agency"?"Contratação da agência":"Cliente direto"} · {snapshot.contas} {snapshot.contas===1?"conta":"contas"}</p>
+      <p className="contratar-resumo"><strong>{new Intl.NumberFormat("pt-BR",{style:"currency",currency:"BRL"}).format(snapshot.totalCentavos/100)}</strong><span>{monthly?"por mês":"à vista"}</span></p>
+      <ul>{snapshot.units.map(u=><li key={u.id}>{u.advertiserName}</li>)}</ul>
+      <p>Verba de anúncios à parte. O pagamento não publica campanha.</p>
+    </section><section className="contratar-formulario">
+      {state==="payment_approved"?<><h2>Prepare seu acesso.</h2><p>Use o e-mail desta compra. Confirme seu e-mail e escolha o destino de cada unidade.</p>
+        <a className="cta" href="/entrar?next=%2Fpreparar-acesso">Entrar ou criar meu acesso</a><p>Contrato e nota fiscal são acompanhados separadamente.</p></>
+      :state!=="awaiting_payment"?<p className="form-warning">O estado deste pagamento precisa de conferência. Nenhum novo pagamento foi iniciado. Fale com a V2G.</p>
+      :monthly&&!monthlyReady?<><h2>Pagamento mensal em preparação.</h2><p>Estamos concluindo a recorrência deste modelo. Seus dados estão preservados; nenhuma cobrança foi iniciada.</p></>
+      :started?<><h2>Acompanhe este pedido.</h2><p>A tentativa já foi registrada. A confirmação depende da conferência do pagamento; voltar da autenticação do banco não confirma a compra.</p>
+        {pix&&<><img src={`data:image/png;base64,${pix.image}`} alt={sandbox?"QR Code Pix deste pedido de teste":"QR Code Pix deste pedido"} width={240} height={240}/>
+          <label>Código Pix deste pedido<textarea readOnly value={pix.code}/></label><CopiarPix codigo={pix.code}/></>}
+        <a className="cta" href="/contratar/finalizar">Atualizar situação</a><p>Se a resposta estiver demorando, fale com a V2G antes de tentar outro pagamento.</p></>
+      :!purchaseEnabled?<p className="form-warning">Novos pagamentos estão indisponíveis. Seus dados foram preservados; acompanhe somente o pedido já iniciado.</p>
+      :!order?<PrepararPedido/>:<PagamentoFormulario referencia={snapshot.referencia} metodo={snapshot.metodo as "asaas_pix"|"asaas_card"}
+        contextoNominal acaoPagamento={pagarContextoAction} usa3ds={snapshot.metodo==="asaas_card"} sandbox={sandbox} turnstileSiteKey={process.env.TURNSTILE_SITE_KEY??""}/>}</section></div>
+  </main>;
+}
