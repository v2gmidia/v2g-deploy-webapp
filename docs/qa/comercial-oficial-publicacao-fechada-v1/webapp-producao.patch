+import {OCORRENCIAS_PUBLICAS,estadoPagamentoPublico,type EstadoPagamentoPublico} from "./estado-pagamento-publico.ts";
+export type PedidoInicialNominal={id:string;status:string;provider_charge_id:string|null;total_cents:number;provider_first_due_date:string|null};
+export type EventoInicialNominal={event_type:string;provider_charge_id:string;provider_subscription_id:string|null;amount_cents:number;due_date:string};
+const COMPATIVEIS=new Set(["PAYMENT_CREATED","PAYMENT_UPDATED","PAYMENT_AUTHORIZED","PAYMENT_AWAITING_RISK_ANALYSIS",
+  "PAYMENT_APPROVED_BY_RISK_ANALYSIS","PAYMENT_CONFIRMED","PAYMENT_RECEIVED","PAYMENT_OVERDUE"]);
+/** Mesma projeção financeira usada pelo acesso e pelo acompanhamento interno.
+ * Estado de cabeçalho não substitui recibo; consulta parcial não fica verde. */
+export function estadoInicialNominal(pedido:PedidoInicialNominal,eventos:EventoInicialNominal[],integra=true):EstadoPagamentoPublico {
+  if(pedido.status==="cancelled")return "cancelled";
+  if(pedido.status!=="payment_approved"||!pedido.provider_charge_id||!Number.isSafeInteger(pedido.total_cents)||pedido.total_cents<=0
+    ||typeof pedido.provider_first_due_date!=="string"||!/^\d{4}-\d{2}-\d{2}$/.test(pedido.provider_first_due_date))return "awaiting_payment";
+  if(!integra||!Array.isArray(eventos)||eventos.length>=100||eventos.some(e=>e.provider_charge_id!==pedido.provider_charge_id))return "verification_unavailable";
+  const negative=estadoPagamentoPublico(pedido.status,eventos.filter(e=>(OCORRENCIAS_PUBLICAS as readonly string[]).includes(e.event_type)),true);
+  if(negative!=="payment_approved")return negative;
+  if(eventos.some(e=>!COMPATIVEIS.has(e.event_type)||e.provider_subscription_id!==null||e.amount_cents!==pedido.total_cents||e.due_date!==pedido.provider_first_due_date))return "payment_review";
+  return eventos.some(e=>["PAYMENT_CONFIRMED","PAYMENT_RECEIVED"].includes(e.event_type))?"payment_approved":"awaiting_payment";
+}
