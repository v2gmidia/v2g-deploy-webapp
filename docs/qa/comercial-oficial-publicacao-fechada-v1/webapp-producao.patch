+++ b/lib/contratacao/recorrencia-contexto-v1.ts
@@ -0,0 +1,50 @@
+import {financeiroContextoAtivo} from "./financeiro-contexto-v1.ts";
+import {vencimentoNoMesSeguinte} from "./fluxo-cartao-mensal.ts";
+import type {EventoFinanceiro} from "./evento-financeiro.ts";
+import {confirmacaoCanonicaConfere} from "./confirmacao-canonica.ts";
+
+export const VERSAO_RECORRENCIA_NOMINAL="v2g.recorrencia.nominal.v1";
+export function recorrenciaContextoAtiva(env:Record<string,string|undefined>=process.env) {
+  return financeiroContextoAtivo(env)&&env.V2G_COMMERCIAL_RECURRING_V1_ENABLED==="true";
+}
+export function dataRecorrenteValida(d:unknown):d is string {
+  if(typeof d!=="string"||!/^\d{4}-\d{2}-\d{2}$/.test(d))return false;
+  try{return new Date(d+"T00:00:00Z").toISOString().slice(0,10)===d;}catch{return false;}
+}
+/** Datas mensais sequenciais, com o mesmo ajuste de fim de mês do fluxo 3DS.
+ * O vencimento vem do contrato, nunca da data de chegada do webhook. */
+export function cicloMensalNaData(first:string,today:string):string|null {
+  if(!dataRecorrenteValida(first)||!dataRecorrenteValida(today)||today<first)return null;
+  let due=first;
+  for(let i=0;i<1200;i++) {const next=vencimentoNoMesSeguinte(due);if(today<next)return due;due=next;}
+  return null;
+}
+export function vencimentoRecorrenteConfere(first:string,due:string) {
+  return dataRecorrenteValida(due)&&cicloMensalNaData(first,due)===due;
+}
+export type ReciboAssinaturaNominal={order_id:string;provider_subscription_id:string|null;first_due_date:string;reserved_at:string;bound_at:string|null};
+export type PedidoRecorrente={id:string;billing_period?:string;payment_method:string;provider_customer_id:string|null;
+  provider_charge_id:string|null;provider_subscription_id?:string|null;total_cents:number;provider_first_due_date:string|null};
+export function assinaturaNominalConfere(order:PedidoRecorrente,receipt:ReciboAssinaturaNominal,raw:unknown) {
+  if(!raw||typeof raw!=="object"||Array.isArray(raw))return false;
+  const sub=raw as Record<string,unknown>;
+  return dataRecorrenteValida(order.provider_first_due_date)&&order.billing_period==="monthly"&&order.payment_method==="asaas_card"&&receipt.order_id===order.id
+    &&!!receipt.provider_subscription_id&&receipt.provider_subscription_id===order.provider_subscription_id
+    &&receipt.first_due_date===vencimentoNoMesSeguinte(order.provider_first_due_date??"")&&!!receipt.bound_at
+    &&sub.id===receipt.provider_subscription_id&&sub.customer===order.provider_customer_id&&sub.externalReference===order.id
+    &&sub.billingType==="CREDIT_CARD"&&sub.cycle==="MONTHLY"&&sub.value===order.total_cents/100
+    // Cancelar uma assinatura não apaga cobranças já geradas/pagas.
+    &&["ACTIVE","INACTIVE","EXPIRED"].includes(String(sub.status));
+}
+export function renovacaoNominalConfere(order:PedidoRecorrente,receipt:ReciboAssinaturaNominal,event:EventoFinanceiro,raw:unknown) {
+  if(!raw||typeof raw!=="object"||Array.isArray(raw))return false;
+  const p=raw as Record<string,unknown>;
+  if(event.assinaturaId!==receipt.provider_subscription_id||event.assinaturaId!==order.provider_subscription_id
+    ||event.cobrancaId===order.provider_charge_id||event.clienteId!==order.provider_customer_id
+    ||event.forma!=="CREDIT_CARD"||event.valorCentavos!==order.total_cents||!vencimentoRecorrenteConfere(receipt.first_due_date,event.vencimento))return false;
+  const identity=p.id===event.cobrancaId&&p.customer===event.clienteId&&p.externalReference===order.id
+    &&p.billingType===event.forma&&p.subscription===event.assinaturaId&&p.dueDate===event.vencimento
+    &&typeof p.value==="number"&&Math.abs(p.value*100-event.valorCentavos)<0.00001;
+  if(!identity)return false;
+  return !["PAYMENT_CONFIRMED","PAYMENT_RECEIVED"].includes(event.tipo)||confirmacaoCanonicaConfere(order.id,event,p);
+}
