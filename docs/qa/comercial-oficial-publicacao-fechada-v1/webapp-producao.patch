+import "server-only";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { lerTodasPaginas } from "../multiconta/paginacao";
+import { consultarEstadoPagamento } from "./consultar-estado-pagamento";
+import { pedidoMantemDireito } from "./direito-por-pedido";
+import { ehPedidoContexto } from "./financeiro-contexto-v1";
+import { coberturaNominalAtiva } from "./cobertura-nominal-v1";
+import { consultarDireitoFinanceiroNominal } from "./direito-financeiro-nominal-v1";
+
+type PedidoCadastro = {
+  id: string; external_ref: string; business_id: string | null; status: string;
+  payment_method: string; provider_charge_id: string | null; total_cents: number;
+  provider_first_due_date: string | null; billing_period?: string;
+};
+export type TipoCadastroPorCompra = "legacy" | "nominal" | false | null;
+
+/** Permits signup only; never claims a business or grants access to an existing account.
+ * null = incomplete verification. Other independent purchases can still qualify.
+ */
+export async function tipoCadastroPorCompra(admin: SupabaseClient, email: string, documento: string): Promise<TipoCadastroPorCompra> {
+  const pedidos = await lerTodasPaginas<PedidoCadastro>((start,end) => admin.from("commercial_orders")
+    .select("id, external_ref, business_id, status, payment_method, provider_charge_id, total_cents, provider_first_due_date, billing_period")
+    .eq("buyer_email",email).eq("cnpj",documento).eq("status","payment_approved")
+    .order("id",{ascending:true}).range(start,end));
+  if (!pedidos) return null;
+  let incompleto = false;
+  for (const pedido of pedidos) {
+    const nominal = ehPedidoContexto(pedido.external_ref);
+    if (nominal && !coberturaNominalAtiva()) continue;
+    if (!nominal && !pedido.business_id) continue;
+    if (nominal) {
+      const estado = await consultarDireitoFinanceiroNominal(admin, pedido);
+      if (estado === "verification_unavailable") incompleto = true;
+      if (estado === "payment_approved") return "nominal";
+      continue;
+    }
+    if (await pedidoMantemDireito(pedido, async p => {
+      const estado = await consultarEstadoPagamento(admin,p);
+      if (estado === "verification_unavailable") incompleto = true;
+      return estado;
+    })) return "legacy";
+  }
+  return incompleto ? null : false;
+}
+
+export async function permiteCadastroPorCompra(admin: SupabaseClient, email: string, documento: string): Promise<boolean | null> {
+  const tipo = await tipoCadastroPorCompra(admin, email, documento);
+  return tipo === null ? null : tipo !== false;
+}
