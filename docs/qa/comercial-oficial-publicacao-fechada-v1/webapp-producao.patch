+        buyerQueue:chargeUnavailable.has(o.id)||!coherent?"unavailable":queueState(buyer,o.id,charge),
+        internalQueue:chargeUnavailable.has(o.id)||!coherent?"unavailable":queueState(internal,o.id,charge)} satisfies PedidoNominalOperacao;
