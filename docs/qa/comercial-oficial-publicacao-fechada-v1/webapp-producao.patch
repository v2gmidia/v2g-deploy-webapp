+"use client";
+
+import { useActionState, useEffect, useMemo, useState } from "react";
+import { useRouter } from "next/navigation";
+import { atribuirCoberturaNominalAction } from "@/app/contratar/cobertura-actions";
+import { SCHEMA_COBERTURA_NOMINAL, type AtribuicaoNominal, type SelecaoContratante } from "@/lib/contratacao/cobertura-nominal-v1";
+import type { NegocioSelecionavelNominal, PedidoParaAtribuicaoNominal, UnidadeParaAtribuicaoNominal } from "@/lib/contratacao/preparar-cobertura-nominal-v1";
+import styles from "./preparar-acesso.module.css";
+
+type ActionState = { ok?: boolean; erro?: string; unitId?: string };
+
+export function FormularioCobertura({ order, businesses, unit, previewResult }: {
+  order: PedidoParaAtribuicaoNominal;
+  businesses: NegocioSelecionavelNominal[];
+  unit: UnidadeParaAtribuicaoNominal;
+  previewResult?: "success" | "error";
+}) {
+  const router = useRouter();
+  const fixedContractor = order.contractorBusinessId;
+  const [contractorChoice, setContractorChoice] = useState(fixedContractor ? `existing:${fixedContractor}` : "");
+  const [contractorName, setContractorName] = useState("");
+  const [advertiserChoice, setAdvertiserChoice] = useState(order.contractorType === "direct" ? "contractor" : "");
+  const [advertiserName, setAdvertiserName] = useState(unit.advertiser_name);
+  const [confirmed, setConfirmed] = useState(false);
+  const previewAction = async (_previous: ActionState, _form: FormData): Promise<ActionState> =>
+    previewResult === "error" ? { erro: "Não foi possível conferir esta atribuição simulada. As escolhas foram preservadas." }
+      : { ok: true, unitId: unit.id };
+  const [state, formAction, pending] = useActionState<ActionState, FormData>(
+    previewResult ? previewAction : atribuirCoberturaNominalAction, {},
+  );
+  useEffect(() => {
+    if (state.ok && !previewResult) router.refresh();
+  }, [previewResult, router, state.ok]);
+
+  const contractor = useMemo<SelecaoContratante | null>(() => {
+    if (contractorChoice.startsWith("existing:")) return { mode: "existing", businessId: contractorChoice.slice(9) };
+    if (contractorChoice === "new" && contractorName.trim()) return { mode: "new", name: contractorName.trim() };
+    return null;
+  }, [contractorChoice, contractorName]);
+  const advertiser = useMemo<AtribuicaoNominal["advertiser"] | null>(() => {
+    if (order.contractorType === "direct") return contractor ? { mode: "contractor" } : null;
+    if (advertiserChoice.startsWith("existing:")) return { mode: "existing", businessId: advertiserChoice.slice(9) };
+    if (advertiserChoice.startsWith("unit:")) return { mode: "unit", unitId: advertiserChoice.slice(5) };
+    if (advertiserChoice === "new" && advertiserName.trim()) return { mode: "new", name: advertiserName.trim() };
+    return null;
+  }, [advertiserChoice, advertiserName, contractor, order.contractorType]);
+  const binding: AtribuicaoNominal | null = contractor && advertiser ? {
+    schemaVersion: SCHEMA_COBERTURA_NOMINAL,
+    orderId: order.id, contextId: order.contextId, unitId: unit.id, intakeUnitId: unit.intake_unit_id,
+    contractor, advertiser, adAccountId: null, confirmSelection: true,
+  } : null;
+  const locked = pending || !!state.ok;
+  const otherBound = order.units.filter(u => u.id !== unit.id && u.binding);
+  const contractorId = contractor?.mode === "existing" ? contractor.businessId : null;
+  const resultKey = state.ok ? "success" : state.erro ? "error" : "idle";
+
+  return <form action={formAction} className={styles.formulario} key={resultKey}>
+    <input type="hidden" name="binding" value={binding ? JSON.stringify(binding) : ""} />
+    <div className={styles.unidadeTitulo}><div><span>Unidade {unit.ordinal}</span><strong>{unit.advertiser_name}</strong></div>
+      <span className={styles.estado}>{unit.ad_account_id ? "Conta atribuída" : "Conta ainda não atribuída"}</span></div>
+    {!fixedContractor && <fieldset disabled={locked}><legend>Qual é o contratante desta compra?</legend>
+      <label className={styles.opcaoRadio}><input type="radio" checked={contractorChoice === "new"} onChange={() => setContractorChoice("new")} /> Criar um novo contratante</label>
+      {contractorChoice === "new" && <label>Nome do novo contratante<input value={contractorName} maxLength={200}
+        onChange={e => setContractorName(e.target.value)} placeholder={order.legalName} /></label>}
+      {businesses.length > 0 && <label>Ou escolha um negócio que já pertence a esta conta<select value={contractorChoice.startsWith("existing:") ? contractorChoice : ""}
+        onChange={e => setContractorChoice(e.target.value)}><option value="">Selecione um cadastro</option>
+        {businesses.map(b => <option key={b.id} value={`existing:${b.id}`}>{b.name} · {b.id.slice(0, 8)}</option>)}</select></label>}
+    </fieldset>}
+    {fixedContractor && <p className={styles.resumo}>Contratante já escolhido: <b>{businesses.find(b => b.id === fixedContractor)?.name ?? fixedContractor.slice(0, 8)}</b>.</p>}
+    {order.contractorType === "agency" && <fieldset disabled={locked}><legend>Qual anunciante recebe esta unidade?</legend>
+      <label className={styles.opcaoRadio}><input type="radio" checked={advertiserChoice === "new"} onChange={() => setAdvertiserChoice("new")} /> Criar um novo anunciante</label>
+      {advertiserChoice === "new" && <label>Nome do novo anunciante<input value={advertiserName} maxLength={200}
+        onChange={e => setAdvertiserName(e.target.value)} /></label>}
+      {businesses.some(b => b.id !== contractorId) && <label>Ou escolha um anunciante que já pertence a esta conta<select
+        value={advertiserChoice.startsWith("existing:") ? advertiserChoice : ""} onChange={e => setAdvertiserChoice(e.target.value)}>
+        <option value="">Selecione um cadastro</option>{businesses.filter(b => b.id !== contractorId)
+          .map(b => <option key={b.id} value={`existing:${b.id}`}>{b.name} · {b.id.slice(0, 8)}</option>)}</select></label>}
+      {otherBound.length > 0 && <label>Usar o mesmo anunciante de outra unidade<select value={advertiserChoice.startsWith("unit:") ? advertiserChoice : ""}
+        onChange={e => setAdvertiserChoice(e.target.value)}><option value="">Escolha uma unidade já atribuída</option>
+        {otherBound.map(u => <option key={u.id} value={`unit:${u.id}`}>Unidade {u.ordinal} · {u.advertiser_name}</option>)}</select></label>}
+    </fieldset>}
+    <label className={styles.confirmacao}><input type="checkbox" checked={confirmed} disabled={locked}
+      onChange={e => setConfirmed(e.target.checked)} /> Conferi o contratante e o anunciante desta unidade.</label>
+    {state.erro && <p className="form-error" role="alert">{state.erro}</p>}
+    {state.ok && <p className="form-notice" role="status">Cadastro atribuído a esta unidade. A conexão com a Meta é a próxima etapa.</p>}
+    <button type="submit" disabled={locked || !confirmed || !binding}>{pending ? "Conferindo…" : "Confirmar esta unidade"}</button>
+  </form>;
+}
diff --git a/app/(public)/preparar-acesso/page.tsx b/app/(public)/preparar-acesso/page.tsx
new file mode 100644
