@@ -0,0 +1,53 @@
+"""Ações de fixtures locais; não são respostas capturadas da Meta."""
+
+from typing import Any
+
+import pytest
+
+from src.meta.leitura_anuncios import ACAO_CONVERSAS_MENSAGEM, _conversas_mensagem
+
+
+def dia(valor: str) -> dict[str, Any]:
+    return {"actions": [{"action_type": ACAO_CONVERSAS_MENSAGEM, "value": valor}]}
+
+
+def test_total_conferido_do_duu_e_reproduzido_sem_inferir_whatsapp() -> None:
+    # 105 é o total visto no Gerenciador (01–07/11); envelope reconstruído
+    # só para testar a interpretação. Não é uma captura de ações/dias reais.
+    assert _conversas_mensagem([dia("105")]) == "105"
+
+
+def test_decimal_exato_sem_float_e_zero_somente_explicito() -> None:
+    assert _conversas_mensagem([dia("0.1"), dia("0.2")]) == "0.3"
+    assert _conversas_mensagem([dia("0"), dia("0.000000")]) == "0"
+
+
+@pytest.mark.parametrize("valor", ["-1", "NaN", "Infinity", "1e2", "1.0000001", "1000000000000000", 1, None])
+def test_valor_invalido_permanece_desconhecido(valor: Any) -> None:
+    assert _conversas_mensagem([dia(valor)]) is None
+
+
+@pytest.mark.parametrize("linha", [{}, {"actions": None}, {"actions": []}, {"actions": [None]},
+                                    {"actions": [{"action_type": "lead", "value": "100"}]}])
+def test_ausencia_em_dia_observado_nao_vira_zero(linha: dict[str, Any]) -> None:
+    assert _conversas_mensagem([dia("5"), linha]) is None
+
+
+def test_aliases_janelas_e_destinos_nao_sao_somados() -> None:
+    linha = dia("105")
+    linha["actions"].extend([
+        {"action_type": "onsite_conversion.total_messaging_connection", "value": "999"},
+        {"action_type": "link_click", "value": "466"},
+        {"action_type": "onsite_conversion.messaging_conversation_started_7d.whatsapp", "value": "888"},
+    ])
+    linha["actions"][0]["7d_click"] = "105"
+    linha["actions"][0]["1d_view"] = "10"
+    assert _conversas_mensagem([linha]) == "105"
+
+
+def test_acao_repetida_nao_duplica_total_e_overflow_recusa() -> None:
+    linha = dia("105")
+    linha["actions"].append(dict(linha["actions"][0]))
+    assert _conversas_mensagem([linha]) is None
+    assert _conversas_mensagem([dia("999999999999999"), dia("1")]) is None
+    assert _conversas_mensagem([]) is None
