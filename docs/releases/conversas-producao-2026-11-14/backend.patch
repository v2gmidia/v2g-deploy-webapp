+ACAO_CONVERSAS_MENSAGEM: Literal["onsite_conversion.messaging_conversation_started_7d"] = "onsite_conversion.messaging_conversation_started_7d"
+
+
+def _conversas_mensagem(linhas: list[dict[str, Any]]) -> str | None:
+    """Uma ação exata, sem somar aliases, canais ou janelas sobrepostas.
+
+    Ausência em qualquer dia observado não é zero. A contagem é atribuída
+    pela Meta, não comprova WhatsApp, pessoas únicas ou mensagens recebidas.
+    """
+    if not linhas:
+        return None
+    total = Decimal(0)
+    for linha in linhas:
+        acoes = linha.get("actions")
+        if not isinstance(acoes, list) or any(not isinstance(a, dict) for a in acoes):
+            return None
+        valores = [a.get("value") for a in acoes if a.get("action_type") == ACAO_CONVERSAS_MENSAGEM]
+        if len(valores) != 1 or not isinstance(valores[0], str) or not re.fullmatch(r"[0-9]{1,15}(?:\.[0-9]{1,6})?", valores[0]):
+            return None
+        total += Decimal(valores[0])
+        if total > Decimal("999999999999999"):
+            return None
+    valor = format(total, "f")
+    return valor.rstrip("0").rstrip(".") if "." in valor else valor
 
 
