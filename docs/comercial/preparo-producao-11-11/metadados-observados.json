      "present": true,
      "constraints": [
        {
          "name": "commercial_orders_approval_matches",
          "definition": "CHECK ((((status = 'payment_approved'::text) AND (payment_approved_at IS NOT NULL)) OR ((status <> 'payment_approved'::text) AND (payment_approved_at IS NULL))))"
        },
        {
          "name": "commercial_orders_billing_period_check",
          "definition": "CHECK ((billing_period = ANY (ARRAY['monthly'::text, 'annual_upfront'::text])))"
        },
        {
          "name": "commercial_orders_business_id_fkey",
          "definition": "FOREIGN KEY (business_id) REFERENCES businesses(id) ON DELETE SET NULL"
