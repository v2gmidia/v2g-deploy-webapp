        {
          "name": "commercial_orders_buyer_profile_id_fkey",
          "definition": "FOREIGN KEY (buyer_profile_id) REFERENCES profiles(id) ON DELETE SET NULL"
        },
        {
          "name": "commercial_orders_check",
          "definition": "CHECK ((((billing_period = 'monthly'::text) AND (discount_percent = 0)) OR ((billing_period = 'annual_upfront'::text) AND (discount_percent = 12))))"
        },
        {
          "name": "commercial_orders_cnpj_check",
          "definition": "CHECK ((cnpj ~ '^[0-9]{14}$'::text))"
        },
        {
          "name": "commercial_orders_declares_cnpj_check",
          "definition": "CHECK (declares_cnpj)"
        },
        {
          "name": "commercial_orders_direct_pix_approval_actor_check",
          "definition": "CHECK (((payment_method <> 'direct_pix'::text) OR (status <> 'payment_approved'::text) OR (payment_approved_by IS NOT NULL)))"
        },
        {
          "name": "commercial_orders_direct_pix_proof_check",
          "definition": "CHECK (((payment_method <> 'direct_pix'::text) OR (status = ANY (ARRAY['awaiting_payment'::text, 'cancelled'::text])) OR ((proof_reference IS NOT NULL) AND (length(btrim(proof_reference)) > 0) AND (proof_received_at IS NOT NULL) AND (proof_received_by IS NOT NULL))))"
        },
        {
          "name": "commercial_orders_external_ref_key",
          "definition": "UNIQUE (external_ref)"
        },
        {
          "name": "commercial_orders_origin_check",
          "definition": "CHECK ((origin = ANY (ARRAY['assisted'::text, 'self_service'::text])))"
        },
        {
          "name": "commercial_orders_paid_business_check",
          "definition": "CHECK (((status <> 'payment_approved'::text) OR (business_id IS NOT NULL)))"
        },
        {
          "name": "commercial_orders_payment_approved_by_fkey",
          "definition": "FOREIGN KEY (payment_approved_by) REFERENCES profiles(id) ON DELETE SET NULL"
        },
        {
          "name": "commercial_orders_payment_method_check",
          "definition": "CHECK ((payment_method = ANY (ARRAY['direct_pix'::text, 'asaas_pix'::text, 'asaas_card'::text])))"
        },
        {
          "name": "commercial_orders_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "name": "commercial_orders_proof_received_by_fkey",
          "definition": "FOREIGN KEY (proof_received_by) REFERENCES profiles(id) ON DELETE SET NULL"
        },
        {
          "name": "commercial_orders_provider_charge_id_key",
          "definition": "UNIQUE (provider_charge_id)"
        },
        {
          "name": "commercial_orders_sells_by_whatsapp_check",
          "definition": "CHECK (sells_by_whatsapp)"
        },
        {
          "name": "commercial_orders_status_check",
          "definition": "CHECK ((status = ANY (ARRAY['awaiting_payment'::text, 'proof_received'::text, 'payment_approved'::text, 'cancelled'::text])))"
        },
        {
          "name": "commercial_orders_total_cents_check",
          "definition": "CHECK ((total_cents > 0))"
        },
        {
          "name": "commercial_orders_total_matches",
          "definition": "CHECK ((total_cents = (unit_count *\nCASE billing_period\n    WHEN 'monthly'::text THEN 50000\n    ELSE 528000\nEND)))"
        },
        {
          "name": "commercial_orders_unit_count_check",
          "definition": "CHECK ((unit_count > 0))"
        },
        {
          "name": "commercial_orders_unit_price_cents_check",
          "definition": "CHECK ((unit_price_cents = 50000))"
        }
      ]
