# dependencies
node_modules/

# next.js
.next/
out/
next-env.d.ts

# typescript
*.tsbuildinfo

# env — nunca versionar valores reais
# `.env.*` fecha tudo (.env.production, .env.staging, qualquer sufixo) e o
# `!` reabre só o template. A lista anterior cobria .env, .env.local e
# .env*.local — `.env.production` passava. Auditado em 21/08/2026: nenhum
# .env com valor real foi rastreado em nenhum commit deste repo.
.env
.env.*
!.env.example

# supabase local (containers, etc.)
.branches
.temp

# os
.DS_Store
Thumbs.db

# logs
*.log

# Impeccable (skill de design, ver docs/impeccable.md)
# O manifesto de hook é efeito colateral LOCAL de máquina: quem não quiser o
# hook não deve ser obrigado a ele por um commit.
.claude/settings.local.json
# Cache de dedupe do hook — estado de sessão, não configuração.
.impeccable/hook.cache.json

# Wireframes do handoff de 10/09/2026 (docs/v2g-wireframes/).
# São 44 PNGs, 61 MB, gerados por IA e usados como REFERÊNCIA VISUAL —
# nenhum deles é fonte de verdade sobre dado, medida ou funcionalidade
# (docs/v2g-wireframes/IMPLEMENTATION-PLAN.md §2). 61 MB entram no
# histórico do git para sempre e saem de lá nunca; a informação que
# sobrevive a eles são os .md, que continuam versionados.
# Os arquivos continuam no disco — decisão do Victor, 11/09/2026.
docs/v2g-wireframes/*.png

# Saída dos acompanhamentos de execução (scripts/acompanhar-execucao.ts).
# Carrega o texto que os agentes escreveram sobre um negócio real — dado de
# cliente, não artefato de código. O relatório que interessa vive em
# docs/estado/; o JSON é material de trabalho.
acompanhamento-*.json
