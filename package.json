{
  "name": "v2g-webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "conferir:cadastro": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/conferir-cadastro.ts",
    "conferir:lista-branca": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/conferir-lista-branca.ts",
    "conferir:estado": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/conferir-estado.ts",
    "conferir:verba": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/conferir-verba.ts",
    "conferir:criativos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/conferir-criativos.ts",
    "conferir:cascata": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/conferir-cascata.ts",
    "conferir:migrations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/conferir-migrations.ts",
    "conferir:nichos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/conferir-nichos.ts",
    "conferir:dia-seguinte": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/conferir-dia-seguinte.ts",
    "conferir:apresentada": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/resolvedor-de-imports.mjs --conditions=react-server scripts/conferir-apresentada.ts",
    "conferir:rota-apresentada": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/resolvedor-de-imports.mjs --conditions=react-server --env-file-if-exists=.env.local scripts/conferir-rota-apresentada.ts",
    "diagnostico:card": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/diagnostico-card-da-pergunta.ts",
    "conferir:admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/conferir-admin.ts",
    "conferir": "pnpm typecheck && pnpm conferir:lista-branca && pnpm conferir:estado && pnpm conferir:verba && pnpm conferir:cadastro && pnpm conferir:criativos && pnpm conferir:cascata && pnpm conferir:migrations && pnpm conferir:nichos && pnpm conferir:dia-seguinte && pnpm conferir:apresentada",
    "medir:peca": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/medir-peca.mjs",
    "db:migrate": "supabase db push",
    "db:studio": "supabase start"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
